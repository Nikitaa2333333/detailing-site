---
/* Эксперимент «главная с душой» (03.11.2026). Служебная страница: не в меню, noindex.
   Рабочая главная (pages/index.astro) не тронута — сравнить и перенести удачное.
   Итерации и отвергнутое — docs/journal.md за 03.11.2026. Сейчас:
   — первый экран — ролик во весь экран, заголовок «Премиальный детейлинг в Москве» крупным
     шрифтом заголовков, пилюли-факты (часы, адрес), две скруглённые кнопки без капса;
   — шрифт заголовков — на выбор переключателем (Oswald, Roboto Flex узкий, Unbounded,
     Inter Tight, Geologica, Dela Gothic One), капс — только в заголовках;
   — палитра: чёрный, синие и сиреневые свечения одним слоем за всей страницей;
   — направления — карточки вширь парами, фото до краёв;
   — калькулятор: машина → вкладки-папки направлений → услуги галочками → итог → заявка;
   — дальше блоки рабочей главной: сезонные пакеты, гарантии с иконками, контакты, вопросы.
   Цены — только из прайса (lib/sections.js, catalog.js), руками не вписаны. */
import '@fontsource-variable/oswald';
import '@fontsource-variable/roboto-flex/full.css';
import '@fontsource-variable/unbounded';
import '@fontsource-variable/inter-tight';
import '@fontsource-variable/geologica';
import '@fontsource/dela-gothic-one';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Section from '../../components/Section.astro';
import SeasonPacks from '../../components/SeasonPacks.astro';
import Contacts from '../../components/Contacts.astro';
import Faq from '../../components/Faq.astro';
import CarCombo from '../../components/CarCombo.astro';
import LeadForm from '../../components/LeadForm.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import content from '../../data/content.json';
import seasonPacks from '../../data/season-packs.json';
import { categories, rub } from '../../lib/catalog.js';
import { siteCategories } from '../../lib/sections.js';
import { directionSlug, sectionSlug, pageDirections, pageServices } from '../../lib/pages.js';
import { asset, url } from '../../lib/paths.js';
import { typo } from '../../lib/typo.js';

const { brand, hero, contacts, guarantees, faq } = content;
const calc = url('/calc/');
const pageOf = (slug, fallback) => (slug ? url(`/${slug}/`) : fallback);

/* Факты на первом экране — только проверяемые, из content.json */
const chips = [contacts.hours.replace(/^./, (ch) => ch.toUpperCase()), contacts.address.replace(/^Москва,\s*/, '')];

/* ---- Направления ---- */
const leadOf = (catId) => {
  const d = pageDirections.find((x) => x.cat.id === catId);
  if (!d) return '';
  if (d.lead) return d.lead;
  const page = d.page && pageServices.find((x) => (x.slug ?? x.page) === d.page);
  return page?.lead ?? '';
};
/* Цена услуги по классу: столбец прайса, где номер класса — число в начале подписи */
const priceCells = (svc, labels) => {
  const cells = [null, null, null, null, null];
  for (const l of labels) {
    const n = parseInt(l, 10);
    const c = svc.prices[l];
    if (n >= 1 && n <= 5 && c) cells[n - 1] = c.value ?? c.min ?? null;
  }
  return cells;
};
const firstPrice = (cells) => cells.find((v) => v != null) ?? null;
const rowsOf = (c) => {
  if (c.items.length > 1)
    return c.items.map((s) => ({ title: s.title, from: s.from, href: pageOf(sectionSlug(s.id), `${calc}?cat=${c.id}&sheet=${s.id}`) }));
  const sec = siteCategories.find((x) => x.id === c.id)?.sections[0];
  if (!sec) return [];
  const href = pageOf(sectionSlug(sec.id) ?? directionSlug(c.id), `${calc}?cat=${c.id}&sheet=${sec.id}`);
  return sec.services.slice(0, 4).map((x) => ({ title: x.service.name, from: firstPrice(priceCells(x.service, x.sheet.classLabels)), href }));
};
/* Пары по длине списка: высота в ряду общая и почти не расходится — дыр нет */
const ORDER = ['uhod', 'plenki', 'pokrytiya', 'himchistka', 'polirovka', 'pdr'];
const rank = (id) => (ORDER.indexOf(id) + 99) % 99;
const cats = [...categories].sort((a, b) => rank(a.id) - rank(b.id));

/* ---- Данные калькулятора: направления → разделы → услуги с ценами по 5 классам ---- */
const calcData = cats.map((c) => {
  const sc = siteCategories.find((x) => x.id === c.id);
  return {
    id: c.id,
    title: c.title,
    sections: (sc?.sections ?? []).map((s) => ({
      title: s.title,
      services: s.services.map((x) => ({ k: x.key, n: x.service.name, d: x.service.duration || '', p: priceCells(x.service, x.sheet.classLabels) })),
    })),
  };
});

/* ---- Гарантии: иконки — линейные, 24×24, рисуем сами (позже — сгенерированные) ---- */
const icons = [
  '<path d="M7 4h7a4 4 0 0 1 0 8H7m0-8v16m0-5h8"/>',
  '<path d="M12 3 5 6v5c0 4.5 3 8.3 7 10 4-1.7 7-5.5 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-4"/>',
  '<circle cx="12" cy="12" r="3"/><path d="M2.5 12S6 5 12 5s9.5 7 9.5 7-3.5 7-9.5 7-9.5-7-9.5-7Z"/>',
  '<path d="M4 8h3l2-3h6l2 3h3v11H4V8Z"/><circle cx="12" cy="13" r="3.5"/>',
];

const fonts = [
  { id: 'oswald', name: 'Oswald' },
  { id: 'flex', name: 'Roboto Flex' },
  { id: 'unbounded', name: 'Unbounded' },
  { id: 'inter', name: 'Inter Tight' },
  { id: 'geologica', name: 'Geologica' },
  { id: 'dela', name: 'Dela Gothic' },
];
---

<Layout title={`Главная — эксперимент | ${brand.name}`} noindex>
  <Header overlay />

  <!-- Свечения — один слой за всей страницей (fixed), без стыков между блоками -->
  <div class="x-bg" aria-hidden="true"><i></i><i></i><i></i><i></i></div>

  <main class="x">
    <!-- ============ Первый экран: ролик во весь экран ============ -->
    <section class="xh" data-bg="#010205">
      <img class="xh-media" src={asset(hero.poster)} alt="" fetchpriority="high" decoding="async" />
      <video class="xh-media xh-video" muted loop playsinline preload="auto" poster={asset(hero.poster)} aria-hidden="true"
        data-src={asset(hero.video)} data-src-small={asset(hero.videoSmall)}></video>
      <div class="xh-scrim" aria-hidden="true"></div>

      <div class="container xh-in">
        <div class="xh-copy">
          <h1 class="x-display xh-title">Премиальный детейлинг в&nbsp;Москве</h1>
          <div class="xh-actions">
            <a class="xbtn xbtn--light" href="#calc">Рассчитать стоимость</a>
            <a class="xbtn xbtn--glass" href="#napravleniya">Выбрать услугу</a>
          </div>
        </div>
        <div class="xh-side">
          <ul class="xh-chips">
            {chips.map((c) => <li>{typo(c)}</li>)}
          </ul>
          <p class="xh-note">{typo('Стоимость — по классу автомобиля, точная цифра — после осмотра при вас.')}</p>
        </div>
      </div>
    </section>

    <!-- ============ Направления ============ -->
    <section class="xs" id="napravleniya">
      <div class="container">
        <h2 class="x-display xs-title">Шесть направлений. Одна планка качества.</h2>
        <div class="xd">
          {cats.map((c) => (
            <article class="xd-card">
              {c.media && (
                <div class="xd-media" aria-hidden="true">
                  <img src={asset(c.media)} alt="" loading="lazy" decoding="async" />
                </div>
              )}
              <div class="xd-body">
                <h3 class="x-display xd-title"><a href={pageOf(directionSlug(c.id), `${calc}?cat=${c.id}`)}>{c.title}</a></h3>
                {leadOf(c.id) && <p class="xd-lead">{typo(leadOf(c.id))}</p>}
                <ul class="xd-list">
                  {rowsOf(c).map((r) => (
                    <li>
                      <a href={r.href}>
                        <span>{typo(r.title)}</span>
                        {r.from != null && <span class="xd-price">от {rub(r.from)}</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ Калькулятор: машина → папки направлений → услуги → заявка ============ -->
    <section class="xs" id="calc">
      <div class="container">
        <h2 class="x-display xs-title">Цена для вашей машины</h2>
        <p class="xs-lead">{typo('Выберите машину и отметьте услуги — цены пересчитаются под её класс. Сумму зафиксируем после осмотра.')}</p>

        <div class="xc" data-xcalc>
          <div class="xc-tabs" role="tablist" aria-label="Направления">
            {calcData.map((c, i) => (
              <button class="xc-tab" type="button" role="tab" data-tab={c.id} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
                <span>{c.title}</span>
                <b class="xc-count" data-count={c.id}>{c.sections.reduce((n, s) => n + s.services.length, 0)}</b>
              </button>
            ))}
          </div>

          <div class="xc-panel" data-first="1">
            <div class="xc-car">
              <p class="xc-car-label">Ваша машина</p>
              <div class="xc-car-field" data-xcar>
                <CarCombo id="xcalc-car" placeholder="Марка или модель" label="Марка и модель" />
              </div>
              <p class="xc-car-note" data-xcar-note>{typo('Пока без машины — цены для 1-го класса.')}</p>
            </div>
            <div class="xc-list" data-xlist></div>
          </div>

          <div class="xc-sum" data-xsum hidden>
            <p class="xc-sum-text"><span data-xsum-count></span><b data-xsum-total></b></p>
            <button class="xbtn xbtn--light" type="button" data-xsum-go>Оставить заявку</button>
          </div>
        </div>

        <div class="xc-lead">
          <LeadForm title="Записаться" service="Расчёт с главной" button="Отправить заявку" />
        </div>
      </div>
      <script type="application/json" id="xcalc-data" set:html={JSON.stringify(calcData)} />
    </section>

    <!-- ============ Блоки рабочей главной ============ -->
    <Section id="season" dark label={seasonPacks.season.label} title={seasonPacks.season.title}>
      <SeasonPacks href="#calc" />
    </Section>

    <section class="xs" id="garantii">
      <div class="container">
        <h2 class="x-display xs-title">{guarantees.title}</h2>
        <ul class="xg">
          {guarantees.items.map((g, i) => (
            <li class="xg-item">
              <span class="xg-icon" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={icons[i % icons.length]} /></span>
              <h3 class="xg-title">{typo(g.title)}</h3>
              <p class="xg-text">{typo(g.text)}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <Section id="contacts" dark>
      <Contacts />
    </Section>

    <Section id="faq" dark>
      <Faq title={faq.title} items={faq.items} />
    </Section>
  </main>

  <SiteFooter brand={brand} contacts={false} />

  <!-- Переключатель шрифта заголовков — только для выбора, на сайт не поедет -->
  <div class="xfont" role="group" aria-label="Шрифт заголовков">
    <span class="xfont-label">Шрифт</span>
    {fonts.map((f) => <button type="button" data-font={f.id}>{f.name}</button>)}
  </div>
</Layout>

<script is:inline>
  /* шрифт — до отрисовки, без мигания: ?font=… или прошлый выбор */
  (function () {
    var f = new URLSearchParams(location.search).get('font');
    try { f = f || localStorage.getItem('x-font'); } catch (e) {}
    document.documentElement.dataset.xfont = f || 'oswald';
  })();
  (function () {
    var v = document.querySelector('.xh-video');
    if (v && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      v.src = matchMedia('(max-width: 860px)').matches ? v.dataset.srcSmall : v.dataset.src;
      v.muted = true;
      var p = v.play();
      if (p && p.catch) p.catch(function () {});
    }
  })();
</script>

<script>
  import { loadCars } from '../../lib/car-index-client.js';
  import { carCombo, classText, PREMIUM } from '../../lib/car-combo.js';
  import { typo } from '../../lib/typo.js';

  /* ---- Переключатель шрифта ---- */
  const root = document.documentElement;
  const fontBtns = [...document.querySelectorAll<HTMLButtonElement>('.xfont [data-font]')];
  const markFont = () => fontBtns.forEach((b) => b.classList.toggle('is-on', b.dataset.font === root.dataset.xfont));
  fontBtns.forEach((b) => b.addEventListener('click', () => {
    root.dataset.xfont = b.dataset.font!;
    try { localStorage.setItem('x-font', b.dataset.font!); } catch {}
    markFont();
  }));
  markFont();

  /* ---- Калькулятор ---- */
  type Svc = { k: string; n: string; d: string; p: (number | null)[] };
  type Cat = { id: string; title: string; sections: { title: string; services: Svc[] }[] };
  type Car = { brand?: string; model?: string; cls: string };

  const box = document.querySelector<HTMLElement>('[data-xcalc]');
  const data: Cat[] = JSON.parse(document.getElementById('xcalc-data')?.textContent || '[]');
  if (box && data.length) {
    const NB = String.fromCharCode(160);
    const rub = (v: number) => `${String(v).replace(/\B(?=(\d{3})+(?!\d))/g, NB)}${NB}₽`;
    const tabs = [...box.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panel = box.querySelector<HTMLElement>('.xc-panel')!;
    const list = box.querySelector<HTMLElement>('[data-xlist]')!;
    const note = box.querySelector<HTMLElement>('[data-xcar-note]')!;
    const sum = box.querySelector<HTMLElement>('[data-xsum]')!;
    const byKey = new Map<string, Svc>();
    data.forEach((c) => c.sections.forEach((s) => s.services.forEach((x) => byKey.set(x.k, x))));

    let car: Car | null = null;
    let active = data[0].id;
    const secOf = new Map<string, number>();   /* открытый раздел в каждом направлении */
    const sel = new Set<string>();

    const cls = () => (car && car.cls !== PREMIUM ? Number(car.cls) : 0);
    /* цена услуги для класса; без машины — 1-й заполненный столбец со словом «от» */
    const price = (x: Svc): { v: number | null; from: boolean } => {
      if (car?.cls === PREMIUM) return { v: null, from: false };
      const c = cls();
      if (c) return { v: x.p[c - 1] ?? null, from: false };
      const v = x.p.find((p) => p != null) ?? null;
      return { v, from: true };
    };

    const render = () => {
      const cat = data.find((c) => c.id === active)!;
      /* разделы — чипами, на экране один раздел: все подряд тянулись на несколько экранов */
      const si = Math.min(secOf.get(cat.id) ?? 0, cat.sections.length - 1);
      const picked = (sec: { services: Svc[] }) => sec.services.filter((x) => sel.has(x.k)).length;
      const chipsHtml = cat.sections.length > 1
        ? `<div class="xc-chips" role="tablist">${cat.sections.map((sec, i) => `<button type="button" class="xc-chip${i === si ? ' is-on' : ''}" data-sec="${i}">${typo(sec.title)}${picked(sec) ? ` <b>${picked(sec)}</b>` : ''}</button>`).join('')}</div>`
        : '';
      list.innerHTML = chipsHtml + [cat.sections[si]].map((s) => `
        <div class="xc-sec">
          <ul>${s.services.map((x) => {
            const pr = price(x);
            const txt = car?.cls === PREMIUM ? 'после осмотра' : pr.v == null ? 'по запросу' : `${pr.from ? 'от ' : ''}${rub(pr.v)}`;
            return `<li><label class="xc-row${sel.has(x.k) ? ' is-on' : ''}">
              <input type="checkbox" value="${x.k}"${sel.has(x.k) ? ' checked' : ''} />
              <span class="xc-box" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="m5 10.5 3.2 3L15 7"/></svg></span>
              <span class="xc-name">${typo(x.n)}${x.d ? `<small>${x.d}</small>` : ''}</span>
              <span class="xc-price">${txt}</span>
            </label></li>`;
          }).join('')}</ul>
        </div>`).join('');
    };

    const updateSum = () => {
      tabs.forEach((t) => {
        const c = data.find((x) => x.id === t.dataset.tab)!;
        const n = c.sections.reduce((m, s) => m + s.services.filter((x) => sel.has(x.k)).length, 0);
        const b = t.querySelector<HTMLElement>('[data-count]')!;
        b.textContent = n ? String(n) : String(c.sections.reduce((m, s) => m + s.services.length, 0));
        b.classList.toggle('is-picked', n > 0);
      });
      sum.hidden = sel.size === 0;
      if (!sel.size) return;
      let total = 0;
      let unknown = false;
      sel.forEach((k) => { const v = price(byKey.get(k)!).v; if (v == null) unknown = true; else total += v; });
      const n = sel.size;
      const word = n % 10 === 1 && n % 100 !== 11 ? 'услуга' : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 10 || n % 100 >= 20) ? 'услуги' : 'услуг';
      sum.querySelector('[data-xsum-count]')!.textContent = `${n} ${word}`;
      sum.querySelector('[data-xsum-total]')!.textContent =
        car?.cls === PREMIUM ? 'цена после осмотра' : `${!cls() || unknown ? 'от ' : ''}${rub(total)}`;
    };

    list.addEventListener('click', (e) => {
      const chip = (e.target as HTMLElement).closest<HTMLElement>('[data-sec]');
      if (!chip) return;
      secOf.set(active, Number(chip.dataset.sec));
      render();
    });

    list.addEventListener('change', (e) => {
      const input = e.target as HTMLInputElement;
      if (input.type !== 'checkbox') return;
      input.checked ? sel.add(input.value) : sel.delete(input.value);
      input.closest('.xc-row')?.classList.toggle('is-on', input.checked);
      const cat = data.find((c) => c.id === active)!;
      list.querySelectorAll<HTMLElement>('[data-sec]').forEach((b) => {
        const n = cat.sections[Number(b.dataset.sec)].services.filter((x) => sel.has(x.k)).length;
        b.querySelector('b')?.remove();
        if (n) b.insertAdjacentHTML('beforeend', ` <b>${n}</b>`);
      });
      updateSum();
    });

    const select = (t: HTMLButtonElement, focus = false) => {
      active = t.dataset.tab!;
      tabs.forEach((x) => { const on = x === t; x.setAttribute('aria-selected', String(on)); x.tabIndex = on ? 0 : -1; });
      panel.dataset.first = t === tabs[0] ? '1' : '0';
      if (focus) t.focus();
      t.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
      render();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        e.preventDefault();
        select(tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length], true);
      });
    });

    /* Машина — то же поле, что на сайте (CarCombo): класс из справочника */
    const comboBox = box.querySelector<HTMLElement>('[data-car-combo]');
    let cars: unknown = null;
    if (comboBox) {
      const combo = carCombo(comboBox, {
        cars: () => cars,
        car: () => car,
        onPick: (c: Car) => {
          car = c;
          combo.sync();
          note.textContent = c.cls === PREMIUM ? 'Премиум-класс — цену назовём после осмотра.' : `Цены для ${c.cls}-го класса.`;
          render();
          updateSum();
        },
        missText: (q: string) => `«${q}» нет в списке — покажем цены «от», класс уточнит менеджер`,
        onMiss: () => { car = null; note.textContent = 'Машины нет в списке — цены «от», класс уточнит менеджер.'; render(); updateSum(); },
      });
      loadCars().then((index: unknown) => { cars = index; combo.ready(); }).catch(() => {});
    }

    /* Заявка: состав расчёта уходит в форму строкой услуги (событие lead:service) */
    sum.querySelector('[data-xsum-go]')!.addEventListener('click', () => {
      const carText = car?.model ? `${car.brand} ${car.model}, ${classText(car.cls)}` : car ? classText(car.cls) : 'машина не выбрана';
      const names = [...sel].map((k) => byKey.get(k)!.n).join(', ');
      const total = sum.querySelector('[data-xsum-total]')!.textContent;
      document.dispatchEvent(new CustomEvent('lead:service', { detail: `${carText}: ${names} — ${total}` }));
    });

    render();
    updateSum();
  }
</script>

<style>
  /* ---- Локальные токены эксперимента. Перенос на сайт — в :root global.css ---- */
  :global(html) {
    --x-font-display: 'Oswald Variable', 'Arial Narrow', sans-serif;
    --x-display-weight: 500;
    --x-display-case: uppercase;
    --x-display-track: -0.01em;
    --x-display-lh: 0.95;
    --x-display-scale: 1;
    --x-display-vars: normal;
  }
  /* Варианты шрифта заголовков: размер подравнен по ширине, чтобы строки не прыгали */
  :global(html[data-xfont='flex']) { --x-font-display: 'Roboto Flex Variable', sans-serif; --x-display-weight: 800; --x-display-vars: 'wdth' 25, 'opsz' 144; --x-display-scale: 1.04; --x-display-track: 0; }
  :global(html[data-xfont='unbounded']) { --x-font-display: 'Unbounded Variable', sans-serif; --x-display-weight: 600; --x-display-scale: 0.6; --x-display-track: -0.02em; --x-display-lh: 1.05; }
