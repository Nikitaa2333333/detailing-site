---
/* Эксперимент «главная с душой» (03.11.2026). Служебная страница: не в меню, noindex.
   Рабочая главная (pages/index.astro) не тронута — сравнить и перенести удачное.
   Что взято из референсов пользователя:
   — крупная узкая капс-типографика (Oswald) и двухтоновые позиционирующие заголовки;
   — гигантское бледное слово за кадром, кадр перекрывает его низ (приём «CARZONE»);
   — палитра: глубокий чёрный, синие свечения, тонкие линии, стекло (финансовое приложение);
   — вкладки-папки с числом внутри (отчёт об обслуживании);
   — капс-кнопка со стрелкой в белой капсуле и всплывающая «Записаться» (Rentra);
   — лента карточек без точек и круглых стрелок (Rentra, второй экран).
   Цены — из прайса (catalog.js), руками не вписаны. */
import '@fontsource-variable/oswald';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import content from '../../data/content.json';
import { categories, rub } from '../../lib/catalog.js';
import { directionSlug, sectionSlug } from '../../lib/pages.js';
import { asset, url } from '../../lib/paths.js';
import { typo } from '../../lib/typo.js';

const { brand, hero } = content;
const calc = url('/calc/');
const pageOf = (slug, fallback) => (slug ? url(`/${slug}/`) : fallback);

/* Лента: первый раздел каждого направления — «с чего начинают» (по два — фото повторялись) */
const cards = categories.flatMap((c) =>
  c.items.slice(0, 1).map((s) => ({
    id: s.id,
    title: s.title,
    from: s.from,
    cat: c.title,
    media: c.media,
    href: pageOf(sectionSlug(s.id), `${calc}?cat=${c.id}&sheet=${s.id}`),
  })),
);

const chips = ['С 2014 года', '3 поста в Москве', 'Климат-камера для плёнки и керамики'];
---

<Layout title={`Главная — эксперимент | ${brand.name}`} noindex>
  <Header overlay />

  <main class="x">
    <!-- ============ Первый экран ============ -->
    <section class="xh" data-bg="#010205">
      <div class="x-glow" aria-hidden="true"><i></i><i></i><i></i></div>
      <svg class="x-lines" viewBox="0 0 1440 900" preserveAspectRatio="none" aria-hidden="true">
        <path d="M-40 640 C 360 420, 820 760, 1480 380" />
        <path d="M-40 700 C 420 500, 860 820, 1480 450" />
        <path d="M-40 260 C 300 340, 900 120, 1480 220" />
      </svg>

      <div class="container xh-in">
        <p class="xh-ghost" aria-hidden="true">Детейлинг</p>

        <div class="xh-card">
          <img class="xh-media" src={asset(hero.poster)} alt="" fetchpriority="high" decoding="async" />
          <video class="xh-media xh-video" muted loop playsinline preload="auto" poster={asset(hero.poster)} aria-hidden="true"
            data-src={asset(hero.video)} data-src-small={asset(hero.videoSmall)}></video>
          <div class="xh-scrim" aria-hidden="true"></div>

          <ul class="xh-chips">
            {chips.map((c) => <li class="x-glass">{typo(c)}</li>)}
          </ul>

          <div class="xh-copy">
            <h1 class="xh-h1">Премиальный детейлинг в&nbsp;Москве</h1>
            <p class="x-display xh-display">
              <span>Для тех, кто</span>
              <span class="x-dim">замечает детали</span>
            </p>
            <div class="xh-actions">
              <a class="xbtn xbtn--light" href={calc}>
                <span>Рассчитать стоимость</span>
                <span class="xbtn-cap" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M4 10h12m-5-5 5 5-5 5" /></svg></span>
              </a>
              <a class="xbtn xbtn--glass" href="#napravleniya"><span>Выбрать услугу</span></a>
            </div>
          </div>

          <p class="xh-note">{typo('Стоимость — по классу автомобиля, точная цифра — после осмотра при вас.')}</p>
        </div>
      </div>
    </section>

    <!-- ============ Направления: вкладки-папки ============ -->
    <section class="xs" id="napravleniya">
      <div class="x-glow x-glow--side" aria-hidden="true"><i></i><i></i></div>
      <div class="container">
        <h2 class="x-display xs-title">
          <span>Шесть направлений.</span>
          <span class="x-dim">Одна планка качества.</span>
        </h2>

        <div class="xf" data-folders>
          <div class="xf-tabs" role="tablist" aria-label="Направления">
            {categories.map((c, i) => (
              <button class="xf-tab" type="button" role="tab" id={`xf-tab-${c.id}`} aria-controls={`xf-panel-${c.id}`}
                aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
                <span>{c.title}</span>
                <b class="xf-count">{c.items.length}</b>
              </button>
            ))}
          </div>

          {categories.map((c, i) => (
            <div class="xf-panel" role="tabpanel" id={`xf-panel-${c.id}`} aria-labelledby={`xf-tab-${c.id}`} hidden={i !== 0}>
              <div class="xf-body">
                <p class="xf-kicker">Направление {String(i + 1).padStart(2, '0')} / {String(categories.length).padStart(2, '0')}</p>
                <h3 class="xf-title">{c.title}</h3>
                <ul class="xf-list">
                  {c.items.map((s) => (
                    <li>
                      <a href={pageOf(sectionSlug(s.id), `${calc}?cat=${c.id}&sheet=${s.id}`)}>
                        <span>{s.title}</span>
                        <span class="xf-price">от {rub(s.from)}</span>
                      </a>
                    </li>
                  ))}
                </ul>
                <div class="xf-foot">
                  <p class="xf-from"><small>от</small> {rub(c.from)}</p>
                  <a class="xbtn xbtn--dark" href={pageOf(directionSlug(c.id), `${calc}?cat=${c.id}`)}>
                    <span>Услуги и цены</span>
                    <span class="xbtn-cap" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M4 10h12m-5-5 5 5-5 5" /></svg></span>
                  </a>
                </div>
              </div>
              {c.media && (
                <div class="xf-media">
                  <img src={asset(c.media)} alt="" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
                  <span class="xf-tag x-glass">Цена для 1-го класса</span>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ Лента карточек ============ -->
    <section class="xs xs--rail">
      <div class="container">
        <h2 class="x-display xs-title">
          <span>С чего начинают</span>
          <span class="x-dim">наши клиенты</span>
        </h2>
      </div>
      <div class="xr" tabindex="0" aria-label="Популярные услуги">
        {cards.map((k) => (
          <a class="xr-card" href={k.href}>
            <div class="xr-photo">
              {k.media && <img src={asset(k.media)} alt="" loading="lazy" decoding="async" />}
              <span class="xr-cat x-glass">{k.cat}</span>
            </div>
            <div class="xr-meta">
              <h3 class="xr-title">{typo(k.title)}</h3>
              <p class="xr-price">от {rub(k.from)}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>

  <!-- Всплывающая «Записаться» — после первого экрана -->
  <a class="xbtn xbtn--light x-float" href={calc} data-float aria-hidden="true" tabindex="-1">
    <span>Записаться</span>
    <span class="xbtn-cap" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M4 10h12m-5-5 5 5-5 5" /></svg></span>
  </a>

  <SiteFooter brand={brand} contacts={false} />
</Layout>

<script is:inline>
  /* Огромное слово — ровно во всю ширину колонки: кегль подгоняем замером, CSS-кегль — запасной */
  (function () {
    var g = document.querySelector('.xh-ghost');
    if (!g) return;
    var fit = function () {
      g.style.fontSize = '100px';
      var w = g.clientWidth, t = g.scrollWidth;   /* ширина самого блока, без полей контейнера */
      var range = document.createRange(); range.selectNodeContents(g);
      var tw = range.getBoundingClientRect().width || t;
      var px = Math.min(100 * w / tw, 360);
      g.style.fontSize = px + 'px';
      g.parentElement.style.setProperty('--ghost', px + 'px');
    };
    (document.fonts && document.fonts.ready ? document.fonts.ready : Promise.resolve()).then(fit);
    addEventListener('resize', fit);
  })();
  (function () {
    var v = document.querySelector('.xh-video');
    if (v && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      v.src = matchMedia('(max-width: 860px)').matches ? v.dataset.srcSmall : v.dataset.src;
      v.muted = true;
      var p = v.play();
      if (p && p.catch) p.catch(function () {});
    }
  })();
</script>

<script>
  /* Вкладки-папки: клик и стрелки ← → */
  const box = document.querySelector<HTMLElement>('[data-folders]');
  if (box) {
    const tabs = [...box.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (t: HTMLButtonElement, focus = false) => {
      tabs.forEach((x) => {
        const on = x === t;
        x.setAttribute('aria-selected', String(on));
        x.tabIndex = on ? 0 : -1;
        document.getElementById(x.getAttribute('aria-controls')!)!.hidden = !on;
      });
      box.style.setProperty('--first', t === tabs[0] ? '1' : '0');
      if (focus) t.focus();
      t.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        e.preventDefault();
        select(tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length], true);
      });
    });
  }

  /* «Записаться» всплывает, когда первый экран ушёл */
  const btn = document.querySelector<HTMLElement>('[data-float]');
  const hero = document.querySelector('.xh');
  if (btn && hero) {
    new IntersectionObserver(([e]) => {
      const show = !e.isIntersecting;
      btn.classList.toggle('is-on', show);
      btn.setAttribute('aria-hidden', String(!show));
      btn.tabIndex = show ? 0 : -1;
    }, { threshold: 0.15 }).observe(hero);
  }
</script>

<style>
  /* ---- Локальные токены эксперимента. Перенос на сайт — в :root global.css ---- */
  .x, .x-float {
    --x-font-display: 'Oswald Variable', 'Arial Narrow', sans-serif;
    --x-ink: #010205;
    --x-blue: #3b6cff;                 /* свечение — цвет световых линий на кадрах */
    --x-blue-2: #7a5cff;
    --x-dim: rgba(255, 255, 255, 0.38); /* второй тон заголовка на тёмном */
    --x-dim-ink: rgba(1, 2, 5, 0.34);   /* второй тон на светлом */
    --x-line: rgba(255, 255, 255, 0.12);
    --x-glass: rgba(255, 255, 255, 0.10);
    --x-glass-line: rgba(255, 255, 255, 0.18);
    --x-panel: #f2f3f5;
  }
  .x { background: var(--x-ink); color: var(--color-white); overflow-x: clip; }

  /* ---- Узкий капс: заголовки и кнопки ---- */
  .x-display {
    font-family: var(--x-font-display);
    font-weight: 500;
    text-transform: uppercase;
    line-height: 0.92;
    letter-spacing: -0.01em;
  }
  .x-display > span { display: block; }
  .x-dim { color: var(--x-dim); }

  /* ---- Стекло ---- */
  .x-glass {
    background: var(--x-glass);
    border: 1px solid var(--x-glass-line);
    -webkit-backdrop-filter: blur(20px) saturate(140%);
    backdrop-filter: blur(20px) saturate(140%);
  }

  /* ---- Свечения и линии фона ---- */
  .x-glow { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .x-glow i {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.55;
  }
  .x-glow i:nth-child(1) { width: 46vw; height: 46vw; left: -12vw; top: 10%; background: var(--x-blue); opacity: 0.35; }
  .x-glow i:nth-child(2) { width: 38vw; height: 38vw; right: -10vw; top: -8%; background: var(--x-blue-2); opacity: 0.3; }
  .x-glow i:nth-child(3) { width: 60vw; height: 24vw; left: 20vw; bottom: -14vw; background: var(--x-blue); opacity: 0.25; }
  .x-glow--side i:nth-child(1) { top: 30%; left: auto; right: -20vw; }
  .x-glow--side i:nth-child(2) { top: auto; bottom: 0; right: auto; left: -16vw; }
  .x-lines { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .x-lines path { fill: none; stroke: var(--x-line); stroke-width: 1; vector-effect: non-scaling-stroke; }

  /* ---- Кнопка: капс + стрелка в капсуле ---- */
  .xbtn {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-16);
    height: 56px;
    padding: 0 6px 0 var(--sp-28);
    border-radius: var(--r-full);
    font-family: var(--x-font-display);
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: background-color var(--t-hover-out) var(--ease-out), transform 0.2s var(--ease-out);
  }
  .xbtn:active { transform: scale(0.98); }
  .xbtn-cap {
    display: grid;
    place-items: center;
    width: 64px;
    height: 44px;
    border-radius: var(--r-full);
    transition: width 0.3s var(--ease-out-expo);
  }
  .xbtn:hover .xbtn-cap { width: 76px; }
  .xbtn-cap svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .xbtn--light { background: var(--color-white); color: var(--x-ink); }
  .xbtn--light .xbtn-cap { background: var(--x-ink); color: var(--color-white); }
  .xbtn--dark { background: var(--x-ink); color: var(--color-white); }
  .xbtn--dark .xbtn-cap { background: var(--color-white); color: var(--x-ink); }
  .xbtn--glass {
    padding-right: var(--sp-28);
    color: var(--color-white);
    background: var(--x-glass);
    border: 1px solid var(--x-glass-line);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
  }
  .xbtn--glass:hover { background: rgba(255, 255, 255, 0.16); }

  /* ================= Первый экран ================= */
  .xh {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    padding: calc(var(--header-h) + var(--sp-8)) 0 var(--sp-24);
    display: flex;
  }
  .xh-in { position: relative; z-index: 1; display: flex; flex-direction: column; width: 100%; }
  /* Огромное слово: градиентом от белого к синему и в ничто; кадр перекрывает его низ */
  .xh-ghost {
    font-family: var(--x-font-display);
    font-weight: 600;
    text-transform: uppercase;
    text-align: center;
    font-size: min(19vw, 300px);
    line-height: 0.8;
    letter-spacing: -0.005em;
    white-space: nowrap;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.95) 0%, rgba(150, 175, 255, 0.55) 45%, rgba(90, 120, 255, 0.0) 78%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    user-select: none;
  }
  .xh-card {
    position: relative;
    flex: 1;
    min-height: clamp(420px, 60svh, 680px);
    margin-top: calc(var(--ghost, min(19vw, 300px)) * -0.16);   /* кадр перекрывает низ слова, буквы читаются */
    border-radius: var(--r-tile);
    overflow: hidden;
    background: #0b0d14;
    box-shadow: 0 40px 120px rgba(40, 80, 255, 0.18), inset 0 0 0 1px var(--x-line);
  }
  .xh-media { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 70% center; }
  .xh-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(1, 2, 5, 0.92) 0%, rgba(1, 2, 5, 0.55) 32%, rgba(1, 2, 5, 0) 62%),
      linear-gradient(to right, rgba(1, 2, 5, 0.6) 0%, rgba(1, 2, 5, 0) 50%);
  }
  .xh-chips {
    position: absolute;
    top: var(--sp-24);
    right: var(--sp-24);
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--sp-8);
    max-width: 60%;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .xh-chips li {
    padding: 10px 18px;
    border-radius: var(--r-full);
    font-size: var(--text-caption);
    font-weight: var(--w-medium);
  }
  .xh-copy {
    position: absolute;
    left: clamp(24px, 3.2vw, 48px);
    bottom: clamp(24px, 3.2vw, 48px);
    display: grid;
    gap: var(--gap-group);
    justify-items: start;
  }
  .xh-h1 {
    font-size: var(--text-body);
    font-weight: var(--w-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
  }
  .xh-display { font-size: clamp(2.6rem, 5.6vw, 6rem); margin-bottom: var(--sp-8); }
  .xh-actions { display: flex; flex-wrap: wrap; gap: var(--sp-12); }
  .xh-note {
    position: absolute;
    right: clamp(24px, 3.2vw, 48px);
    bottom: clamp(24px, 3.2vw, 48px);
    max-width: 30ch;
    font-size: var(--text-caption);
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.72);
    text-align: right;
  }

  /* ================= Секции ================= */
  .xs { position: relative; isolation: isolate; padding-block: calc(var(--section-gap) * 1.2); }
  .xs > .container { position: relative; z-index: 1; }
  .xs-title { font-size: clamp(2.4rem, 5vw, 5.2rem); margin-bottom: var(--gap-block); }

  /* ---- Вкладки-папки ---- */
  .xf { --first: 1; }
  .xf-tabs {
    display: flex;
    gap: 4px;
    overflow-x: auto;
    scrollbar-width: none;
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
  }
  .xf-tabs::-webkit-scrollbar { display: none; }
  .xf-tab {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: var(--sp-12);
    height: 60px;
    padding: 0 var(--sp-16) 0 var(--sp-20);
    border: 0;
    border-radius: 20px 20px 0 0;
    background: rgba(255, 255, 255, 0.07);
    color: rgba(255, 255, 255, 0.78);
    font: inherit;
    font-size: var(--text-body);
    cursor: pointer;
    position: relative;
    transition: background-color var(--t-hover-out) var(--ease-out), color var(--t-hover-out) var(--ease-out);
  }
  .xf-tab:hover { background: rgba(255, 255, 255, 0.13); color: var(--color-white); }
  .xf-tab[aria-selected='true'] { background: var(--x-panel); color: var(--x-ink); }
  /* «ушки» папки: вогнутые скругления у основания активной вкладки */
  .xf-tab[aria-selected='true']::before,
  .xf-tab[aria-selected='true']::after {
    content: '';
    position: absolute;
    bottom: 0;
    width: 20px;
    height: 20px;
    background: radial-gradient(circle at var(--cx) 0, transparent 19.5px, var(--x-panel) 20px);
  }
  .xf-tab[aria-selected='true']::before { left: -20px; --cx: 0; }
  .xf-tab[aria-selected='true']::after { right: -20px; --cx: 100%; }
  .xf-tab:first-child[aria-selected='true']::before { display: none; }
  .xf-count {
    display: grid;
    place-items: center;
    min-width: 28px;
    height: 28px;
    padding: 0 8px;
    border-radius: var(--r-full);
    border: 1px solid currentColor;
    font-size: var(--text-caption);
    font-weight: var(--w-medium);
    opacity: 0.7;
  }
  .xf-tab[aria-selected='true'] .xf-count { background: var(--x-ink); border-color: var(--x-ink); color: var(--color-white); opacity: 1; }

  .xf-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: var(--sp-32);
    padding: clamp(20px, 2.6vw, 40px);
    border-radius: var(--r-tile);
    border-top-left-radius: calc(var(--r-tile) * (1 - var(--first)));
    background: var(--x-panel);
    color: var(--x-ink);
  }
  .xf-panel[hidden] { display: none; }
  .xf-body { display: flex; flex-direction: column; gap: var(--gap-group); min-width: 0; }
  .xf-kicker { font-size: var(--text-caption); letter-spacing: 0.08em; text-transform: uppercase; color: var(--x-dim-ink); }
  .xf-title {
    font-family: var(--x-font-display);
    font-weight: 500;
    text-transform: uppercase;
    font-size: clamp(2rem, 3.6vw, 3.8rem);
    line-height: 0.95;
  }
  .xf-list { margin: var(--sp-8) 0 0; padding: 0; list-style: none; }
  .xf-list a {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-16);
    padding: 14px 0;
    border-top: 1px solid rgba(1, 2, 5, 0.1);
    font-size: var(--text-body-lg);
    transition: color var(--t-hover-out) var(--ease-out);
