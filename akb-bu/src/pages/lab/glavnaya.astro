---
/* Эксперимент «главная с душой» (03.11.2026). Служебная страница: не в меню, noindex.
   Рабочая главная (pages/index.astro) не тронута — сравнить и перенести удачное.
   Итерации и отвергнутое — docs/journal.md за 03.11.2026. Сейчас:
   — первый экран — ролик во весь экран, заголовок «Премиальный детейлинг в Москве» крупным
     шрифтом заголовков, пилюли-факты (часы, адрес), две скруглённые кнопки без капса;
   — шрифт заголовков — Oswald (выбран 03.11.2026 из шести), капс — только в заголовках;
   — палитра: чёрный, синие и сиреневые свечения одним слоем за всей страницей;
   — направления — карточки вширь парами, фото до краёв;
   — калькулятор: машина → вкладки-папки направлений → услуги галочками → итог → заявка;
   — дальше блоки рабочей главной: сезонные пакеты, гарантии с иконками, контакты, вопросы.
   Цены — только из прайса (lib/sections.js, catalog.js), руками не вписаны. */
import '@fontsource-variable/oswald';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Section from '../../components/Section.astro';
import SeasonPacks from '../../components/SeasonPacks.astro';
import Contacts from '../../components/Contacts.astro';
import Faq from '../../components/Faq.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import content from '../../data/content.json';
import seasonPacks from '../../data/season-packs.json';
import { categories, rub } from '../../lib/catalog.js';
import { siteCategories } from '../../lib/sections.js';
import { directionSlug, sectionSlug, pageDirections, pageServices } from '../../lib/pages.js';
import { asset, url } from '../../lib/paths.js';
import { typo } from '../../lib/typo.js';

const { brand, hero, contacts, guarantees, faq } = content;
const calc = url('/calc/');
const pageOf = (slug, fallback) => (slug ? url(`/${slug}/`) : fallback);

/* Факты на первом экране — только проверяемые, из content.json */
const chips = [contacts.hours.replace(/^./, (ch) => ch.toUpperCase()), contacts.address.replace(/^Москва,\s*/, '')];

/* ---- Направления ---- */
const leadOf = (catId) => {
  const d = pageDirections.find((x) => x.cat.id === catId);
  if (!d) return '';
  if (d.lead) return d.lead;
  const page = d.page && pageServices.find((x) => (x.slug ?? x.page) === d.page);
  return page?.lead ?? '';
};
/* Цена услуги по классу: столбец прайса, где номер класса — число в начале подписи */
const priceCells = (svc, labels) => {
  const cells = [null, null, null, null, null];
  for (const l of labels) {
    const n = parseInt(l, 10);
    const c = svc.prices[l];
    if (n >= 1 && n <= 5 && c) cells[n - 1] = c.value ?? c.min ?? null;
  }
  return cells;
};
const firstPrice = (cells) => cells.find((v) => v != null) ?? null;
const rowsOf = (c) => {
  if (c.items.length > 1)
    return c.items.map((s) => ({ title: s.title, from: s.from, href: pageOf(sectionSlug(s.id), `${calc}?cat=${c.id}&sheet=${s.id}`) }));
  const sec = siteCategories.find((x) => x.id === c.id)?.sections[0];
  if (!sec) return [];
  const href = pageOf(sectionSlug(sec.id) ?? directionSlug(c.id), `${calc}?cat=${c.id}&sheet=${sec.id}`);
  return sec.services.slice(0, 4).map((x) => ({ title: x.service.name, from: firstPrice(priceCells(x.service, x.sheet.classLabels)), href }));
};
/* Пары по длине списка: высота в ряду общая и почти не расходится — дыр нет */
const ORDER = ['uhod', 'plenki', 'pokrytiya', 'himchistka', 'polirovka', 'pdr'];
const rank = (id) => (ORDER.indexOf(id) + 99) % 99;
const cats = [...categories].sort((a, b) => rank(a.id) - rank(b.id));

/* ---- Пакеты под ключ (Артур, 03.11.2026): подготовка + полировка + покрытие одним заказом,
   для новой машины (пробег до 500 км) и с пробегом. Цены — строки прайса по id, по 5 классам.
   Марку покрытия в название не ставим: в текстах сайта покрытия уже Krytex, в прайсе — прежнее */
const allServices = new Map();
for (const c of siteCategories) for (const sec of c.sections) for (const x of sec.services) allServices.set(x.service.id, x);
const pkgRow = (id, title, polish) => {
  const x = allServices.get(id);
  if (!x) throw new Error(`пакеты: строка прайса «${id}» не найдена на сайте`);
  return { title, polish, cells: priceCells(x.service, x.sheet.classLabels) };
};
const packs = [
  { id: 'new', tab: 'Новая машина', note: 'Пробег до 500 км: лак почти без следов, хватает мягкой полировки.', items: [
    pkgRow('zhidkoe-steklo-power-shield-supershine-dlya-novogo-avto-prob', 'Жидкое стекло под ключ', 'Мягкая полировка'),
    pkgRow('keramicheskoe-pokrytie-power-shield-dlya-novogo-avto-probeg-', 'Керамика под ключ, 2\u00a0слоя', 'Мягкая полировка'),
  ] },
  { id: 'used', tab: 'С пробегом', note: 'Сначала убираем царапины и голограммы от моек, потом закрываем лак.', items: [
    pkgRow('zhidkoe-steklo-power-shield-supershine-dlya-avto-s-probegom', 'Жидкое стекло под ключ', 'Восстановительная полировка'),
    pkgRow('keramicheskoe-pokrytie-power-shield-dlya-avto-s-probegom-2-s', 'Керамика под ключ, 2\u00a0слоя', 'Восстановительная полировка'),
  ] },
];
const packsHref = pageOf(sectionSlug('polirovka-keramika-pod-klyuch'), `${calc}?cat=polirovka&sheet=polirovka-keramika-pod-klyuch`);

/* ---- Как проходит визит — по ответам из FAQ и гарантиям (content.json), без новых обещаний ---- */
const visit = [
  { t: 'Заявка или звонок', d: 'Оставьте телефон или позвоните — менеджер перезвонит, подтвердит сумму и время.' },
  { t: 'Осмотр при вас', d: 'Смотрим машину вместе при свете ламп и снимаем её на приёмке.' },
  { t: 'Работа', d: 'Сумму фиксируем до начала работ — по прайсу для класса вашей машины.' },
  { t: 'Выдача', d: 'Принимаете работу при свете ламп, фото до и после — у вас.' },
];

/* ---- Гарантии: иконки — линейные, 32×32, тонкая линия, без плашки (позже — сгенерированные) ---- */
const icons = [
  /* цена зафиксирована: ценник с галочкой */
  '<path d="M3.5 12.6V5.5a2 2 0 0 1 2-2h7.1a2 2 0 0 1 1.4.6l13.4 13.4a2 2 0 0 1 0 2.8l-7.1 7.1a2 2 0 0 1-2.8 0L4.1 14a2 2 0 0 1-.6-1.4Z"/><circle cx="9.5" cy="9.5" r="1.8"/><path d="m13.5 18 2.6 2.6 5-5"/>',
  /* гарантия: щит с лучами блеска */
  '<path d="M16 3.5 6 7.5v7.2c0 6.2 4.2 11.3 10 13.8 5.8-2.5 10-7.6 10-13.8V7.5l-10-4Z"/><path d="M16 11v8m-4-4h8"/>',
  /* приёмка при свете ламп: лампа-полоса и блик */
  '<rect x="5" y="3.5" width="4" height="25" rx="2"/><path d="M14 9.5c4 1.2 8 1.2 13 0M14 16c4 1.2 8 1.2 13 0M14 22.5c4 1.2 8 1.2 13 0"/>',
  /* фото до и после: две рамки */
  '<rect x="3.5" y="8" width="16" height="12" rx="2.5"/><rect x="12.5" y="12" width="16" height="12" rx="2.5"/><circle cx="20.5" cy="18" r="2.6"/>',
];

---

<Layout title={`Главная — эксперимент | ${brand.name}`} noindex>
  <Header overlay />

  <!-- Свечения — один слой за всей страницей (fixed), без стыков между блоками -->
  <div class="x-bg" aria-hidden="true"><i></i><i></i><i></i><i></i></div>

  <main class="x">
    <!-- ============ Первый экран: ролик во весь экран ============ -->
    <section class="xh" data-bg="#010205">
      <img class="xh-media" src={asset(hero.poster)} alt="" fetchpriority="high" decoding="async" />
      <video class="xh-media xh-video" muted loop playsinline preload="auto" poster={asset(hero.poster)} aria-hidden="true"
        data-src={asset(hero.video)} data-src-small={asset(hero.videoSmall)}></video>
      <div class="xh-scrim" aria-hidden="true"></div>

      <div class="container xh-in">
        <!-- пилюли — наверху (03.11.2026, «подними плашечки») -->
        <ul class="xh-chips">
          {chips.map((c) => <li>{typo(c)}</li>)}
        </ul>
        <div class="xh-copy">
          <h1 class="x-display xh-title">Премиальный детейлинг в&nbsp;Москве</h1>
          <div class="xh-actions">
            <a class="xbtn xbtn--light" href={calc}>Рассчитать стоимость</a>
            <a class="xbtn xbtn--glass" href="#napravleniya">Выбрать услугу</a>
          </div>
        </div>
        <p class="xh-note">{typo('Стоимость — по классу автомобиля, точная цифра — после осмотра при вас.')}</p>
      </div>
    </section>

    <!-- ============ Направления ============ -->
    <section class="xs" id="napravleniya">
      <div class="container">
        <h2 class="x-display xs-title">Шесть направлений. Одна планка качества.</h2>
        <div class="xd">
          {cats.map((c) => (
            <article class="xd-card">
              {c.media && (
                <div class="xd-media" aria-hidden="true">
                  <img src={asset(c.media)} alt="" loading="lazy" decoding="async" />
                </div>
              )}
              <div class="xd-body">
                <h3 class="x-display xd-title"><a href={pageOf(directionSlug(c.id), `${calc}?cat=${c.id}`)}>{c.title}</a></h3>
                {leadOf(c.id) && <p class="xd-lead">{typo(leadOf(c.id))}</p>}
                <ul class="xd-list">
                  {rowsOf(c).map((r) => (
                    <li>
                      <a href={r.href}>
                        <span>{typo(r.title)}</span>
                        {r.from != null && <span class="xd-price">от {rub(r.from)}</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ Пакеты под ключ: новая машина / с пробегом ============ -->
    <!-- Калькулятор с главной снят (03.11.2026: «калькулятор пока не трогать») — он на /calc/ -->
    <section class="xs" id="pakety">
      <div class="container">
        <h2 class="x-display xs-title">Пакеты под ключ</h2>
        <p class="xs-lead">{typo('Подготовка, полировка и защитное покрытие одним заказом — для новой машины и для машины с пробегом.')}</p>
        <div class="xp" data-packs>
          <div class="xp-switch" role="tablist" aria-label="Состояние машины">
            {packs.map((pk, i) => (
              <button type="button" role="tab" class="xp-tab" data-pack={pk.id} aria-selected={i === 0 ? 'true' : 'false'}>{pk.tab}</button>
            ))}
          </div>
          {packs.map((pk, i) => (
            <div class="xp-panel" data-pack-panel={pk.id} hidden={i !== 0}>
              <p class="xp-note">{typo(pk.note)}</p>
              <div class="xp-grid">
                {pk.items.map((it) => (
                  <a class="xp-card" href={packsHref}>
                    <h3 class="x-display xp-title">{it.title}</h3>
                    <ol class="xp-steps">
                      <li>{typo('Детейлинг-мойка, очистка лака от битума и металла, глина')}</li>
                      <li>{it.polish}</li>
                      <li>{it.title.startsWith('Керамика') ? typo('Керамика в 2 слоя — блеск и защита от реагентов') : typo('Жидкое стекло — вода скатывается, машина дольше чистая')}</li>
                    </ol>
                    <dl class="xp-prices">
                      {it.cells.map((v, k) => v != null && (
                        <div><dt>{k + 1} класс</dt><dd>{rub(v)}</dd></div>
                      ))}
                    </dl>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ Блоки рабочей главной ============ -->
    <Section id="season" dark label={seasonPacks.season.label} title={seasonPacks.season.title}>
      <SeasonPacks href={calc} />
    </Section>

    <section class="xs" id="garantii">
      <div class="container">
        <h2 class="x-display xs-title">{guarantees.title}</h2>
        <ul class="xg">
          {guarantees.items.map((g, i) => (
            <li class="xg-item">
              <svg class="xg-icon" viewBox="0 0 32 32" aria-hidden="true" set:html={icons[i % icons.length]} />
              <h3 class="xg-title">{typo(g.title)}</h3>
              <p class="xg-text">{typo(g.text)}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============ Как проходит визит ============ -->
    <section class="xs" id="vizit">
      <div class="container">
        <h2 class="x-display xs-title">Как проходит визит</h2>
        <ol class="xv">
          {visit.map((v, i) => (
            <li class="xv-item">
              <span class="x-display xv-num">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="xv-title">{typo(v.t)}</h3>
              <p class="xv-text">{typo(v.d)}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ============ Заявка — отдельный цветной экран (как в FG Север), по центру ============ -->
    <section class="xs xl-wrap" id="zapis">
      <div class="xl" data-xlead>
        <div class="xl-glow" aria-hidden="true"><i></i><i></i><i></i></div>
        <div class="xl-in">
          <h2 class="x-display xl-title">Записаться</h2>
          <p class="xl-sub">{typo(`Оставьте телефон — перезвоним, уточним задачу и подберём время. ${contacts.hours.replace(/^./, (c) => c.toUpperCase())}.`)}</p>
          <form class="xl-form" data-xlead-form novalidate>
            <label class="xl-field"><span>Телефон</span>
              <input name="phone" type="tel" inputmode="tel" autocomplete="tel" required placeholder="+7 (900) 000-00-00" data-xphone />
              <small data-err="phone" hidden>Введите номер полностью: 10 цифр после +7</small>
            </label>
            <label class="xl-field"><span>Имя</span>
              <input name="name" autocomplete="given-name" required maxlength="60" placeholder="Как к вам обращаться" />
              <small data-err="name" hidden>Напишите, как к вам обращаться</small>
            </label>
            <label class="xl-consent">
              <input type="checkbox" name="consent" checked />
              <span>Согласен на <a href={url('/soglasie/')}>обработку персональных данных</a></span>
            </label>
            <small class="xl-err" data-err="consent" hidden>Без согласия заявку отправить нельзя</small>
            <button class="xbtn xbtn--light xl-send" type="submit">Отправить заявку</button>
            <p class="xl-status" role="status" aria-live="polite" data-xstatus hidden></p>
          </form>
        </div>
      </div>
    </section>

    <Section id="contacts" dark>
      <Contacts />
    </Section>

    <Section id="faq" dark>
      <Faq title={faq.title} items={faq.items} />
    </Section>
  </main>

  <SiteFooter brand={brand} contacts={false} />

</Layout>

<script is:inline>
  (function () {
    var v = document.querySelector('.xh-video');
    if (v && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      v.src = matchMedia('(max-width: 860px)').matches ? v.dataset.srcSmall : v.dataset.src;
      v.muted = true;
      var p = v.play();
      if (p && p.catch) p.catch(function () {});
    }
  })();
</script>

<script>
  /* ---- Пакеты: новая машина / с пробегом ---- */
  const packsBox = document.querySelector<HTMLElement>('[data-packs]');
  if (packsBox) {
    const tabs = [...packsBox.querySelectorAll<HTMLButtonElement>('[data-pack]')];
    tabs.forEach((t) => t.addEventListener('click', () => {
      tabs.forEach((x) => x.setAttribute('aria-selected', String(x === t)));
      packsBox.querySelectorAll<HTMLElement>('[data-pack-panel]').forEach((p) => { p.hidden = p.dataset.packPanel !== t.dataset.pack; });
    }));
  }

  /* ---- Заявка: телефон +7 (XXX) XXX-XX-XX, имя, согласие. Отправка — событие lead:submit,
     как у остальных форм сайта (доставку Apps Script → Telegram подключим к нему одной точкой) ---- */
  const form = document.querySelector<HTMLFormElement>('[data-xlead-form]');
  if (form) {
    const phone = form.querySelector<HTMLInputElement>('[data-xphone]')!;
    const name = form.querySelector<HTMLInputElement>('[name=name]')!;
    const consent = form.querySelector<HTMLInputElement>('[name=consent]')!;
    const status = form.querySelector<HTMLElement>('[data-xstatus]')!;
    const digits = (v: string) => {
      let d = v.replace(/\D/g, '');
      if (v.trim().startsWith('+7')) d = d.slice(1);
      else if (d.length === 11 && /^[78]/.test(d)) d = d.slice(1);
      return d.slice(0, 10);
    };
    const mask = (d: string) => (d ? '+7 (' + d.slice(0, 3) + (d.length > 3 ? ') ' + d.slice(3, 6) : '') + (d.length > 6 ? '-' + d.slice(6, 8) : '') + (d.length > 8 ? '-' + d.slice(8, 10) : '') : '');
    const err = (k: string, on: boolean) => { form.querySelector<HTMLElement>(`[data-err=${k}]`)!.hidden = !on; };
    const checks: Record<string, () => boolean> = {
      phone: () => digits(phone.value).length === 10,
      name: () => /\p{L}{2,}/u.test(name.value.trim()),
      consent: () => consent.checked,
    };
    phone.addEventListener('focus', () => { if (!phone.value) phone.value = '+7 ('; });
    phone.addEventListener('blur', () => { if (!digits(phone.value)) phone.value = ''; });
    phone.addEventListener('input', () => {
      let d = digits(phone.value);
      if (!phone.dataset.started && /^[78]/.test(d)) d = d.slice(1);
      phone.dataset.started = d ? '1' : '';
      phone.value = mask(d) || '+7 (';
      if (checks.phone()) err('phone', false);
    });
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const bad = Object.keys(checks).filter((k) => { const ok = checks[k](); err(k, !ok); return !ok; });
      if (bad.length) return;
      document.dispatchEvent(new CustomEvent('lead:submit', { detail: { name: name.value.trim(), phone: mask(digits(phone.value)), service: 'Запись с главной', url: location.href } }));
      form.reset();
      phone.dataset.started = '';
      status.textContent = 'Заявка у нас — перезвоним в рабочее время.';
      status.hidden = false;
    });
  }

  /* ---- Цветной экран заявки: свечения чуть растут, пока блок проходит по экрану (приём FG Север) ---- */
  const lead = document.querySelector<HTMLElement>('[data-xlead]');
  if (lead && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const zoom = () => {
      const r = lead.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (innerHeight - r.top) / (innerHeight + r.height)));
      lead.style.setProperty('--xl-zoom', String(0.8 + p * 0.7));
    };
    addEventListener('scroll', zoom, { passive: true });
    zoom();
  }
</script>

<style>
  /* ---- Локальные токены эксперимента. Перенос на сайт — в :root global.css ---- */
  :global(html) {
    --x-font-display: 'Oswald Variable', 'Arial Narrow', sans-serif;
    --x-display-weight: 500;
    --x-display-case: uppercase;
    --x-display-track: -0.01em;
    --x-display-lh: 0.95;
    --x-display-scale: 1;
    --x-display-vars: normal;
  }

  .x, .x-bg {
    --x-ink: #010205;
    --x-blue: #3b6cff;
    --x-violet: #7a5cff;
    --x-line: rgba(255, 255, 255, 0.12);
    --x-glass: rgba(255, 255, 255, 0.14);
    --x-panel: #f2f3f5;
  }
  .x { position: relative; color: var(--color-white); overflow-x: clip; }
  :global(body:has(.x)) { background: var(--x-ink); }
  /* блоки рабочей главной — без своего фона: под ними общий слой свечений */
  .x :global(.section--dark) { background: transparent; }

  /* ---- Заголовки: шрифт на выбор, капс — только здесь ---- */
  .x-display {
    font-family: var(--x-font-display);
    font-weight: var(--x-display-weight);
    font-variation-settings: var(--x-display-vars);
    text-transform: var(--x-display-case);
    letter-spacing: var(--x-display-track);
    line-height: var(--x-display-lh);
  }

  /* заголовки блоков рабочей главной — тем же шрифтом заголовков */
  .x :global(.section-title),
  .x :global(.contacts-title),
  .x :global(.faq-title),
  .x :global(.lead-title) {
    font-family: var(--x-font-display);
    font-weight: var(--x-display-weight);
    font-variation-settings: var(--x-display-vars);
    text-transform: var(--x-display-case);
    letter-spacing: var(--x-display-track);
    line-height: var(--x-display-lh);
