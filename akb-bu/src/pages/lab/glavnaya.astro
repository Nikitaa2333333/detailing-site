---
/* Эксперимент «главная с душой» (03.11.2026). Служебная страница: не в меню, noindex.
   Рабочая главная (pages/index.astro) не тронута — сравнить и перенести удачное.
   Что взято из референсов пользователя:
   — крупная узкая капс-типографика (Oswald) и двухтоновые позиционирующие заголовки;
   — палитра: глубокий чёрный, синие свечения, тонкие линии, стекло (финансовое приложение);
   (вкладки-папки и слово за кадром пробовали — сняты 03.11.2026: папки — в калькулятор);
   — капс-кнопка со стрелкой в белой капсуле и всплывающая «Записаться» (Rentra);
   — лента карточек без точек и круглых стрелок (Rentra, второй экран).
   Цены — из прайса (catalog.js), руками не вписаны. */
import '@fontsource-variable/oswald';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import content from '../../data/content.json';
import { categories, rub } from '../../lib/catalog.js';
import { directionSlug, sectionSlug } from '../../lib/pages.js';
import { asset, url } from '../../lib/paths.js';
import { typo } from '../../lib/typo.js';

const { brand, hero } = content;
const calc = url('/calc/');
const pageOf = (slug, fallback) => (slug ? url(`/${slug}/`) : fallback);

/* Лента: первый раздел каждого направления — «с чего начинают» (по два — фото повторялись) */
const cards = categories.flatMap((c) =>
  c.items.slice(0, 1).map((s) => ({
    id: s.id,
    title: s.title,
    from: s.from,
    cat: c.title,
    media: c.media,
    href: pageOf(sectionSlug(s.id), `${calc}?cat=${c.id}&sheet=${s.id}`),
  })),
);

const chips = ['С 2014 года', '3 поста в Москве', 'Климат-камера для плёнки и керамики'];
---

<Layout title={`Главная — эксперимент | ${brand.name}`} noindex>
  <Header overlay />

  <main class="x">
    <!-- ============ Первый экран: ролик во весь экран ============ -->
    <!-- 03.11.2026: слово за кадром и кадр-плашка на фоне сняты («плашка на плашке») —
         первый экран и есть видео, текст и кнопки поверх него -->
    <section class="xh" data-bg="#010205">
      <img class="xh-media" src={asset(hero.poster)} alt="" fetchpriority="high" decoding="async" />
      <video class="xh-media xh-video" muted loop playsinline preload="auto" poster={asset(hero.poster)} aria-hidden="true"
        data-src={asset(hero.video)} data-src-small={asset(hero.videoSmall)}></video>
      <div class="xh-scrim" aria-hidden="true"></div>

      <div class="container xh-in">
        <ul class="xh-chips">
          {chips.map((c) => <li class="x-glass">{typo(c)}</li>)}
        </ul>

        <div class="xh-copy">
          <h1 class="xh-h1">Премиальный детейлинг в&nbsp;Москве</h1>
          <p class="x-display xh-display">
            <span>Для тех, кто</span>
            <span class="x-dim">замечает детали</span>
          </p>
          <div class="xh-actions">
            <a class="xbtn xbtn--light" href={calc}>
              <span>Рассчитать стоимость</span>
              <span class="xbtn-cap" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M4 10h12m-5-5 5 5-5 5" /></svg></span>
            </a>
            <a class="xbtn xbtn--glass" href="#napravleniya"><span>Выбрать услугу</span></a>
          </div>
        </div>

        <p class="xh-note">{typo('Стоимость — по классу автомобиля, точная цифра — после осмотра при вас.')}</p>
      </div>
    </section>

    <!-- ============ Направления: все шесть открыты сразу ============ -->
    <!-- 03.11.2026: вкладки-папки сняты с главной («сразу всё должно открываться»),
         папки — потом в калькулятор. Карточки по содержимому, колонками -->
    <section class="xs" id="napravleniya">
      <div class="x-glow x-glow--side" aria-hidden="true"><i></i><i></i></div>
      <div class="container">
        <h2 class="x-display xs-title">
          <span>Шесть направлений.</span>
          <span class="x-dim">Одна планка качества.</span>
        </h2>

        <div class="xd">
          {categories.map((c, i) => (
            <article class="xd-card">
              {c.media && (
                <a class="xd-media" href={pageOf(directionSlug(c.id), `${calc}?cat=${c.id}`)} tabindex="-1" aria-hidden="true">
                  <img src={asset(c.media)} alt="" loading="lazy" decoding="async" />
                </a>
              )}
              <div class="xd-body">
                <h3 class="xd-title">{c.title}</h3>
                <ul class="xd-list">
                  {c.items.map((s) => (
                    <li>
                      <a href={pageOf(sectionSlug(s.id), `${calc}?cat=${c.id}&sheet=${s.id}`)}>
                        <span>{s.title}</span>
                        <span class="xd-price">от {rub(s.from)}</span>
                      </a>
                    </li>
                  ))}
                </ul>
                <div class="xd-foot">
                  <p class="xd-from"><small>от</small> {rub(c.from)}</p>
                  <a class="xbtn xbtn--dark" href={pageOf(directionSlug(c.id), `${calc}?cat=${c.id}`)}>
                    <span>Услуги и цены</span>
                    <span class="xbtn-cap" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M4 10h12m-5-5 5 5-5 5" /></svg></span>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ Лента карточек ============ -->
    <section class="xs xs--rail">
      <div class="container">
        <h2 class="x-display xs-title">
          <span>С чего начинают</span>
          <span class="x-dim">наши клиенты</span>
        </h2>
      </div>
      <div class="xr" tabindex="0" aria-label="Популярные услуги">
        {cards.map((k) => (
          <a class="xr-card" href={k.href}>
            <div class="xr-photo">
              {k.media && <img src={asset(k.media)} alt="" loading="lazy" decoding="async" />}
              <span class="xr-cat x-glass">{k.cat}</span>
            </div>
            <div class="xr-meta">
              <h3 class="xr-title">{typo(k.title)}</h3>
              <p class="xr-price">от {rub(k.from)}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>

  <!-- Всплывающая «Записаться» — после первого экрана -->
  <a class="xbtn xbtn--light x-float" href={calc} data-float aria-hidden="true" tabindex="-1">
    <span>Записаться</span>
    <span class="xbtn-cap" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M4 10h12m-5-5 5 5-5 5" /></svg></span>
  </a>

  <SiteFooter brand={brand} contacts={false} />
</Layout>

<script is:inline>
  (function () {
    var v = document.querySelector('.xh-video');
    if (v && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      v.src = matchMedia('(max-width: 860px)').matches ? v.dataset.srcSmall : v.dataset.src;
      v.muted = true;
      var p = v.play();
      if (p && p.catch) p.catch(function () {});
    }
  })();
</script>

<script>
  /* «Записаться» всплывает, когда первый экран ушёл */
  const btn = document.querySelector<HTMLElement>('[data-float]');
  const hero = document.querySelector('.xh');
  if (btn && hero) {
    new IntersectionObserver(([e]) => {
      const show = !e.isIntersecting;
      btn.classList.toggle('is-on', show);
      btn.setAttribute('aria-hidden', String(!show));
      btn.tabIndex = show ? 0 : -1;
    }, { threshold: 0.15 }).observe(hero);
  }
</script>

<style>
  /* ---- Локальные токены эксперимента. Перенос на сайт — в :root global.css ---- */
  .x, .x-float {
    --x-font-display: 'Oswald Variable', 'Arial Narrow', sans-serif;
    --x-ink: #010205;
    --x-blue: #3b6cff;                 /* свечение — цвет световых линий на кадрах */
    --x-blue-2: #7a5cff;
    --x-dim: rgba(255, 255, 255, 0.38); /* второй тон заголовка на тёмном */
    --x-dim-ink: rgba(1, 2, 5, 0.34);   /* второй тон на светлом */
    --x-line: rgba(255, 255, 255, 0.12);
    --x-glass: rgba(255, 255, 255, 0.10);
    --x-glass-line: rgba(255, 255, 255, 0.18);
    --x-panel: #f2f3f5;
  }
  .x { background: var(--x-ink); color: var(--color-white); overflow-x: clip; }

  /* ---- Узкий капс: заголовки и кнопки ---- */
  .x-display {
    font-family: var(--x-font-display);
    font-weight: 500;
    text-transform: uppercase;
    line-height: 0.92;
    letter-spacing: -0.01em;
  }
  .x-display > span { display: block; }
  .x-dim { color: var(--x-dim); }

  /* ---- Стекло ---- */
  .x-glass {
    background: var(--x-glass);
    border: 1px solid var(--x-glass-line);
    -webkit-backdrop-filter: blur(20px) saturate(140%);
    backdrop-filter: blur(20px) saturate(140%);
  }

  /* ---- Свечения и линии фона ---- */
  .x-glow { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .x-glow i {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.55;
  }
  .x-glow i:nth-child(1) { width: 46vw; height: 46vw; left: -12vw; top: 10%; background: var(--x-blue); opacity: 0.35; }
  .x-glow i:nth-child(2) { width: 38vw; height: 38vw; right: -10vw; top: -8%; background: var(--x-blue-2); opacity: 0.3; }
  .x-glow i:nth-child(3) { width: 60vw; height: 24vw; left: 20vw; bottom: -14vw; background: var(--x-blue); opacity: 0.25; }
  .x-glow--side i:nth-child(1) { top: 30%; left: auto; right: -20vw; }
  .x-glow--side i:nth-child(2) { top: auto; bottom: 0; right: auto; left: -16vw; }

  /* ---- Кнопка: капс + стрелка в капсуле ---- */
  .xbtn {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-16);
    height: 56px;
    padding: 0 6px 0 var(--sp-28);
    border-radius: var(--r-full);
    font-family: var(--x-font-display);
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: background-color var(--t-hover-out) var(--ease-out), transform 0.2s var(--ease-out);
  }
  .xbtn:active { transform: scale(0.98); }
  .xbtn-cap {
    display: grid;
    place-items: center;
    width: 64px;
    height: 44px;
    border-radius: var(--r-full);
    transition: width 0.3s var(--ease-out-expo);
  }
  .xbtn:hover .xbtn-cap { width: 76px; }
  .xbtn-cap svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .xbtn--light { background: var(--color-white); color: var(--x-ink); }
  .xbtn--light .xbtn-cap { background: var(--x-ink); color: var(--color-white); }
  .xbtn--dark { background: var(--x-ink); color: var(--color-white); }
  .xbtn--dark .xbtn-cap { background: var(--color-white); color: var(--x-ink); }
  .xbtn--glass {
    padding-right: var(--sp-28);
    color: var(--color-white);
    background: var(--x-glass);
    border: 1px solid var(--x-glass-line);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
  }
  .xbtn--glass:hover { background: rgba(255, 255, 255, 0.16); }

  /* ================= Первый экран: ролик во весь экран ================= */
  .xh {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    display: flex;
    overflow: hidden;
    border-radius: 0 0 var(--r-hero) var(--r-hero);
    background: var(--x-ink);
  }
  .xh-media { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 70% center; z-index: -2; }
  .xh-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to bottom, rgba(1, 2, 5, 0.55) 0%, rgba(1, 2, 5, 0) 22%),
      linear-gradient(to top, rgba(1, 2, 5, 0.92) 0%, rgba(1, 2, 5, 0.5) 34%, rgba(1, 2, 5, 0) 62%),
      linear-gradient(to right, rgba(1, 2, 5, 0.55) 0%, rgba(1, 2, 5, 0) 52%);
  }
  .xh-in {
    position: relative;
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: auto 1fr auto;
    grid-template-areas: 'chips chips' '. .' 'copy note';
    align-items: end;
    gap: var(--sp-24);
    padding-top: calc(var(--header-h) + var(--sp-16));
    padding-bottom: clamp(32px, 4vw, 56px);
  }
  .xh-chips {
    grid-area: chips;
    justify-self: end;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--sp-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .xh-chips li {
    padding: 10px 18px;
    border-radius: var(--r-full);
    font-size: var(--text-caption);
    font-weight: var(--w-medium);
  }
  .xh-copy { grid-area: copy; display: grid; gap: var(--gap-group); justify-items: start; }
  .xh-h1 {
    font-size: var(--text-body);
    font-weight: var(--w-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.78);
  }
  .xh-display { font-size: clamp(2.8rem, 6.4vw, 7rem); margin-bottom: var(--sp-8); }
  .xh-actions { display: flex; flex-wrap: wrap; gap: var(--sp-12); }
  .xh-note {
    grid-area: note;
    max-width: 30ch;
    font-size: var(--text-caption);
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.78);
    text-align: right;
  }

  /* ================= Секции ================= */
  .xs { position: relative; isolation: isolate; padding-block: calc(var(--section-gap) * 1.2); }
  .xs > .container { position: relative; z-index: 1; }
  .xs-title { font-size: clamp(2.4rem, 5vw, 5.2rem); margin-bottom: var(--gap-block); }

  /* ---- Направления: карточки по содержимому, колонками (правило дизайн-системы) ---- */
  .xd { columns: 3; column-gap: var(--sp-16); }
  .xd-card {
    break-inside: avoid;
    margin-bottom: var(--sp-16);
    display: grid;
    padding: 10px;
    border-radius: var(--r-tile);
    background: var(--x-panel);
    color: var(--x-ink);
  }
  .xd-media { position: relative; display: block; aspect-ratio: 16 / 10; border-radius: var(--r-panel); overflow: hidden; background: #11131b; }
  .xd-media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease-out-expo); }
  .xd-card:hover .xd-media img { transform: scale(1.04); }
  .xd-body { display: grid; gap: var(--gap-group); padding: var(--sp-20) 14px 14px; }
  .xd-title {
    font-family: var(--x-font-display);
    font-weight: 500;
    text-transform: uppercase;
    font-size: clamp(1.8rem, 2.4vw, 2.6rem);
    line-height: 0.95;
  }
  .xd-list { margin: 0; padding: 0; list-style: none; }
  .xd-list a {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-16);
    padding: 12px 0;
    border-top: 1px solid rgba(1, 2, 5, 0.1);
    font-size: var(--text-body);
    transition: color var(--t-hover-out) var(--ease-out);
  }
  .xd-list a:hover { color: #2b4fd8; transition-duration: var(--t-hover-in); }
  .xd-price { flex: none; color: rgba(1, 2, 5, 0.55); font-variant-numeric: tabular-nums; }
  .xd-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--sp-12); padding-top: var(--sp-4); }
  .xd-from { font-family: var(--x-font-display); font-weight: 500; font-size: 2rem; line-height: 1; white-space: nowrap; }
  .xd-from small { font-size: 0.5em; color: var(--x-dim-ink); text-transform: uppercase; }
  @media (max-width: 1100px) { .xd { columns: 2; } }
  @media (max-width: 680px) { .xd { columns: 1; } }

  /* ---- Лента карточек ---- */
  .xr {
    display: flex;
    align-items: flex-start;   /* карточки по содержимому, без растяжки до самой высокой */
    gap: var(--sp-16);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    padding: 0 var(--gutter) var(--sp-8);
    scrollbar-width: none;
    outline: 0;
  }
  .xr::-webkit-scrollbar { display: none; }
  .xr-card {
    flex: none;
    width: clamp(260px, 26vw, 360px);
    scroll-snap-align: start;
    padding: 10px 10px var(--sp-20);
    border-radius: var(--r-tile);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.09), rgba(255, 255, 255, 0.04));
    border: 1px solid var(--x-line);
    transition: background-color var(--t-hover-out) var(--ease-out), border-color var(--t-hover-out) var(--ease-out);
  }
  .xr-card:hover { border-color: rgba(122, 150, 255, 0.5); }
  .xr-photo { position: relative; aspect-ratio: 4 / 3.4; border-radius: 24px; overflow: hidden; background: #11131b; }
  .xr-photo img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease-out-expo); }
  .xr-card:hover .xr-photo img { transform: scale(1.04); }
  .xr-cat { position: absolute; top: 12px; left: 12px; padding: 7px 12px; border-radius: var(--r-full); font-size: 0.8125rem; color: var(--color-white); }
  .xr-meta { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: var(--sp-12); padding: var(--sp-16) 10px 0; }
  .xr-title { font-size: var(--text-lead); line-height: 1.25; letter-spacing: var(--track-lead); }
  .xr-price { font-family: var(--x-font-display); font-weight: 500; font-size: 1.5rem; white-space: nowrap; }

  /* ---- Всплывающая кнопка ---- */
  .x-float {
    position: fixed;
    left: 50%;
    bottom: calc(var(--sp-20) + env(safe-area-inset-bottom));
    z-index: 40;
    translate: -50% 140%;
    opacity: 0;
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(255, 255, 255, 0.2);
    transition: translate 0.5s var(--ease-out-expo), opacity 0.3s var(--ease-out);
  }
  .x-float.is-on { translate: -50% 0; opacity: 1; }

  /* ================= Телефон ================= */
  @media (max-width: 860px) {
    .xh { min-height: 100lvh; border-radius: 0 0 var(--r-tile) var(--r-tile); }
    .xh-media { object-position: 50% 30%; }
    .xh-scrim { background: linear-gradient(to bottom, rgba(1, 2, 5, 0.5) 0%, rgba(1, 2, 5, 0) 20%), linear-gradient(to top, rgba(1, 2, 5, 0.95) 0%, rgba(1, 2, 5, 0.7) 40%, rgba(1, 2, 5, 0) 70%); }
    .xh-in { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'chips' '.' 'copy'; padding-bottom: calc(var(--sp-24) + (100lvh - 100svh)); }
    .xh-chips { justify-self: start; justify-content: flex-start; }
    .xh-chips li { padding: 8px 14px; font-size: 0.8125rem; }
    .xh-chips li:nth-child(3) { display: none; }
    .xh-display { font-size: 13vw; }
    .xh-actions { width: 100%; }
    .xh-actions .xbtn--light { width: 100%; justify-content: space-between; }
    .xh-actions .xbtn--glass { display: none; }
    .xh-note { display: none; }

    .xs-title { font-size: 11.5vw; }
    .xd-foot .xbtn { width: 100%; justify-content: space-between; }
    .xr-card { width: 78vw; }
  }
  @media (prefers-reduced-motion: reduce) {
    .xh-video { display: none; }
  }
</style>
