---
/* Страницы направлений и услуг — один шаблон, данные — data/pages.json через lib/pages.js,
   карта — docs/site-structure.md, решения и отвергнутое — docs/design-porsche.md.
   Порядок блоков (19.10.2026, третья итерация — «от задачи человека, компактнее»):
     1. первый экран по центру: крошки, H1, суть простыми словами, одна кнопка «Записаться»
        (20.10.2026: «Цена для моей машины» снята — цена и так следующим блоком);
     3. «Что это и когда нужно»: объяснение, список задач, факты крупно, фото направления;
     2. цена для машины — сразу: серая полоса, поле машины (выбранная — чёрными плашками),
        прайс по пяти классам открытой таблицей, столбец класса подсвечен (как у
        brooklandsdetailing — «тут сразу цены», 19.10.2026); у направления — карточки услуг
        и разделы без своей страницы с пояснением;
     4. «Как мы это делаем» — тёмные карточки шагов;
     5. смежные услуги (включая соседние по направлению) → вопросы → заявка → подвал без призыва.
   Колонка — --page-max 1120, расстояния между секциями вдвое меньше общих.
   Цены, тексты, вопросы и крошки — в готовом HTML; машина только меняет цены на месте. */
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Section from '../components/Section.astro';
import PriceTable from '../components/PriceTable.astro';
import PriceCard from '../components/PriceCard.astro';
import ServiceCards from '../components/ServiceCards.astro';
import LeadForm from '../components/LeadForm.astro';
import Faq from '../components/Faq.astro';
import CarCombo from '../components/CarCombo.astro';
import SiteFooter from '../components/SiteFooter.astro';
import content from '../data/content.json';
import { pageServices, pageDirections, directionSlug, classFrom, directionCells, directionMedia, siblings, pageCard } from '../lib/pages.js';
import { rub } from '../lib/catalog.js';
import { typo } from '../lib/typo.js';
import { url, asset } from '../lib/paths.js';

export function getStaticPaths() {
  return [
    ...pageDirections.filter((d) => d.slug).map((d) => ({ params: { slug: d.slug }, props: { kind: 'direction', page: d } })),
    ...pageServices.map((p) => ({ params: { slug: p.slug }, props: { kind: 'service', page: p } })),
  ];
}

const { kind, page } = Astro.props;
const { brand, contacts } = content;
const isDir = kind === 'direction';
const catId = isDir ? page.cat.id : page.cat;
const dir = pageDirections.find((d) => d.cat.id === catId);
const dirSlug = directionSlug(catId);
const media = directionMedia(catId);

/* Крошки: Главная → направление → услуга (у химчистки и PDR направление = эта страница) */
const crumbs = [{ name: 'Главная', href: url('/') }];
if (!isDir && dirSlug !== page.slug) crumbs.push({ name: dir.h1 ?? dir.cat.title, href: url(`/${dirSlug}/`) });
crumbs.push({ name: page.h1, href: url(`/${page.slug}/`) });

const from = page.from;
const cells = isDir ? directionCells(page) : classFrom(page.groups);
const fromText = from != null ? `от ${rub(from)}` : 'по запросу';
const title = `${page.h1} в Москве — цена от ${from != null ? rub(from) : 'по запросу'} | ${brand.name}`;

/* Строки прайса этой страницы: у услуги — её раздел; у направления (20.10.2026) — ВСЕ разделы
   одной таблицей подряд: сначала у которых своя страница (со ссылкой «Подробнее о разделе»),
   потом без своей. Карточки разделов с ценой «от» сняты: «почему нельзя сразу таблицу» */
const priceBlocks = isDir
  ? [
      ...page.children.map((p) => ({ id: p.slug, title: p.h1, lead: p.card ?? '', href: url(`/${p.slug}/`), groups: p.groups })),
      ...page.sections.map((s) => ({ id: s.id, title: s.title, lead: page.sectionLeads?.[s.id] ?? '', href: '', groups: s.groups })),
    ]
  : [{ id: page.section.id, title: '', lead: '', href: '', groups: page.groups }];
const tabs = isDir && priceBlocks.length > 1; // разделы направления — чипами, один на экране
const allRows = priceBlocks.flatMap((b) => b.groups.flatMap((g) => g.rows));

const facts = page.facts ?? [];
const isInt = (v) => /^\d+$/.test(v);
const nbspNum = (v) => v.replace(/\B(?=(\d{3})+(?!\d))/g, ' ');

const site = Astro.site ?? Astro.url.origin;
const abs = (path) => new URL(path, site).href;
const prices = [...allRows.flatMap((r) => r.cells.filter(Boolean).map((c) => c.value)), ...(isDir && from != null ? [from] : [])];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: page.h1,
    description: page.description,
    areaServed: { '@type': 'City', name: 'Москва' },
    provider: {
      '@type': 'AutoWash',
      name: brand.name,
      telephone: contacts.phone,
      address: { '@type': 'PostalAddress', addressLocality: 'Москва', streetAddress: contacts.address.replace(/^Москва,\s*/, '') },
    },
    ...(prices.length
      ? { offers: { '@type': 'AggregateOffer', priceCurrency: 'RUB', lowPrice: Math.min(...prices), highPrice: Math.max(...prices) } }
      : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: abs(c.href) })),
  },
  ...(page.faq?.length
    ? [{
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: page.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
      }]
    : []),
];

/* Смежные — только из ДРУГИХ направлений (20.10.2026: соседи по направлению уже есть в чипах
   разделов, «нахуя повторять»). Источник — related из pages.json: у услуги свои, затем её
   соседей; у направления — related всех его страниц. Своё направление отсекается */
const catOf = (slug) => pageServices.find((p) => p.slug === slug)?.cat ?? pageDirections.find((d) => d.slug === slug)?.cat.id;
const ownPages = isDir ? page.children : [page, ...siblings(catId).map((t) => pageServices.find((p) => p.slug === t.slug)).filter(Boolean)];
const related = [...new Set([...(isDir ? [] : page.related ?? []), ...ownPages.flatMap((p) => p.related ?? [])])]
  .filter((s) => s !== page.slug && catOf(s) !== catId)
  .slice(0, 6);
const steps = (isDir ? [] : page.steps ?? []).map((x) => (typeof x === 'string' ? { t: x, d: '' } : x));
const stepsRich = steps.some((x) => x.d);
/* Блоки пилота (20.10.2026): «Что вы получите», «Кому подходит», сравнение, уход. Есть
   данные в pages.json — блок есть; нет — страница прежняя */
const outcomes = page.outcomes ?? [];
const scenarios = page.scenarios ?? [];
const compare = page.compare
  ? { title: page.compare.title, items: page.compare.items.map((c) => ({ ...c, card: pageCard(c.slug) })).filter((c) => c.card) }
  : null;
const care = page.care ?? [];
const isPdr = catId === 'pdr';
const wa = `https://wa.me/${contacts.whatsappHref}`;
const short = page.tab ?? page.h1;
---

<Layout title={title} description={page.description} schema={schema}>
  <Header solid />

  <main class="spage">
    <!-- 1. Первый экран -->
    <Section dark reveal={false} class="spage-hero">
      <div class="hero-body">
        <nav class="crumbs" aria-label="Навигация">
          <ol>
            {crumbs.map((c, i) => (
              <li>{i < crumbs.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{typo(c.name)}</span>}</li>
            ))}
          </ol>
        </nav>
        <h1 class="hero-h1">{typo(page.h1)}</h1>
        <p class="hero-lead">{typo(page.lead)}</p>
        <!-- одна кнопка: вторая «Цена для моей машины» вела в блок цен прямо под экраном (снята 20.10.2026) -->
        <div class="hero-actions">
          {isPdr
            ? <a class="btn btn--primary" href={wa} target="_blank" rel="noopener">Прислать фото в WhatsApp</a>
            : <a class="btn btn--primary" href="#zayavka">Записаться</a>}
        </div>
      </div>
      <!-- фото на первом экране обязательно (20.10.2026); пока своих по услугам нет — фото
           направления. Оно же «отъезжает» при прокрутке -->
      {media && (
        <figure class="hero-photo" data-zoom>
          <img src={asset(media)} alt="" fetchpriority="high" decoding="async" />
        </figure>
      )}
    </Section>

    <!-- 2. Цена для машины — сразу после первого экрана, прайс открыт (как у brooklandsdetailing, 19.10.2026).
         bgLine={1}: фон белеет, едва полоса вошла в экран, — к блоку «Что это» ниже он уже белый -->
    {isDir && priceBlocks.length > 0 && (
      <Section id="cena" sheet reveal={false} bgLine={1} bgSnap class="section--solid band">
        <div class="price-head">
          <h2 class="price-title">Цена для вашей машины</h2>
          <p class="price-note" data-car-note>Цены «от». Выберите машину — покажем цены её класса.</p>
          <div class="price-car" data-page-car>
            <CarCombo id="page-car" placeholder="Марка или модель" label="Марка и модель" />
          </div>
        </div>
        <!-- Направление (20.10.2026): разделы — чипами над таблицей, на экране один раздел.
             Без скрипта видны все. Ссылка «#ceny-<раздел>» открывает свой раздел -->
        <div class="price-blocks" data-price-blocks>
        {tabs && (
          <div class="price-tabs" role="tablist" aria-label="Разделы" data-price-tabs>
            {priceBlocks.map((b, i) => (
              <button class="price-tab" type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`ceny-${b.id}`} data-tab={b.id}>{typo(b.title)}</button>
            ))}
          </div>
        )}
        {priceBlocks.map((b, i) => (
          <div class="price-block" id={isDir ? `ceny-${b.id}` : undefined} role={tabs ? 'tabpanel' : undefined} data-block={tabs ? b.id : undefined} data-active={tabs && i === 0 ? '' : undefined}>
            {b.title && !tabs && (
              <div class="price-block-head">
                <h3 class="price-block-title">{typo(b.title)}</h3>
                {b.lead && <p class="price-block-lead">{typo(b.lead)}</p>}
              </div>
            )}
            {/* одна услуга в разделе — карточка цены, а не таблица из одной строки (20.10.2026) */}
            {b.groups.flatMap((g) => g.rows).length === 1
              ? <PriceCard row={b.groups.flatMap((g) => g.rows)[0]} />
              : <div class="price-table"><PriceTable groups={b.groups} /></div>}
            {b.href && (
              <a class="price-block-more" href={b.href}>
                Подробнее о разделе «{typo(b.title)}»
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            )}
          </div>
        ))}
        <!-- внутри сетки разделов: на ПК с меню слева кнопка встаёт под таблицей по её левому
             краю, а не по центру всей полосы (20.10.2026: «плохо выглядит») -->
        <div class="price-actions">
          {isPdr
            ? <a class="btn btn--primary" href={wa} target="_blank" rel="noopener">Прислать фото в WhatsApp</a>
            : <a class="btn btn--primary" href="#zayavka">Записаться</a>}
        </div>
        </div>
      </Section>
    )}

    <!-- 2б. Что вы получите — результат для человека, а не описание технологии (пилот 20.10.2026) -->
    {outcomes.length > 0 && (
      <Section sheet reveal={false} title="Что вы получите" bgLine={isDir ? null : 1} bgSnap={!isDir}>
        <ul class="outcomes" data-reveal-group>
          {outcomes.map((o) => (
            <li class="outcome" data-reveal>
              <h3 class="outcome-title">{typo(o.t)}</h3>
              <p class="outcome-text">{typo(o.d)}</p>
            </li>
          ))}
        </ul>
      </Section>
    )}

    <!-- 2в. Кому подходит / какую выбрать — ситуации человека, своей полосой во всю ширину
         (20.10.2026: в колонке текста главный блок терялся) -->
    {scenarios.length > 0 && (
      <Section sheet reveal={false} title={page.scenariosTitle ?? 'Кому подходит'}>
        <ul class="scenarios" data-reveal-group>
          {scenarios.map((x) => (
            <li class="scenario" data-reveal>
              <p class="scenario-title">{typo(x.t)}</p>
              <p class="scenario-text">{typo(x.d)}</p>
            </li>
          ))}
        </ul>
      </Section>
    )}

    <!-- 3. Что это и когда нужно — на фоне страницы, без своего белого: ниже тёмная часть,
         и фон перетекает плавно, а не режется краем (19.10.2026) -->
    <Section sheet reveal={false}>
      <div class="intro intro--plain">
        <div class="intro-text" data-reveal-group>
          {page.about?.map((p, i) => <p class:list={['intro-p', i === 0 && 'intro-p--first']} data-reveal>{typo(p)}</p>)}
          {!scenarios.length && page.tasks?.length > 0 && (
            <div class="tasks" data-reveal>
              <h2 class="tasks-title">Когда это нужно</h2>
              <ul class="bullets tasks-list">
                {page.tasks.map((t) => <li>{typo(t)}</li>)}
              </ul>
            </div>
          )}
          {facts.length > 0 && (
            <dl class="facts">
              {facts.map((f) => (
                <div class="fact" data-reveal>
                  <dd class="fact-value">
                    <span data-count={isInt(f.v) ? f.v : undefined}>{nbspNum(f.v)}</span>
                    <span class="fact-unit">{f.u}</span>
                  </dd>
                  <dt class="fact-label">{typo(f.l)}</dt>
                </div>
              ))}
            </dl>
          )}
        </div>
      </div>
    </Section>

    <!-- 3б. Сравнение с соседней услугой: чем отличается и сколько стоит (пилот 20.10.2026) -->
    {compare && compare.items.length > 1 && (
      <Section sheet reveal={false} title={compare.title}>
        <ul class="compare" data-reveal-group>
          {compare.items.map((c) => {
            const here = c.slug === page.slug;
            return (
              <li class:list={['cmp', here && 'cmp--here']} data-reveal>
                <p class="cmp-kicker">{here ? 'Эта страница' : 'Соседняя услуга'}</p>
                <h3 class="cmp-title">{typo(c.card.title)}</h3>
                <ul class="bullets cmp-points">{c.points.map((pt) => <li>{typo(pt)}</li>)}</ul>
                <div class="cmp-foot">
                  <p class="cmp-price" data-cells={JSON.stringify(c.card.cells)}>{c.card.from != null ? `от ${rub(c.card.from)}` : 'по запросу'}</p>
                  {!here && (
                    <a class="price-block-more" href={url(`/${c.slug}/`)}>
                      Подробнее
                      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </a>
                  )}
                </div>
              </li>
            );
          })}
        </ul>
      </Section>
    )}

    <!-- 3в. Стоимость на странице услуги (20.10.2026): страница услуги — информационная, без
         поля машины наверху («на каждой странице калькулятор»). Цены по классам — здесь, после
         рассказа; выбранная раньше машина подсвечивает свой класс сама -->
    {!isDir && priceBlocks.length > 0 && (
      <Section id="cena" sheet reveal={false} title="Стоимость" class="section--solid band">
        <p class="price-lead">Цена зависит от класса машины. Знаете свою — смотрите её столбец, нет — <a href={url(`/calc/?cat=${catId}`)}>определим в калькуляторе</a>.</p>
        {priceBlocks.map((b) => (
          b.groups.flatMap((g) => g.rows).length === 1
            ? <PriceCard row={b.groups.flatMap((g) => g.rows)[0]} />
            : <div class="price-table"><PriceTable groups={b.groups} /></div>
        ))}
        <div class="price-actions price-actions--start">
          {isPdr
            ? <a class="btn btn--primary" href={wa} target="_blank" rel="noopener">Прислать фото в WhatsApp</a>
            : <a class="btn btn--primary" href="#zayavka">Записаться</a>}
        </div>
      </Section>
    )}

    <!-- 4. Как мы это делаем -->
    {steps.length > 0 && (
      <Section id="kak" dark title="Как мы это делаем">
        <ol class:list={['steps', stepsRich && 'steps--rich']} data-reveal-group>
          {steps.map((x, i) => (
            <li class="step" data-reveal>
              <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
              <div class="step-body">
                <p class="step-text">{typo(x.t)}</p>
                {x.d && <p class="step-desc">{typo(x.d)}</p>}
              </div>
            </li>
          ))}
        </ol>
        {page.stepsNote && (
          <p class="steps-note">
            {typo(page.stepsNote)}
            {page.stepsLink && <> <a href={url(`/${page.stepsLink}/`)}>Смотреть пакет →</a></>}
          </p>
        )}
      </Section>
    )}

    <!-- 4б. Как ухаживать после — что делать, чтобы результат держался (пилот 20.10.2026) -->
    {care.length > 0 && (
      <Section dark title="Как ухаживать после">
        <ul class="care" data-reveal-group>
          {care.map((c) => (
            <li class="care-item" data-reveal>
              <h3 class="care-title">{typo(c.t)}</h3>
              <p class="care-text">{typo(c.d)}</p>
            </li>
          ))}
        </ul>
      </Section>
    )}

    {page.faq?.length > 0 && (
      <Section id="faq" dark>
        <Faq title="Вопросы" items={page.faq} />
      </Section>
    )}

    {related.length > 0 && (
      <Section dark title="Смежные услуги">
        <div class="on-dark-cards"><ServiceCards slugs={related} /></div>
      </Section>
    )}

    <Section dark>
      <LeadForm title={`Записаться: ${short.toLowerCase()}`} service={page.h1} />
    </Section>
  </main>
  <SiteFooter brand={brand} cta={false} />
</Layout>

<script>
  /* Разделы направления чипами: на экране один раздел. Адрес #ceny-<раздел> открывает свой */
  const wrap = document.querySelector<HTMLElement>('[data-price-blocks]');
  const tabBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-tab]')];
  if (wrap && tabBtns.length) {
    const blocks = [...wrap.querySelectorAll<HTMLElement>('[data-block]')];
    const show = (id: string) => {
      tabBtns.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tab === id)));
      blocks.forEach((b) => b.toggleAttribute('data-active', b.dataset.block === id));
    };
    tabBtns.forEach((b) => b.addEventListener('click', () => {
      show(b.dataset.tab!);
      b.scrollIntoView({ block: 'nearest', inline: 'nearest' });
    }));
    const fromHash = () => {
      const id = location.hash.replace(/^#ceny-/, '');
      if (id !== location.hash && blocks.some((b) => b.dataset.block === id)) show(id);
    };
    fromHash();
    window.addEventListener('hashchange', fromHash);
    wrap.classList.add('price-tabs-on');
  }

  import { loadCars } from '../lib/car-index-client.js';
  import { carCombo } from '../lib/car-combo.js';
  import { storedCar, storeCar, applyCar } from '../lib/page-car.js';

  /* Машина — общая память сайта: выбрал — цены страницы меняются на месте, калькулятор её помнит */
  const box = document.querySelector<HTMLElement>('[data-page-car] [data-car-combo]');
  let car: any = storedCar();
  applyCar(car);
  const flash = () => {
    for (const el of document.querySelectorAll<HTMLElement>('[data-price]')) {
      el.classList.remove('is-updated');
      void el.offsetWidth; // перезапуск анимации
      el.classList.add('is-updated');
    }
  };
  if (box) {
    let cars: unknown = null;
    const combo = carCombo(box, {
      cars: () => cars,
      car: () => car,
      onPick: (picked: any) => {
        car = picked;
        storeCar(car);
        combo.sync();
        applyCar(car);
        flash();
      },
      missText: (q: string) => `«${q}» нет в списке — цены «от», класс уточнит менеджер`,
      onMiss: () => {
        car = null;
        storeCar(null);
        applyCar(null);
        flash();
      },
    });
    loadCars().then((index: unknown) => { cars = index; combo.ready(); }).catch(() => {});
  }

  /* «Записаться» в карточке варианта → форма вписывает услугу и встаёт в экран */
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-book]')) {
    b.addEventListener('click', () => document.dispatchEvent(new CustomEvent('lead:service', { detail: b.dataset.book })));
  }

  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* Цифры — одометр: при появлении считают от нуля, как характеристики у Porsche */
  const nf = new Intl.NumberFormat('ru-RU');
  const counters = document.querySelectorAll<HTMLElement>('[data-count]');
  if (!still && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        io.unobserve(e.target);
        const el = e.target as HTMLElement;
        const to = Number(el.dataset.count);
        const t0 = performance.now();
        const dur = 1200;
        const tick = (t: number) => {
          const k = Math.min(1, (t - t0) / dur);
          el.textContent = nf.format(Math.round(to * (1 - Math.pow(1 - k, 3))));
          if (k < 1) requestAnimationFrame(tick);
        };
        el.textContent = '0';
        requestAnimationFrame(tick);
      }
    }, { threshold: 0.6 });
    counters.forEach((el) => io.observe(el));
  }

  /* Фото «отъезжает»: въезжает крупнее и к середине экрана приходит в 1. Было 1.14 (их) —
     «слабенько», 20.10.2026 усилено до 1.3 */
  const ZOOM = 1.3;
  const photos = [...document.querySelectorAll<HTMLElement>('[data-zoom]')];
  if (!still && photos.length) {
    let ticking = false;
    const frame = () => {
      ticking = false;
      const vh = innerHeight;
      for (const p of photos) {
        const r = p.getBoundingClientRect();
        const k = Math.min(1, Math.max(0, (vh - r.top) / (vh * 0.9)));
        p.style.setProperty('--zoom', String(ZOOM - (ZOOM - 1) * k));
      }
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(frame); } }, { passive: true });
    frame();
  }
</script>

