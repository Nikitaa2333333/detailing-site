---
/* Главная. Страница только раскладывает секции и раздаёт им данные —
   вся вёрстка живёт в компонентах, стили и размеры в токенах global.css. */
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import ServiceTiles from '../components/ServiceTiles.astro';
import Calculator from '../components/Calculator.astro';
import Faq from '../components/Faq.astro';
import CalcTeaser from '../components/CalcTeaser.astro';
import SeasonPacks from '../components/SeasonPacks.astro';
import Snow from '../components/Snow.astro';
import seasonPacks from '../data/season-packs.json';
import Guarantees from '../components/Guarantees.astro';
import Reviews from '../components/Reviews.astro';
import Contacts from '../components/Contacts.astro';
import SiteFooter from '../components/SiteFooter.astro';
import content from '../data/content.json';
import { url } from '../lib/paths.js';

// Цифры, работы и форма CalcPanel временно сняты со страницы — компоненты
// Numbers/Works/CalcPanel лежат на месте, вернуть = раскомментировать секции ниже.
// Калькулятор с 16.10.2026 — на /calc/ (pages/calc.astro), здесь тизер; вернуть на главную —
// секция <Section id="calc" … sheet center><Calculator /></Section> вместо тизера.
const { services, brand, faq, guarantees, reviews } = content;
const calcHref = url('/calc/');
---

<Layout>
  <Header overlay />
  <Hero />

  <!-- Тизер калькулятора: видео-демо + поле машины → /calc/?car=… -->
  <!-- Без своего фона, как и всё ниже: цвет у страницы один, секции его не перебивают, швов
       нет (19.10.2026; свой белый у тизера давал серую полосу перед плашками при быстрой
       прокрутке). bgLine={1} + bgSnap: едва тизер вошёл в экран, фон становится белым сразу,
       без перетекания — как раньше со своим фоном; плавная смена остаётся дальше, при уходе
       в тёмную часть -->
  <Section id="calc-teaser" sheet bgLine={1} bgSnap class="section--flush-bottom">
    <CalcTeaser />
  </Section>

  <!-- Услуги — на фоне страницы; переход к зимним пакетам — цветом всего экрана, как у porsche.com -->
  <Section id="services" title={services.title} sheet reveal={false}>
    <!-- призыв «Не знаете, с чего начать?» снят 16.10.2026: повторял тизер калькулятора -->
    <ServiceTiles more={services.more} href={calcHref} />
  </Section>

  <!-- Сезонные пакеты (осень — зима): данные и суммы — season-packs.json + прайс -->
  <!-- Снег (Snow.astro) — фоном секции зимних пакетов (снимали 16.10, вернули 19.10.2026) -->
  <!-- 19.10.2026: светлые — только тизер и плашки после первого экрана, дальше всё тёмное -->
  <Section id="season" dark label={seasonPacks.season.label} title={seasonPacks.season.title} class="has-snow">
    <Snow slot="bg" />
    <SeasonPacks href={calcHref} />
    <!-- передний снег — поверх карточек, только по краям блока -->
    <Snow layer="front" />
  </Section>

  <!-- Гарантии — нумерованный список под линиями (20.10.2026), заголовок слева -->
  <Section id="guarantees" title={guarantees.title} dark>
    <Guarantees items={guarantees.items} />
  </Section>

  <!-- Отзывы — огромный заголовок-переход (их «Your Porsche journey starts now.») -->
  <Section id="reviews" title={reviews.title} dark huge>
    <Reviews />
  </Section>

  <!-- Карта — перед вопросами (16.10.2026): крупный блок, вопросы уже добивают сомнения -->
  <Section id="contacts" dark>
    <Contacts />
  </Section>

  <!-- Вопросы — обратно на тёмное плавным переходом с белого -->
  <Section id="faq" dark>
    <Faq title={faq.title} items={faq.items} />
  </Section>

  <SiteFooter brand={brand} contacts={false} />
</Layout>
