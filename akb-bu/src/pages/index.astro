---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import content from '../data/content.json';
import { categories, rub, plural } from '../lib/catalog.js';

const { services, numbers, works, calc, contacts, brand, hero } = content;
---

<Layout>
  <Header />
  <Hero />

  <!-- Услуги — тёмная полоса; плашка с фото занимает 2×2, по наведению показывает список услуг -->
  <section class="section section--dark on-dark" id="services">
    <div class="container">
      <div class="section-head section-head--plain" data-reveal>
        <h2 class="section-title">{services.title}</h2>
      </div>

      <div class="tiles" data-reveal-group>
        {categories.map((c) => (
          <article
            class={`tile${c.media ? ' tile--media' : ''}${c.wide ? ' tile--wide' : ''}`}
            id={`cat-${c.id}`}
            data-tile
            data-reveal
          >
            {c.media && <img class="tile-bg" src={c.media} alt="" loading="lazy" />}
            <div class="tile-front">
              <div class="tile-top">
                <span class="chip">{c.tag}</span>
                <span class="tile-count">{c.count} {plural(c.count)}</span>
              </div>
              <div class="tile-headline">
                <h3 class="tile-title">{c.title}</h3>
                <p class="tile-price">от {rub(c.from)}</p>
              </div>
            </div>
            <div class="tile-back">
              <p class="tile-back-title">{c.title}</p>
              <ul class="tile-list">
                {c.items.map((s) => (
                  <li>
                    <span class="tile-item-name">{s.title}</span>
                    <span class="tile-item-price">от {rub(s.from)}</span>
                  </li>
                ))}
              </ul>
              <a class="tile-more" href="#contacts">
                {services.more}
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </article>
        ))}

        <a class="tile tile--cta" href="#contacts" data-reveal>
          <div class="tile-front">
            <h3 class="tile-title">{services.cta.title}</h3>
            <p class="tile-cta-text">{services.cta.text}</p>
            <span class="btn btn--primary">{services.cta.button}</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Цифры — одна строка, крупно -->
  <section class="section">
    <div class="container">
      <dl class="numbers" data-reveal-group>
        {numbers.map((n) => (
          <div class="number" data-reveal>
            <dt class="number-value">{n.value}</dt>
            <dd class="number-label">{n.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Работы — крупные фото. Пока плейсхолдеры под рендеры -->
  <section class="section" id="works">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="section-label">{works.label}</p>
        <h2 class="section-title">{works.title}</h2>
      </div>
      <div class="works" data-reveal-group>
        {works.items.map((w, i) => (
          <figure class={`work${w.wide ? ' work--wide' : ''}`} data-reveal>
            <div class={`work-media${i === 0 ? ' work-media--dark' : ''}`}>
              {i === 0 && <img src={hero.media} alt="" loading="lazy" />}
            </div>
            <figcaption class="work-caption">
              <span>{w.caption}</span>
              <span class="work-car">{w.car}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Расчёт стоимости — тёмная плашка со световой текстурой -->
  <section class="section" id="contacts">
    <div class="container">
      <div class="dark-panel calc" data-reveal>
        <img class="calc-bg" src={hero.media} alt="" loading="lazy" />
        <div class="calc-inner">
          <p class="section-label">{calc.label}</p>
          <h2 class="calc-title">{calc.title}</h2>
          <form class="calc-form">
            <div class="calc-row">
              <input class="field" type="tel" name="phone" placeholder="+7 (___) ___-__-__" required />
              <button class="btn btn--primary" type="submit">{calc.button}</button>
            </div>
            <label class="consent">
              <input type="checkbox" name="consent" required />
              <span>{calc.consent}</span>
            </label>
          </form>
          <div class="calc-contacts">
            <a href={`tel:${contacts.phoneHref}`}>{contacts.phone}</a>
            <a href={`https://wa.me/${contacts.whatsappHref}`}>WhatsApp</a>
            <a href={`https://t.me/${contacts.telegram}`}>Telegram</a>
            <span>{contacts.hours}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <footer class="footer">
    <div class="container footer-inner">
      <a class="logo" href="/">{brand.logo}<span class="logo-accent">{brand.logoAccent}</span></a>
      <span class="footer-legal">© 2026 {brand.name}</span>
    </div>
  </footer>
</Layout>

<style>
  /* Плашки услуг: 3 колонки, квадраты. Плашка с фото — в ширину на две колонки: итого ровно 3 ряда по 3 */
  .tiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-12);
  }
  .tile {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1;
    border-radius: var(--r-tile);
    background: var(--color-tile-dark);
    color: var(--color-white);
    /* переход из меню: якорь не должен уезжать под фиксированную шапку */
    scroll-margin-top: calc(var(--header-h) + var(--sp-24));
  }
  .tile--wide { grid-column: span 2; aspect-ratio: auto; }
  .tile-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tile-front {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--sp-20);
  }
  .tile-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--sp-8);
  }
  .tile-count { font-size: var(--text-caption); font-weight: var(--w-medium); }
  .tile-headline { display: grid; gap: var(--sp-8); }
  .tile-title {
    font-size: var(--text-tile);
    max-width: 10ch;
  }
  /* Цена «от» — витринный ярлык, а не наборный текст: отсюда вес и табличные цифры */
  .tile-price {
    font-size: var(--text-body-lg);
    font-weight: var(--w-medium);
    font-variant-numeric: tabular-nums;
  }
  .tile--media .tile-title,
  .tile--media .tile-price { text-shadow: 0 1px 24px rgba(0, 0, 0, 0.4); }

  /* Оборот плашки — тёмная панель своего оттенка, чтобы не сливалась с полосой. Без трансформов:
     просто кроссфейд, чтобы кромка второго слоя не просвечивала на скруглённых углах */
  .tile-back {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--sp-20);
    background: var(--color-tile-back);
    color: var(--color-white);
    opacity: 0;
    transition: opacity 0.2s var(--ease-out);
  }
  /* На обороте лицо плашки скрыто — название категории повторяем меткой.
     Список идёт сразу под ней, ссылка прижата к низу */
  .tile-back { justify-content: flex-start; }
  .tile-back-title {
    font-size: var(--text-caption);
    font-weight: var(--w-medium);
    margin-bottom: var(--sp-20);
  }
  .tile-back .tile-more { margin-top: auto; padding-top: var(--sp-20); }
  /* Раскрытие: наведение, фокус внутри (клавиатура) и клик из меню — .is-open */
  .tile:hover .tile-back,
  .tile:focus-within .tile-back,
  .tile.is-open .tile-back { opacity: 1; }
  .tile-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-12);
    align-content: start;
  }
  /* Строка мини-прайса: название слева, цена справа. Разделительных линий нет */
  .tile-list li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-16);
  }
  .tile-item-name { line-height: 1.2; }
  .tile-item-price {
    flex: none;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .tile--wide .tile-list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-12) var(--sp-48);
  }
  .tile--wide .tile-list li { font-size: var(--text-body-lg); }
  .tile-more {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-8);
    font-size: var(--text-caption);
    font-weight: var(--w-medium);
  }
  .tile-more svg { width: 14px; height: 14px; }

  /* Призыв — последняя плашка, тёмная, с янтарным свечением «искр» из hero в углу.
     В ширину на две колонки: 6 категорий + широкий «Уход» + она = ровно 3 ряда по 3 */
  .tile--cta {
    position: relative;
    overflow: hidden;
    grid-column: span 2;
    aspect-ratio: auto;
    background: var(--color-tile-dark);
    color: var(--color-white);
  }
  .tile--cta::before {
    content: '';
    position: absolute;
    inset: -30%;
    background: radial-gradient(circle at 75% 15%, var(--color-orange) 0%, var(--color-ember) 32%, transparent 65%);
    opacity: 0.55;
    filter: blur(60px);
    pointer-events: none;
  }
  .tile--cta .tile-front { position: relative; z-index: 1; justify-content: flex-end; gap: var(--sp-16); align-items: flex-start; }
  .tile--cta .tile-title { max-width: 14ch; }
  .tile-cta-text { max-width: 30ch; color: var(--color-grey-text-dark); }
  .tile--cta .btn--primary { background: var(--color-white); color: var(--color-ink); }
  .tile--cta .btn--primary:hover { background: var(--color-tile); }

  /* Цифры */
  .numbers {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--sp-24);
    margin: 0;
  }
  .number { margin: 0; }
  .number-value {
    font-size: var(--text-stat);
    font-weight: var(--w-semibold);
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .number-label {
    margin: var(--sp-8) 0 0;
    font-size: var(--text-caption);
    font-weight: var(--w-medium);
  }

  /* Работы */
  .works {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-12);
  }
  .work { margin: 0; }
  .work--wide { grid-column: span 2; }
  .work-media {
    aspect-ratio: 4 / 3;
    border-radius: var(--r-tile);
    background: var(--color-tile);
    overflow: hidden;
  }
  .work--wide .work-media { aspect-ratio: 8 / 3; }
  .work-media--dark { background: var(--color-ink); }
  .work-media img { width: 100%; height: 100%; object-fit: cover; }
  .work-caption {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-16);
    padding-top: var(--sp-12);
    font-size: var(--text-caption);
    font-weight: var(--w-medium);
  }
  .work-car { white-space: nowrap; }

  /* Расчёт */
  .calc { padding: clamp(28px, 5vw, 72px); }
  .calc-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right top;
  }
  .calc-inner {
    position: relative;
    display: grid;
    gap: var(--sp-24);
    justify-items: start;
    max-width: 640px;
  }
  .calc-title {
    font-size: var(--text-heading);
    max-width: 22ch;
  }
  .calc-form { display: grid; gap: var(--sp-16); width: 100%; }
  .calc-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--sp-8);
  }
  .consent {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-12);
    font-size: var(--text-caption);
    cursor: pointer;
    max-width: 48ch;
  }
  .consent input {
    appearance: none;
    flex: none;
    width: 18px;
    height: 18px;
    margin: 1px 0 0;
    border-radius: 50%;
    border: 1.5px solid rgba(255, 255, 255, 0.6);
    display: grid;
    place-content: center;
    cursor: pointer;
  }
  .consent input::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-white);
    transform: scale(0);
    transition: transform 0.15s var(--ease-out);
  }
  .consent input:checked::before { transform: scale(1); }
  .calc-contacts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-8) var(--sp-24);
    font-size: var(--text-caption);
    font-weight: var(--w-medium);
    padding-top: var(--sp-16);
  }
  .calc-contacts a:hover { text-decoration: underline; text-underline-offset: 3px; }

  /* Футер */
  .footer { padding-block: var(--sp-32); }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--sp-16);
    border-top: 1px solid var(--color-line-ink);
    padding-top: var(--sp-24);
    font-size: var(--text-caption);
  }
  .logo { font-weight: var(--w-bold); letter-spacing: 0.02em; }
  .logo-accent { font-weight: var(--w-regular); }

  @media (max-width: 1100px) {
    .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    /* Две колонки: широкий «Уход» и призыв занимают ряд целиком, остальные — парами */
    .tile--wide .tile-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .numbers { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--sp-32) var(--sp-24); }
  }
  @media (max-width: 860px) {
    .works { grid-template-columns: 1fr; }
    .work--wide { grid-column: auto; }
    .work--wide .work-media { aspect-ratio: 4 / 3; }
    .calc-row { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .tiles { grid-template-columns: 1fr; }
    .tile, .tile--wide, .tile--cta { grid-column: auto; aspect-ratio: 5 / 4; }
    /* Узкая колонка: мини-прайс в обороте — одна колонка и базовый кегль */
    .tile--wide .tile-list { grid-template-columns: 1fr; }
    .tile--wide .tile-list li { font-size: var(--text-body); }
  }
</style>
