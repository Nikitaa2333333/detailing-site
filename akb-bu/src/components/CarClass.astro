---
/* Виджет «Определить класс вашего авто»: марка → модель → класс.

   Два связанных поля с поиском по первым буквам — прямое требование заказчика
   (в референсе поиска нет, и в списке на 60 брендов пользователь тонет).
   После выбора модели подсвечивается нужный столбец прайса: виджет ставит
   data-active на блок с таблицей, дальше всё решает CSS.

   Справочник приходит из prices.json (лист «Классификация машин»), руками
   марки и классы не вписываются. */
import { classes } from '../lib/services.js';

/* Бренд встречается в нескольких классах — собираем одну запись на бренд */
const index = new Map();
for (const cls of classes) {
  for (const { brand, models } of cls.brands) {
    const key = brand.trim();
    if (!index.has(key)) index.set(key, []);
    for (const model of models) {
      index.get(key).push({ model: model.trim(), cls: cls.id, label: cls.label });
    }
  }
}
const brands = [...index.entries()]
  .map(([brand, models]) => ({ brand, models }))
  .sort((a, b) => a.brand.localeCompare(b.brand, 'ru'));

const { target = 'price' } = Astro.props;
---

<div class="widget dark-panel" data-class-widget data-target={target}>
  <div class="widget-head">
    <h3 class="widget-title">Определите класс вашего автомобиля</h3>
    <p class="widget-text">Цена в прайсе зависит от класса. Выберите марку и модель — подсветим нужный столбец.</p>
  </div>

  <div class="widget-fields">
    <div class="combo" data-combo="brand">
      <label class="combo-label" for="class-brand">Марка</label>
      <input
        class="field combo-input"
        id="class-brand"
        type="text"
        autocomplete="off"
        role="combobox"
        aria-expanded="false"
        aria-controls="class-brand-list"
        placeholder="Начните вводить: BMW, Kia…"
      />
      <ul class="combo-list" id="class-brand-list" role="listbox" hidden></ul>
    </div>

    <div class="combo" data-combo="model">
      <label class="combo-label" for="class-model">Модель</label>
      <input
        class="field combo-input"
        id="class-model"
        type="text"
        autocomplete="off"
        role="combobox"
        aria-expanded="false"
        aria-controls="class-model-list"
        placeholder="Сначала выберите марку"
        disabled
      />
      <ul class="combo-list" id="class-model-list" role="listbox" hidden></ul>
    </div>

    <div class="widget-result" data-result hidden>
      <p class="result-label">Ваш класс</p>
      <p class="result-value" data-result-value></p>
      <button class="btn btn--ghost widget-reset" type="button" data-reset>Выбрать другой</button>
    </div>
  </div>

  <p class="widget-note">
    Не нашли модель в списке — <a href="#contacts">оставьте номер</a>, назовём класс и цену по телефону.
  </p>

  <script type="application/json" data-class-index set:html={JSON.stringify(brands)} />
</div>

<script>
  document.querySelectorAll('[data-class-widget]').forEach((widget) => {
    const data = JSON.parse(widget.querySelector('[data-class-index]').textContent);
    const price = document.getElementById(widget.dataset.target);
    const result = widget.querySelector('[data-result]');
    const resultValue = widget.querySelector('[data-result-value]');

    const combo = (name) => {
      const root = widget.querySelector(`[data-combo="${name}"]`);
      return { root, input: root.querySelector('input'), list: root.querySelector('.combo-list') };
    };
    const brand = combo('brand');
    const model = combo('model');

    let current = null; // выбранный бренд
    let items = []; // что сейчас в открытом списке
    let active = -1; // подсвеченный пункт для стрелок

    const close = (c) => {
      c.list.hidden = true;
      c.input.setAttribute('aria-expanded', 'false');
      active = -1;
    };

    /* Поиск по первым буквам: сначала совпадения с начала строки, потом вхождения */
    const match = (list, query, key) => {
      const q = query.trim().toLowerCase();
      if (!q) return list.slice(0, 40);
      const starts = [];
      const inside = [];
      for (const item of list) {
        const value = String(item[key]).toLowerCase();
        if (value.startsWith(q)) starts.push(item);
        else if (value.includes(q)) inside.push(item);
      }
      return [...starts, ...inside].slice(0, 40);
    };

    const render = (c, list, key, onPick) => {
      items = list;
      c.list.innerHTML = '';
      if (!list.length) {
        const li = document.createElement('li');
        li.className = 'combo-empty';
        li.textContent = 'Ничего не нашли';
        c.list.append(li);
      }
      list.forEach((item, i) => {
        const li = document.createElement('li');
        li.className = 'combo-option';
        li.setAttribute('role', 'option');
        li.textContent = item[key];
        li.addEventListener('mousedown', (e) => {
          e.preventDefault(); // не даём полю потерять фокус раньше выбора
          onPick(item);
        });
        li.dataset.i = String(i);
        c.list.append(li);
      });
      c.list.hidden = false;
      c.input.setAttribute('aria-expanded', 'true');
    };

    const highlight = (c) => {
      c.list.querySelectorAll('.combo-option').forEach((el, i) => {
        el.classList.toggle('is-active', i === active);
      });
    };

    const pickBrand = (item) => {
      current = item;
      brand.input.value = item.brand;
      close(brand);
      model.input.disabled = false;
      model.input.value = '';
      model.input.placeholder = 'Начните вводить модель';
      model.input.focus();
      render(model, match(item.models, '', 'model'), 'model', pickModel);
    };

    const pickModel = (item) => {
      model.input.value = item.model;
      close(model);
      resultValue.textContent = item.label;
      result.hidden = false;
      if (price) price.dataset.active = item.cls;
      // Цель Метрики «использование виджета класса» подключится к этому событию
      document.dispatchEvent(
        new CustomEvent('carclass:selected', {
          detail: { brand: current.brand, model: item.model, cls: item.cls },
        })
      );
    };

    brand.input.addEventListener('input', () => {
      render(brand, match(data, brand.input.value, 'brand'), 'brand', pickBrand);
    });
    brand.input.addEventListener('focus', () => {
      render(brand, match(data, brand.input.value, 'brand'), 'brand', pickBrand);
    });
    model.input.addEventListener('input', () => {
      if (!current) return;
      render(model, match(current.models, model.input.value, 'model'), 'model', pickModel);
    });
    model.input.addEventListener('focus', () => {
      if (!current) return;
      render(model, match(current.models, model.input.value, 'model'), 'model', pickModel);
    });

    // Стрелки и Enter — список должен работать без мыши
    [brand, model].forEach((c) => {
      c.input.addEventListener('keydown', (e) => {
        if (c.list.hidden) return;
        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
          e.preventDefault();
          active = Math.max(0, Math.min(items.length - 1, active + (e.key === 'ArrowDown' ? 1 : -1)));
          highlight(c);
        } else if (e.key === 'Enter' && active >= 0) {
          e.preventDefault();
          c.list.querySelectorAll('.combo-option')[active]?.dispatchEvent(new MouseEvent('mousedown'));
        } else if (e.key === 'Escape') {
          close(c);
        }
      });
      c.input.addEventListener('blur', () => close(c));
    });

    widget.querySelector('[data-reset]').addEventListener('click', () => {
      current = null;
      brand.input.value = '';
      model.input.value = '';
      model.input.disabled = true;
      model.input.placeholder = 'Сначала выберите марку';
      result.hidden = true;
      if (price) delete price.dataset.active;
      brand.input.focus();
    });
  });
</script>

<style>
  .widget {
    padding: var(--sp-32) var(--sp-40);
    display: grid;
    gap: var(--sp-24);
  }
  .widget-head { display: grid; gap: var(--sp-8); }
  .widget-title { font-size: var(--text-body-lg); }
  .widget-text { max-width: var(--measure-text); }

  /* Два поля и результат в одну строку; на узком экране — друг под другом */
  .widget-fields {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
    gap: var(--sp-16);
    align-items: end;
  }
  .combo { position: relative; display: grid; gap: var(--sp-8); }
  .combo-label { font-size: var(--text-caption); font-weight: var(--w-medium); }
  .combo-input:disabled { cursor: not-allowed; }

  /* Выпадающий список — поверх прайса, со своей прокруткой */
  .combo-list {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 5;
    margin: var(--sp-4) 0 0;
    padding: var(--sp-8);
    list-style: none;
    max-height: 280px;
    overflow-y: auto;
    background: var(--color-tile-dark);
    border-radius: var(--r-input);
    display: grid;
    gap: 2px;
  }
  .combo-option {
    padding: 8px var(--sp-12);
    border-radius: var(--r-row);
    cursor: pointer;
    transition: background-color var(--t-hover-out) var(--ease-out);
  }
  .combo-option:hover,
  .combo-option.is-active {
    background: var(--color-row-hover-dark);
    transition-duration: var(--t-hover-in);
  }
  .combo-empty { padding: 8px var(--sp-12); }

  .widget-result {
    display: grid;
    gap: var(--sp-4);
    justify-items: start;
    align-content: end;
    padding-left: var(--sp-16);
  }
  .result-label { font-size: var(--text-caption); }
  .result-value { font-size: var(--text-body-lg); font-weight: var(--w-semibold); }
  .widget-reset { margin-top: var(--sp-8); padding: 8px 16px; font-size: var(--text-caption); }

  .widget-note { font-size: var(--text-caption); }
  .widget-note a { text-decoration: underline; text-underline-offset: 3px; }

  @media (max-width: 860px) {
    .widget { padding: var(--sp-24); }
    .widget-fields { grid-template-columns: 1fr; }
    .widget-result { padding-left: 0; }
  }
</style>
