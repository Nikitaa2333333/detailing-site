---
/* Секция страницы: полоса + контейнер + швейцарская шапка «метка слева, заголовок справа».
   Все страницы собираются из неё — ритм между секциями задаёт --section-gap в global.css,
   в самих секциях отступов сверху и снизу не ставим.

   <Section label="Работы" title="…">   — с меткой
   <Section title="…">                  — заголовок по левому краю
   <Section>                            — без шапки, только контент
   dark      — тёмная полоса во всю ширину, белый текст
   sheet     — светлый лист со скруглёнными углами на тёмной основе
   flushTop  — прижать к предыдущей секции (убрать верхний отступ)
   center    — заголовок без метки, по центру над блоком (калькулятор)
   reveal    — появление шапки при прокрутке; false — секция стоит на месте сразу */
const {
  id,
  label,
  title,
  dark = false,
  sheet = false,
  flushTop = false,
  center = false,
  reveal = true,
  class: klass = '',
} = Astro.props;
---

<section
  id={id}
  class:list={[
    'section',
    dark && 'section--dark',
    dark && 'on-dark',
    sheet && 'section--sheet',
    flushTop && 'section--flush-top',
    klass,
  ]}
>
  <slot name="bg" />
  <div class="container">
    {title && (
      <div class:list={['section-head', !label && 'section-head--plain', center && 'section-head--center']} data-reveal={reveal || undefined}>
        {label && <p class="section-label">{label}</p>}
        <h2 class="section-title">{title}</h2>
      </div>
    )}
    <slot />
  </div>
</section>
