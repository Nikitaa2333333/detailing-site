---
/* Поле выбора машины — одно на весь сайт: калькулятор и виджет класса на страницах услуг.

   Одно поле вместо пары «Марка / Модель»: люди пишут «крузак», не вспоминая марку.
   Но путь «марка → модель» тоже есть (прямое требование заказчика): пустое поле
   показывает марки, клик по марке — рядом с полем плашка марки, и поле ищет только
   её модели. Выбранная машина — две плашки «BMW | X5», каждая меняется кликом.

   Поведение — lib/car-combo.js (подключает родитель: у него своё «что делать с машиной»).
   Цвета — переменные --combo-* ниже; родитель переопределяет их под свой фон. */
interface Props {
  id: string;
  placeholder: string;
  label: string; // для скринридера: у поля нет видимой подписи
}
const { id, placeholder, label } = Astro.props;
---

<div class="combo" data-car-combo>
  <button class="combo-plate" type="button" hidden data-car-brand aria-label="Сменить марку">
    <span class="combo-plate-label">Марка</span>
    <span class="combo-plate-value" data-car-brand-name></span>
    <svg class="combo-plate-edit" viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 8 4.5 4.5L14.5 8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <div class="combo-field" data-car-field>
    <svg class="combo-icon" viewBox="0 0 20 20" aria-hidden="true">
      <circle cx="9" cy="9" r="6" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
      <path d="m13.5 13.5 4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
    </svg>
    <input
      class="field combo-input"
      id={id}
      type="text"
      autocomplete="off"
      autocorrect="off"
      autocapitalize="off"
      spellcheck="false"
      enterkeyhint="done"
      role="combobox"
      aria-expanded="false"
      aria-controls={`${id}-list`}
      aria-label={label}
      placeholder={placeholder}
      data-car-input
    />
  </div>
  <!-- крестик — только в полноэкранном режиме на телефоне -->
  <button class="combo-close" type="button" data-car-close aria-label="Закрыть выбор машины">
    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
  </button>
  <button class="combo-plate combo-plate--model" type="button" hidden data-car-model aria-label="Сменить модель">
    <span class="combo-plate-label">Модель</span>
    <span class="combo-plate-value"><span data-car-model-name></span><span class="combo-class" data-car-model-class></span></span>
    <svg class="combo-plate-edit" viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 8 4.5 4.5L14.5 8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <ul class="combo-list" id={`${id}-list`} role="listbox" hidden data-car-list></ul>
</div>

<style>
  /* Цвета поля. По умолчанию — светлый фон; тёмный родитель задаёт свои значения */
  .combo {
    --combo-fg: var(--color-ink);
    --combo-field: var(--color-page);             /* поле и плашки */
    --combo-field-hover: var(--color-tile);
    --combo-pop: var(--color-white);              /* выпадающий список */
    --combo-hover: var(--color-row-hover-light);  /* строка списка под курсором */
    --combo-line: var(--color-line-ink);          /* обводка списка */
    --combo-sel-bg: var(--color-ink);             /* плашки выбранной машины — цвет «выбрано» */
    --combo-sel-fg: var(--color-white);
    --combo-sel-hover: var(--color-ink-hover);

    position: relative;
    max-width: 720px;
    display: flex;
    gap: var(--sp-8);
  }
  .combo-field { position: relative; flex: 1; min-width: 0; }
  .combo-field[hidden], .combo-plate[hidden] { display: none; }
  .combo-icon {
    position: absolute;
    left: 22px;
    top: 50%;
    width: 20px;
    height: 20px;
    translate: 0 -50%;
    color: var(--combo-fg);
    pointer-events: none;
  }
  .combo-input {
    padding: 20px 24px 20px 56px;
    font-size: var(--text-body-lg);
    background: var(--combo-field);
    color: var(--combo-fg);
  }
  .combo-input:focus { border-color: var(--combo-fg); }

  /* плашки марки и модели — того же размера и формы, что поле. Внутри только значение:
     подписи «Марка» / «Модель» не нужны, «BMW | X5» читается само (подпись — для скринридера) */
  /* 20.10.2026 («плашки должны вызывать желание кликнуть», «сделать больше»): крупнее кнопки —
     64px, текст 20; стрелка вниз справа — знак «нажми, чтобы сменить», как у выпадающего списка */
  .combo-plate {
    display: flex;
    align-items: center;
    gap: var(--sp-8);
    flex: none;
    max-width: 45%;
    min-height: 64px;
    padding: 12px 18px 12px 26px;
    border: 1.5px solid transparent;
    border-radius: var(--r-pill);
    /* выбранное — инверсией, как отмеченная услуга и плитка: сразу видно, что машина выбрана */
    background: var(--combo-sel-bg);
    color: var(--combo-sel-fg);
    text-align: left;
    cursor: pointer;
    transition: background-color var(--t-hover-out) var(--ease-out);
    animation: combo-plate-in 0.32s var(--ease-out);
  }
  .combo-plate:hover { background: var(--combo-sel-hover); transition-duration: var(--t-hover-in); }
  .combo-plate-edit { flex: none; width: 22px; height: 22px; opacity: 0.85; transition: transform 0.25s var(--ease-porsche); }
  .combo-plate:hover .combo-plate-edit { transform: translateY(2px); }
  .combo-plate:focus-visible { outline: 2px solid var(--combo-fg); outline-offset: 2px; }
  /* плашка появляется, а не подменяет поле мгновенно (анимация срабатывает при каждом показе) */
  @keyframes combo-plate-in {
    from { opacity: 0; transform: scale(0.96); }
  }
  @media (prefers-reduced-motion: reduce) {
    .combo-plate { animation: none; }
  }
  /* модель — по содержимому, класс сразу за названием. Не влезает рядом с маркой — уходит
     целиком на вторую строку, а не режется («Continental GT · цена после осмотра») */
  .combo:has(.combo-field[hidden]) { flex-wrap: wrap; }
  .combo-plate--model { flex: 0 1 auto; min-width: 0; max-width: 100%; }
  .combo-plate--model .combo-plate-value { overflow: visible; }
  .combo-plate--model [data-car-model-name] { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .combo-plate-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .combo-plate-value {
    min-width: 0;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--sp-12);
    font-size: var(--text-lead);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .combo-plate .combo-class { flex: none; font-size: var(--text-caption); font-weight: var(--w-medium); }

  /* Выпадающий список — поверх соседей, со своей прокруткой */
  .combo-list {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 20;
    margin: var(--sp-8) 0 0;
    padding: var(--sp-8);
    list-style: none;
    display: grid;
    /* строка всегда по содержимому: у ячеек марки overflow: hidden (многоточие), и Safari
       иначе сжимает такие строки в ноль, когда список не помещается по высоте */
    grid-auto-rows: max-content;
    gap: 2px;
    max-height: 360px;
    overflow-y: auto;
    background: var(--combo-pop);
    color: var(--combo-fg);
    border-radius: var(--r-input);
    box-shadow: 0 0 0 1px var(--combo-line), 0 16px 40px rgba(10, 10, 11, 0.12);
  }
  /* display: grid перебивает атрибут hidden */
  .combo-list[hidden] { display: none; }

  /* Строки создаёт скрипт — scoped-стили до них не доходят, поэтому :global */
  .combo-list :global(.combo-option) {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--sp-12);
    padding: 10px var(--sp-16);
    border-radius: var(--r-row);
    cursor: pointer;
    transition: background-color var(--t-hover-out) var(--ease-out);
  }
  .combo-list :global(.combo-option:hover),
  .combo-list :global(.combo-option.is-active) { background: var(--combo-hover); transition-duration: var(--t-hover-in); }
  /* набранное в названии модели — весом, как в каталогах auto.ru и drom (служебный список, не наборный текст) */
  .combo-list :global(.combo-hit) { font-weight: var(--w-semibold); }
  /* класс модели — мелко, в серой капсуле (19.10.2026); на подсвеченной строке капсула белая */
  .combo-list :global(.combo-class) {
    flex: none;
    align-self: center;
    padding: 1px 8px;
    border-radius: var(--r-full);
    background: var(--color-tile);
    font-size: 0.6875rem;   /* 11 — мельче подписи, служебная метка */
    font-weight: var(--w-regular);
    letter-spacing: 0;
    line-height: 1.6;
  }
  .combo-list :global(.combo-option:hover .combo-class),
  .combo-list :global(.combo-option.is-active .combo-class) { background: var(--combo-pop); }
  /* годы выпуска — мелкой подписью после названия, как в каталогах auto.ru и drom */
  .combo-list :global(.combo-era) { margin-left: var(--sp-8); font-size: var(--text-caption); white-space: nowrap; }
  /* «не нашли» — одна фраза на всю ширину, без колонки класса */
  .combo-list :global(.combo-miss) { display: block; }
  /* заголовок марки над её моделями — крупнее строк моделей, чтобы группы читались блоками
     (как у auto.ru и drom); не капс */
  .combo-list :global(.combo-head) {
    padding: var(--sp-20) var(--sp-16) var(--sp-8);
    font-size: var(--text-subhead);
    font-weight: var(--w-semibold);
    line-height: 1.2;
  }
  .combo-list :global(.combo-head:first-child) { padding-top: var(--sp-8); }
  /* пустое поле — популярные марки колонками, заголовок во всю ширину */
  .combo-list.is-brands { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .combo-list.is-brands :global(.combo-head),
  .combo-list.is-brands :global(.combo-more) { grid-column: 1 / -1; }
  .combo-list.is-brands :global(.combo-more) { margin-top: var(--sp-8); }
  .combo-list :global(.combo-brand) { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .combo-list :global(.combo-more) { display: block; font-weight: var(--w-medium); text-decoration: underline; text-underline-offset: 3px; }

  /* крестик живёт только в окне выбора (.is-sheet, ниже) */
  .combo-close { display: none; }

  /* Окно выбора машины (19.10.2026: выпадающий список врезался в страницу — «модалькой»).
     Фокус в поле открывает окно: на десктопе — по центру экрана поверх затемнённой страницы,
     на телефоне — на весь экран (ниже). Класс .is-sheet ставит скрипт. Сверху плашка марки,
     поле и крестик, ниже список на всю оставшуюся высоту со своей прокруткой.
     Страница за окном не крутится; клик мимо окна и Esc закрывают его */
  .combo.is-sheet {
    position: fixed;
    z-index: 200; /* выше липкой шапки (100) */
    top: 12vh;
    left: 50%;
    translate: -50% 0;
    width: min(760px, calc(100vw - 2 * var(--gutter)));
    height: min(640px, 76vh);
    max-width: none;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-rows: auto minmax(0, 1fr);
    align-content: start;
    column-gap: var(--sp-8);
    row-gap: var(--sp-12);
    padding: var(--sp-16) var(--sp-16) 0;
    background: var(--combo-pop);
    border-radius: var(--r-panel);
    /* затемнение страницы — тенью окна во весь экран, без отдельного слоя */
    box-shadow: 0 0 0 100vmax rgba(1, 2, 5, 0.55), 0 24px 64px rgba(1, 2, 5, 0.3);
    color: var(--combo-fg);
    text-align: left;
    overflow: hidden;   /* углы списка не торчат за скругление окна */
    animation: combo-sheet-in 0.28s var(--ease-out);
  }
  @keyframes combo-sheet-in {
    from { opacity: 0; transform: translateY(12px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .combo.is-sheet { animation: none; }
  }
  /* ширина — по названию марки: проценты в колонке auto не считаются, и плашка схлопывалась
     в пустой овал. Длинную марку ограничиваем долей окна — дальше многоточие */
  .combo.is-sheet .combo-plate { grid-row: 1; grid-column: 1; width: max-content; max-width: min(45vw, 280px); }
  .combo.is-sheet .combo-field { grid-row: 1; grid-column: 2; }
  /* марка не выбрана — поле занимает и её место */
  .combo.is-sheet .combo-plate[hidden] + .combo-field { grid-column: 1 / 3; }
  .combo.is-sheet .combo-close {
    display: grid;
    place-items: center;
    grid-row: 1;
    grid-column: 3;
    width: 48px;
    height: 48px;
    align-self: center;
    border: 0;
    border-radius: var(--r-full);
    background: var(--combo-field);
    color: var(--combo-fg);
    cursor: pointer;
  }
  .combo.is-sheet .combo-close svg { width: 16px; height: 16px; }
  .combo.is-sheet .combo-list {
    /* relative, не static: подсветка строки считает offsetTop от списка — от окна она
       прокручивала список на высоту поля, и заголовок уезжал под поле */
    position: relative;
    inset: auto;
    grid-row: 2;
    grid-column: 1 / -1;
    margin: 0;
    padding: 0 0 var(--sp-16);
    max-height: none;
    min-height: 0;
    align-content: start; /* строки не растягиваются по высоте окна */
    overflow-y: auto;
    overscroll-behavior: contain;
    border-radius: 0;
    box-shadow: none;
  }

  @media (max-width: 760px) {
    .combo-input { font-size: var(--text-body); padding-block: 16px; }
    .combo-plate { padding: 8px 18px; }
    .combo-plate-value { font-size: var(--text-body); }
    .combo-list.is-brands { grid-template-columns: repeat(2, minmax(0, 1fr)); }

    /* Телефон — на весь экран, как в каталогах auto.ru. --sheet-h и --sheet-top скрипт берёт
       из visualViewport — так окно не уходит под клавиатуру */
    .combo.is-sheet {
      top: var(--sheet-top, 0px);
      left: 0;
      right: 0;
      translate: none;
      width: auto;
      height: var(--sheet-h, 100dvh);
      padding: max(var(--sp-12), env(safe-area-inset-top)) var(--gutter) 0;
      border-radius: 0;
      /* фон и за краем листа: на iPhone между листом и клавиатурой — зона адресной строки
         Safari, без этого там просвечивает страница */
      box-shadow: 0 0 0 100vmax var(--combo-pop);
      touch-action: none; /* жест по шапке листа не крутит страницу под ним */
      animation: none;
    }
    .combo.is-sheet .combo-plate { max-width: 45vw; }
    .combo.is-sheet .combo-list {
      padding-bottom: max(var(--sp-16), env(safe-area-inset-bottom));
      touch-action: pan-y;
    }
  }
  /* пока лист открыт, страница под ним заблокирована */
  :global(html.has-car-sheet),
  :global(html.has-car-sheet body) { overflow: hidden; }
</style>
