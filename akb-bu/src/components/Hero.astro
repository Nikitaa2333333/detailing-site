---
import content from '../data/content.json';
const { hero } = content;
const [before, after] = hero.title.split(hero.accentWord);
---

<section class="hero">
  <div class="hero-media" data-parallax>
    <video
      class="hero-video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="/video/poster.svg"
    >
      <source src="/video/hero.webm" type="video/webm" />
      <source src="/video/hero.mp4" type="video/mp4" />
    </video>
  </div>
  <div class="hero-overlay"></div>

  <div class="container hero-content" data-reveal-group>
    <h1 class="hero-title" data-reveal>
      {before}<span class="accent-text hero-accent">{hero.accentWord}</span>{after}
    </h1>
    <p class="hero-lead" data-reveal>{hero.lead}</p>
    <div class="hero-cta" data-reveal>
      <a class="btn btn--primary" href="#contacts">{hero.ctaPrimary}</a>
      <a class="btn btn--ghost" href="#catalog">{hero.ctaSecondary}</a>
    </div>
    <dl class="hero-stats" data-reveal>
      {hero.stats.map((s) => (
        <div class="stat">
          <dt class="stat-value accent-text">
            {s.prefix}<span data-count={s.value}>0</span>{s.suffix}
          </dt>
          <dd class="stat-label">{s.label}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .hero-media {
    position: absolute;
    inset: -12% 0 0;
    will-change: transform;
  }
  .hero-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* пока видео не положено в public/video — под ним холодная «ночь» */
    background:
      radial-gradient(90% 70% at 75% 15%, rgba(10, 132, 255, 0.16), transparent 60%),
      radial-gradient(70% 60% at 15% 85%, rgba(59, 59, 255, 0.1), transparent 65%),
      var(--color-coal);
  }
  /* §3.3 оверлей: затемнение сверху, переход в сплошной фон снизу */
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(10, 10, 11, 0.55) 0%,
      rgba(10, 10, 11, 0.15) 32%,
      rgba(10, 10, 11, 0.6) 72%,
      #0a0a0b 100%
    );
  }
  .hero-content {
    position: relative;
    width: 100%;
    padding-block: clamp(120px, 16vh, 180px) clamp(48px, 8vh, 96px);
    display: grid;
    gap: var(--sp-28);
    justify-items: start;
  }
  .hero-title {
    font-size: var(--text-display);
    line-height: 0.92;
    letter-spacing: -0.02em;
    max-width: 14ch;
  }
  .hero-lead {
    font-size: var(--text-body-lg);
    font-weight: var(--w-medium);
    max-width: 52ch;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-16);
  }
  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(28px, 5vw, 72px);
    margin: var(--sp-24) 0 0;
    padding-top: var(--sp-28);
    border-top: 1px solid var(--color-line-soft);
    width: 100%;
  }
  .stat { margin: 0; }
  .stat-value {
    font-size: var(--text-stat);
    font-weight: var(--w-black);
    line-height: 1;
  }
  .stat-label {
    margin: var(--sp-8) 0 0;
    font-size: var(--text-caption);
    font-weight: var(--w-medium);
  }
</style>
