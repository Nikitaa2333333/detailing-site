---
import content from '../data/content.json';
import { asset, url } from '../lib/paths.js';
const { hero } = content;
/* Раскадровка: кадры одной сцены с разным состоянием света.
   Кадры включаются по мере прокрутки (scroll-driven), в браузерах без поддержки — по таймеру. */
const frames = hero.frames ?? [hero.media];
---

<!-- Первый экран «липкий»: пока пользователь прокручивает --hero-travel, кадр стоит на месте,
     а свет включается ступенями. Фото 16:9 на всю ширину, кроп только по высоте (пол). -->
<section class="hero on-dark">
  <div class="hero-sticky">
    <div class="hero-media">
      {frames.map((src, i) => {
        /* Размеры под реальный экран: 1440 — ноутбуки 1×, 1920 — 1280 CSS-px при DPR 1.5,
           2048 — предел исходника (выше не растягиваем). AVIF 4:4:4 — без «песка» на зерне
           и цветных кромках, WebP — фолбэк */
        const file = asset(src);
        const base = file.replace(/\.webp$/, '');
        const avif = [1440, 1920, 2048].map((w) => `${base}-${w}.avif ${w}w`).join(', ');
        const webp = [`${base}-1440.webp 1440w`, `${base}-1920.webp 1920w`, `${file} 2048w`].join(', ');
        return (
          <picture>
            <source type="image/avif" srcset={avif} sizes="100vw" />
            <img
              class={`hero-frame${i === 0 ? ' hero-frame--first' : ''}`}
              src={file}
              srcset={webp}
              sizes="100vw"
              alt=""
              fetchpriority={i === 0 ? 'high' : 'auto'}
              decoding="async"
              style={`--i:${i}`}
            />
          </picture>
        );
      })}
    </div>

    <div class="container hero-content">
      <div class="hero-main">
        <h1 class="hero-title">{hero.title}</h1>
        <!-- Вход в калькулятор: выглядит как поиск, по клику передаёт фокус полю в секции расчёта.
             Живое поле здесь не ставим — на телефоне его выпадающий список срезал бы край кадра -->
        <button class="hero-search" type="button" data-calc-open>
          <svg class="hero-search-icon" viewBox="0 0 20 20" aria-hidden="true"><circle cx="9" cy="9" r="6" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="m13.5 13.5 4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          <span class="hero-search-text">{hero.search}</span>
          <span class="hero-search-go">{hero.searchButton}</span>
        </button>
      </div>
      <p class="hero-text">{hero.text}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    /* Сколько прокрутки занимает включение света. 100svh — сам экран, остальное — «путь».
       Крутить в диапазоне 40–100svh; на телефоне свой, короче (ниже, в @media 860px) */
    --hero-travel: 55svh;
    --frame-count: 3;
    position: relative;
    height: calc(100svh + var(--hero-travel));
    background: var(--color-void);
    color: var(--color-white);
  }
  .hero-sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    /* Изолируем от остальной страницы: перерисовки не выходят за пределы блока */
    contain: layout paint;
  }

  /* ---- Фото: 16:9 на всю ширину; при экране ниже 16:9 кроп по высоте, срезаем пол ------ */
  .hero-media {
    position: absolute;
    inset: 0;
  }
  .hero-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 22%;
    opacity: 0;
    /* Каждый кадр — свой слой на GPU: смена прозрачности идёт без перерисовки растра */
    will-change: opacity;
    transform: translateZ(0);
    backface-visibility: hidden;
  }
  .hero-frame--first { opacity: 1; }
  @keyframes hero-frame-in {
    to { opacity: 1; }
  }

  /* Фолбэк: браузер без scroll-driven animations — кадры по таймеру */
  .hero-frame:not(.hero-frame--first) {
    animation: hero-frame-in 1.2s var(--ease-out) forwards;
    animation-delay: calc(0.3s + var(--i) * 1.1s);
  }
  /* Скролл-таймлайн: кадр i проявляется на своём отрезке пути прокрутки */
  @supports (animation-timeline: scroll()) {
    .hero-frame:not(.hero-frame--first) {
      animation: hero-frame-in linear both;
      animation-delay: 0s;
    }
    /* Таймлайн — ОТДЕЛЬНЫМ правилом. Минификатор прод-сборки сворачивает animation-timeline
       в шорткат `animation: … scroll(root)`, который Chrome не парсит: в проде кадры
       включались по таймеру, а не по скроллу. В отдельном блоке склеивать не с чем */
    .hero-media .hero-frame:not(.hero-frame--first) {
      animation-timeline: scroll(root);
      /* отрезки: кадр 1 → 0%…45% пути, кадр 2 → 50%…95% пути; мёртвого хвоста нет */
      animation-range:
        calc(var(--hero-travel) * ((var(--i) - 1) * 0.5))
        calc(var(--hero-travel) * (0.45 + (var(--i) - 1) * 0.5));
    }
  }

  /* ---- Текст — поверх тёмного верха кадра ---------------------------------- */
  .hero-content {
    position: relative;
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: var(--sp-40);
    align-items: start;
    padding-top: calc(var(--header-h) + var(--sp-24));
  }
  .hero-main,
  .hero-text {
    opacity: 0;
    transform: translateY(20px);
    animation: hero-text-in 1.1s var(--ease-out-expo) forwards;
  }
  .hero-main { animation-delay: 0.2s; }
  .hero-text { animation-delay: 0.4s; }
  @keyframes hero-text-in {
    to { opacity: 1; transform: none; }
  }
  .hero-main {
    display: grid;
    /* minmax(0, …): неразрывная подпись поиска иначе распирает колонку шире экрана */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-24);
    justify-items: start;
  }
  .hero-title {
    font-size: var(--text-display);
    max-width: 20ch;
  }
  .hero-search {
    display: flex;
    align-items: center;
    gap: var(--sp-12);
    width: min(100%, 520px);
    padding: 6px 6px 6px var(--sp-20);
    border: none;
    border-radius: var(--r-pill);
    background: var(--color-white);
    color: var(--color-ink);
    font-size: var(--text-body);
    text-align: left;
    cursor: pointer;
  }
  .hero-search-icon { flex: none; width: 20px; height: 20px; }
  .hero-search-text { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hero-search-go {
    flex: none;
    padding: 12px 22px;
    border-radius: var(--r-pill);
    /* Тёмный металл: по чёрному идёт графитовый блик. В покое блик за правым краем,
       при наведении проходит по кнопке и повторяется, пока курсор на поиске */
    background-color: var(--color-ink);
    background-image: linear-gradient(
      110deg,
      var(--color-ink) 0%,
      var(--color-ink) 38%,
      #2e2e34 44%,
      #55555d 50%,
      #2e2e34 56%,
      var(--color-ink) 62%,
      var(--color-ink) 100%
    );
    background-size: 300% 100%;
    background-position: 100% 0;
    color: var(--color-white);
    font-weight: var(--w-medium);
    /* Без наведения блик сам проходит дважды за первые ~5 секунд — после появления текста */
    animation: metal-sheen 2s var(--ease-out) 1s 2;
  }
  .hero-search:hover .hero-search-go { animation: metal-sheen 2.2s var(--ease-out) infinite; }
  @keyframes metal-sheen {
    from { background-position: 100% 0; }
    to { background-position: 0 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-search-go { animation: none; }
    .hero-search:hover .hero-search-go { animation: none; background-position: 50% 0; }
  }
  .hero-text {
    font-size: var(--text-body-lg);
    max-width: 40ch;
    padding-top: 0.4em;
  }

  /* Телефон и планшет в портрете: кадр целиком, 16:9 на всю ширину без кропа,
     текст — под ним. Липкость и смена кадров по скроллу остаются те же */
  @media (max-width: 860px) {
    /* Свайп на телефоне — меньше экрана: свет включается за один-два свайпа */
    .hero { --hero-travel: 50svh; }
    .hero-sticky {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding-top: var(--header-h);
    }
    .hero-media {
      position: relative;
      inset: auto;
      flex: none;
      width: 100%;
      aspect-ratio: 16 / 9;
      /* Кадр растворяется в канве сверху и снизу — без резкой кромки фото */
      -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 18%, #000 78%, transparent 100%);
      mask-image: linear-gradient(to bottom, transparent 0%, #000 18%, #000 78%, transparent 100%);
    }
    .hero-frame { object-position: center; }
    .hero-content {
      /* minmax(0, …): без него колонку распирает строка поиска, и экран уезжает вправо */
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-16);
      padding-top: var(--sp-24);
      padding-bottom: var(--sp-24);
    }
    .hero-main { gap: var(--sp-20); }
    .hero-text { padding-top: 0; font-size: var(--text-body); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero { height: 100svh; }
    .hero-frame, .hero-main, .hero-text { animation: none; opacity: 1; transform: none; }
  }
</style>
