---
import content from '../data/content.json';
import { asset, url } from '../lib/paths.js';
import { typo } from '../lib/typo.js';
const { hero, services } = content;
/* Раскадровка: кадры одной сцены с разным состоянием света.
   Кадры включаются по мере прокрутки (scroll-driven), в браузерах без поддержки — по таймеру. */
const frames = hero.frames ?? [hero.media];
/* С 19.10.2026 — промо-ролик (монтаж из генераций, docs/photo-brief.md). Есть hero.video —
   вместо раскадровки играет ролик по кругу; постер — кадр полировки, он же остаётся при
   «уменьшить движение». Раскадровку не удаляем: убрать video из content.json — вернётся она */
const video = hero.video;
---

<!-- Первый экран «липкий»: пока пользователь прокручивает --hero-travel, кадр стоит на месте,
     а свет включается ступенями. Фото 16:9 на всю ширину, кроп только по высоте (пол). -->
<section class:list={['hero on-dark', video && 'hero--video']} data-bg="#010205">
  <div class="hero-sticky">
    <div class="hero-media">
      {video && <img class="hero-poster" src={asset(hero.poster)} alt="" fetchpriority="high" decoding="async" />}
      {video && (
        <video class="hero-video" muted loop playsinline preload="auto" poster={asset(hero.poster)} aria-hidden="true"
          data-src={asset(video)} data-src-small={asset(hero.videoSmall)}></video>
      )}
      {!video && frames.map((src, i) => {
        /* Размеры под реальный экран: 1440 — ноутбуки 1×, 1920 — 1280 CSS-px при DPR 1.5,
           2048 — предел исходника (выше не растягиваем). AVIF 4:4:4 — без «песка» на зерне
           и цветных кромках, WebP — фолбэк */
        /* варианты собираем из исходного пути, а не из asset(): он добавляет ?v=хеш */
        const file = asset(src);
        const base = src.replace(/\.webp$/, '');
        const avif = [1440, 1920, 2048].map((w) => `${asset(`${base}-${w}.avif`)} ${w}w`).join(', ');
        const webp = [`${asset(`${base}-1440.webp`)} 1440w`, `${asset(`${base}-1920.webp`)} 1920w`, `${file} 2048w`].join(', ');
        return (
          <picture>
            <source type="image/avif" srcset={avif} sizes="100vw" />
            <img
              class={`hero-frame${i === 0 ? ' hero-frame--first' : ''}`}
              src={file}
              srcset={webp}
              sizes="100vw"
              alt=""
              fetchpriority={i === 0 ? 'high' : 'auto'}
              decoding="async"
              style={`--i:${i}`}
            />
          </picture>
        );
      })}
    </div>

    <!-- Заголовок слева, лид справа — оба в тёмном верху кадра, выше световой балки.
         Лид под заголовком (как у b2b.yandex.ru) пробовали 14.10.2026: ложится на балку,
         приглушённый сине-серый на янтаре грязнит — не повторять -->
    <div class="container hero-content">
      <!-- H1 — запрос «премиальный детейлинг в Москве», слоган — подзаголовком под ним (19.10.2026) -->
      <div class="hero-head">
        <h1 class="hero-title">{hero.title}</h1>
        {hero.subtitle && <p class="hero-subtitle">{typo(hero.subtitle)}</p>}
      </div>
      <p class="hero-text">{typo(hero.text)}</p>
    </div>

    <!-- Действия — внизу слева, над полом, не на машине (приём porsche.com: кнопка
         в «стекле» под заголовком первого экрана). По центру — стрелка прокрутки -->
    <div class="container hero-actions">
      <a class="btn btn--primary hero-btn-main" href={url('/calc/')}>{services.more}</a>
      <a class="btn btn--glass hero-btn-alt" href="#services">{hero.cta}</a>
    </div>
    <a class="round-glass hero-down" href="#calc-teaser" aria-label="Прокрутить вниз">
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 4v12m-5-5 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </div>
</section>

<!-- Ролик: источник подставляем скриптом — атрибут media у <source> внутри <video> Chrome не
     понимает. muted + playsinline — иначе iOS не запустит автоплей; Safari верит только
     свойству muted, не атрибуту. Автоплей запрещён (энергосбережение) — остаётся постер -->
<script is:inline>
  (function () {
    var v = document.querySelector('.hero-video');
    if (!v || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    v.src = matchMedia('(max-width: 860px)').matches ? v.dataset.srcSmall : v.dataset.src;
    v.muted = true;
    var p = v.play();
    if (p && p.catch) p.catch(function () {});
  })();
</script>

<style>
  .hero {
    /* Сколько прокрутки занимает включение света. 100svh — сам экран, остальное — «путь».
       Крутить в диапазоне 40–100svh; на телефоне свой, короче (ниже, в @media 860px) */
    --hero-travel: 55svh;
    --frame-count: 3;
    position: relative;
    /* Тёмный лист со скруглёнными нижними углами поверх белого тизера (19.10.2026).
       overflow: clip, не hidden: hidden ломает липкость кадра внутри.
       Зону растворения под кадром убрали 19.10.2026: оставляла пятно на белом */
    height: calc(100svh + var(--hero-travel));
    z-index: 1;
    background: var(--color-ink);
    color: var(--color-white);
    border-radius: 0 0 var(--r-hero) var(--r-hero);
    overflow: clip;
  }
  .hero-sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    /* Изолируем от остальной страницы: перерисовки не выходят за пределы блока */
    contain: layout paint;
  }

  /* ---- Фото: 16:9 на всю ширину; при экране ниже 16:9 кроп по высоте, срезаем пол ------ */
  .hero-media {
    position: absolute;
    inset: 0;
  }
  .hero-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 22%;
    opacity: 0;
    /* Каждый кадр — свой слой на GPU: смена прозрачности идёт без перерисовки растра */
    will-change: opacity;
    transform: translateZ(0);
    backface-visibility: hidden;
  }
  .hero-frame--first { opacity: 1; }

  /* Ролик: без «пути» прокрутки — блок ровно в экран. Постер лежит под видео и виден, пока
     оно грузится. Кадры ролика — сюжет справа, слева тёмный графит под текст.
     --hero-video-x — что держать в кадре на узком экране (крутить 50–80%) */
  .hero--video { --hero-travel: 0svh; --hero-video-x: 70%; }
  .hero-poster,
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--hero-video-x) center;
  }
  @keyframes hero-frame-in {
    to { opacity: 1; }
  }

  /* Фолбэк: браузер без scroll-driven animations — кадры по таймеру */
  .hero-frame:not(.hero-frame--first) {
    animation: hero-frame-in 1.2s var(--ease-out) forwards;
    animation-delay: calc(0.3s + var(--i) * 1.1s);
  }
  /* Скролл-таймлайн: кадр i проявляется на своём отрезке пути прокрутки */
  @supports (animation-timeline: scroll()) {
    .hero-frame:not(.hero-frame--first) {
      animation: hero-frame-in linear both;
      animation-delay: 0s;
    }
    /* Таймлайн — ОТДЕЛЬНЫМ правилом. Минификатор прод-сборки сворачивает animation-timeline
       в шорткат `animation: … scroll(root)`, который Chrome не парсит: в проде кадры
       включались по таймеру, а не по скроллу. В отдельном блоке склеивать не с чем */
    .hero-media .hero-frame:not(.hero-frame--first) {
      animation-timeline: scroll(root);
      /* отрезки: кадр 1 → 0%…45% пути, кадр 2 → 50%…95% пути; мёртвого хвоста нет */
      animation-range:
        calc(var(--hero-travel) * ((var(--i) - 1) * 0.5))
        calc(var(--hero-travel) * (0.45 + (var(--i) - 1) * 0.5));
    }
  }

  /* ---- Текст — поверх тёмного верха кадра ---------------------------------- */
  .hero-content {
    position: relative;
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: var(--sp-40);
    align-items: start;
    padding-top: calc(var(--header-h) + var(--sp-24));
  }
  /* Появления текста и кнопок нет — сняли 19.10.2026 («анимация появления тупая») */
  .hero-title {
    font-size: var(--text-display);
    line-height: 1.05;
    max-width: 16ch;
  }
  /* Подзаголовок — кеглем между заголовком и лидом, той же разрядкой, что заголовок */
  .hero-subtitle {
    margin-top: var(--sp-16);
    font-size: var(--text-subhead);
    letter-spacing: var(--track-head);
    line-height: 1.2;
    max-width: 24ch;
  }
  /* Лид на фото — белый: приглушённый цвет здесь не читается */
  .hero-text {
    font-size: var(--text-lead);
    letter-spacing: var(--track-lead);
    line-height: 1.4;
    max-width: 40ch;
    padding-top: 0.6em;
  }

  /* Низ кадра темнеет снизу вверх (их приём: 185px, чёрный .8 → 0) — на нём кнопки и
     стрелка, отсюда переход в тёмную полосу ниже */
  .hero-sticky::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: var(--scrim-bottom-h);
    background: linear-gradient(to top, var(--scrim));
    pointer-events: none;
  }
  .hero-actions {
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--sp-40);
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-12);
  }
  .hero-down {
    position: absolute;
    left: 50%;
    bottom: var(--sp-40);
    z-index: 1;
    width: 48px;
    height: 48px;
    translate: -50% 0;
  }

  /* Телефон и планшет в портрете (19.10.2026: «первый экран полностью заполнен, акцент на
     фото»): блок ровно в экран, текст и кнопка внизу, фото занимает всё место над ними —
     от самого верха, под шапкой. Кадр шире места — края срезаются (cover), в приоритете
     левая часть с фарой: --hero-photo-x (0% — левый край кадра, 50% — центр; крутить 15–50%).
     Свет по-прежнему включается от прокрутки */
  @media (max-width: 860px) {
    .hero {
      --hero-travel: 36svh;
      --hero-photo-x: 4%;   /* нос машины целиком, срезается правый край (19.10.2026) */
      height: 100svh;
    }
    .hero-sticky {
      position: relative;
      height: 100%;
      display: flex;
      flex-direction: column;
    }
    .hero-media {
      position: relative;
      inset: auto;
      flex: 1 1 0;
      min-height: 0;
      width: 100%;
      /* сверху — под дымкой шапки, снизу кадр плавно уходит в чёрный под заголовком */
      -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 72%, transparent 100%);
      mask-image: linear-gradient(to bottom, #000 0%, #000 72%, transparent 100%);
    }
    .hero-frame { object-position: var(--hero-photo-x) center; }
    .hero-content {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-16);
      padding-top: 0;
      padding-bottom: var(--sp-24);
    }
    .hero-text { padding-top: 0; }
    .hero-sticky::after, .hero-down { display: none; }
    .hero-actions { position: static; flex-direction: column; padding-bottom: var(--sp-24); }
    /* Одна кнопка во всю ширину, с заливкой (19.10.2026: «на всю ширину и зальём»).
       width: 100% у блока — автополя .container в колонке иначе сжимают его по кнопке */
    .hero-actions { width: 100%; }
    .hero-actions .btn { width: 100%; }
    .hero-btn-alt { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero { height: 100svh; }
    .hero-frame { animation: none; opacity: 1; transform: none; }
    .hero-video { display: none; }
  }
</style>
