---
import content from '../data/content.json';
import { asset, url } from '../lib/paths.js';
import { typo } from '../lib/typo.js';
const { hero, services } = content;
/* Раскадровка: кадры одной сцены с разным состоянием света.
   Кадры включаются по мере прокрутки (scroll-driven), в браузерах без поддержки — по таймеру. */
const frames = hero.frames ?? [hero.media];
---

<!-- Первый экран «липкий»: пока пользователь прокручивает --hero-travel, кадр стоит на месте,
     а свет включается ступенями. Фото 16:9 на всю ширину, кроп только по высоте (пол). -->
<section class="hero on-dark">
  <div class="hero-sticky">
    <div class="hero-media">
      {frames.map((src, i) => {
        /* Размеры под реальный экран: 1440 — ноутбуки 1×, 1920 — 1280 CSS-px при DPR 1.5,
           2048 — предел исходника (выше не растягиваем). AVIF 4:4:4 — без «песка» на зерне
           и цветных кромках, WebP — фолбэк */
        const file = asset(src);
        const base = file.replace(/\.webp$/, '');
        const avif = [1440, 1920, 2048].map((w) => `${base}-${w}.avif ${w}w`).join(', ');
        const webp = [`${base}-1440.webp 1440w`, `${base}-1920.webp 1920w`, `${file} 2048w`].join(', ');
        return (
          <picture>
            <source type="image/avif" srcset={avif} sizes="100vw" />
            <img
              class={`hero-frame${i === 0 ? ' hero-frame--first' : ''}`}
              src={file}
              srcset={webp}
              sizes="100vw"
              alt=""
              fetchpriority={i === 0 ? 'high' : 'auto'}
              decoding="async"
              style={`--i:${i}`}
            />
          </picture>
        );
      })}
    </div>

    <!-- Заголовок слева, лид справа — оба в тёмном верху кадра, выше световой балки.
         Лид под заголовком (как у b2b.yandex.ru) пробовали 14.10.2026: ложится на балку,
         приглушённый сине-серый на янтаре грязнит — не повторять -->
    <div class="container hero-content">
      <h1 class="hero-title">{hero.title}</h1>
      <p class="hero-text">{typo(hero.text)}</p>
    </div>

    <!-- Действия — внизу слева, над полом, не на машине (приём porsche.com: кнопка
         в «стекле» под заголовком первого экрана). По центру — стрелка прокрутки -->
    <div class="container hero-actions">
      <a class="btn btn--primary" href={url('/calc/')}>{services.more}</a>
      <a class="btn btn--glass" href="#services">{hero.cta}</a>
    </div>
    <a class="round-glass hero-down" href="#calc-teaser" aria-label="Прокрутить вниз">
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 4v12m-5-5 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </div>
</section>

<style>
  .hero {
    /* Сколько прокрутки занимает включение света. 100svh — сам экран, остальное — «путь».
       Крутить в диапазоне 40–100svh; на телефоне свой, короче (ниже, в @media 860px) */
    --hero-travel: 55svh;
    --frame-count: 3;
    position: relative;
    height: calc(100svh + var(--hero-travel));
    background: var(--color-photo-black);
    color: var(--color-white);
  }
  .hero-sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    /* Изолируем от остальной страницы: перерисовки не выходят за пределы блока */
    contain: layout paint;
  }

  /* ---- Фото: 16:9 на всю ширину; при экране ниже 16:9 кроп по высоте, срезаем пол ------ */
  .hero-media {
    position: absolute;
    inset: 0;
  }
  .hero-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 22%;
    opacity: 0;
    /* Каждый кадр — свой слой на GPU: смена прозрачности идёт без перерисовки растра */
    will-change: opacity;
    transform: translateZ(0);
    backface-visibility: hidden;
  }
  .hero-frame--first { opacity: 1; }
  @keyframes hero-frame-in {
    to { opacity: 1; }
  }

  /* Фолбэк: браузер без scroll-driven animations — кадры по таймеру */
  .hero-frame:not(.hero-frame--first) {
    animation: hero-frame-in 1.2s var(--ease-out) forwards;
    animation-delay: calc(0.3s + var(--i) * 1.1s);
  }
  /* Скролл-таймлайн: кадр i проявляется на своём отрезке пути прокрутки */
  @supports (animation-timeline: scroll()) {
    .hero-frame:not(.hero-frame--first) {
      animation: hero-frame-in linear both;
      animation-delay: 0s;
    }
    /* Таймлайн — ОТДЕЛЬНЫМ правилом. Минификатор прод-сборки сворачивает animation-timeline
       в шорткат `animation: … scroll(root)`, который Chrome не парсит: в проде кадры
       включались по таймеру, а не по скроллу. В отдельном блоке склеивать не с чем */
    .hero-media .hero-frame:not(.hero-frame--first) {
      animation-timeline: scroll(root);
      /* отрезки: кадр 1 → 0%…45% пути, кадр 2 → 50%…95% пути; мёртвого хвоста нет */
      animation-range:
        calc(var(--hero-travel) * ((var(--i) - 1) * 0.5))
        calc(var(--hero-travel) * (0.45 + (var(--i) - 1) * 0.5));
    }
  }

  /* ---- Текст — поверх тёмного верха кадра ---------------------------------- */
  .hero-content {
    position: relative;
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: var(--sp-40);
    align-items: start;
    padding-top: calc(var(--header-h) + var(--sp-24));
  }
  .hero-title,
  .hero-text {
    opacity: 0;
    transform: translateY(20px);
    animation: hero-text-in 1.1s var(--ease-out-expo) forwards;
  }
  .hero-title { animation-delay: 0.2s; }
  .hero-text { animation-delay: 0.4s; }
  @keyframes hero-text-in {
    to { opacity: 1; transform: none; }
  }
  .hero-title {
    font-size: var(--text-display);
    line-height: 1.05;
    max-width: 16ch;
  }
  /* Лид на фото — белый: приглушённый цвет здесь не читается */
  .hero-text {
    font-size: var(--text-lead);
    letter-spacing: var(--track-lead);
    line-height: 1.4;
    max-width: 40ch;
    padding-top: 0.6em;
  }

  /* Низ кадра темнеет снизу вверх (их приём: 185px, чёрный .8 → 0) — на нём кнопки и
     стрелка, отсюда переход в тёмную полосу ниже */
  .hero-sticky::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: var(--scrim-bottom-h);
    background: linear-gradient(to top, var(--scrim));
    pointer-events: none;
  }
  .hero-actions {
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--sp-40);
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-12);
    opacity: 0;
    animation: hero-text-in 1.1s var(--ease-out-expo) 0.6s forwards;
  }
  .hero-down {
    position: absolute;
    left: 50%;
    bottom: var(--sp-40);
    z-index: 1;
    width: 48px;
    height: 48px;
    translate: -50% 0;
  }

  /* Телефон и планшет в портрете: кадр целиком, 16:9 на всю ширину без кропа,
     текст — под ним. Без липкости: блок высотой по содержимому, иначе экран 100svh
     оставлял под текстом пустую дыру до калькулятора (16.10.2026). Свет по-прежнему
     включается от прокрутки — пока кадр ещё на экране */
  @media (max-width: 860px) {
    .hero {
      --hero-travel: 36svh;
      height: auto;
      /* Канва нейтрально-чёрная, как фото: на синеватой фото читалось чужим
         прямоугольником. К низу блока уходит в цвет сайта */
      background: linear-gradient(to bottom, var(--color-photo-black) 55%, var(--color-ink) 100%);
    }
    .hero-sticky {
      position: relative;
      height: auto;
      display: flex;
      flex-direction: column;
      padding-top: var(--header-h);
    }
    .hero-media {
      position: relative;
      inset: auto;
      flex: none;
      width: 100%;
      aspect-ratio: 16 / 9;
      /* Кадр растворяется в канве сверху и снизу — без резкой кромки фото */
      -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 18%, #000 78%, transparent 100%);
      mask-image: linear-gradient(to bottom, transparent 0%, #000 18%, #000 78%, transparent 100%);
    }
    .hero-frame { object-position: center; }
    .hero-content {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-16);
      padding-top: var(--sp-24);
      padding-bottom: var(--sp-24);
    }
    .hero-text { padding-top: 0; }
    .hero-sticky::after, .hero-down { display: none; }
    .hero-actions { position: static; flex-direction: column; padding-bottom: var(--sp-24); }
    .hero-actions .btn { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero { height: 100svh; }
    .hero-frame, .hero-title, .hero-text, .hero-actions { animation: none; opacity: 1; transform: none; }
  }
</style>
