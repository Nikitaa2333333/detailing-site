---
/* Отзывы — только с Яндекс Карт, виджетом по id организации (content.json → reviews.oid).
   Руками отзывы не пишем. Пока oid нет — заглушка с объяснением, что нужно от заказчика. */
import content from '../data/content.json';
import { typo } from '../lib/typo.js';

const { reviews } = content;
const widget = reviews.oid ? `https://yandex.ru/maps-reviews-widget/${reviews.oid}?comments` : '';
const allHref = reviews.oid ? `https://yandex.ru/maps/org/${reviews.oid}/reviews/` : '';
---

<div class="reviews">
  <div class="reviews-side">
    {reviews.rating && <p class="reviews-rating">{reviews.rating}</p>}
    {reviews.count && <p class="reviews-count">{reviews.count} на Яндекс Картах</p>}
    {allHref && <a class="btn btn--primary btn--page" href={allHref} target="_blank" rel="noopener">Все отзывы</a>}
  </div>
  <div class="reviews-feed">
    {widget ? (
      <iframe src={widget} title="Отзывы на Яндекс Картах" loading="lazy"></iframe>
    ) : (
      <div class="reviews-empty">
        <p class="reviews-empty-title">Здесь будет лента отзывов с Яндекс Карт</p>
        <p>{typo('Подключается виджетом Яндекса по id организации — отзывы подтягиваются сами, рейтинг и число отзывов тоже. Нужен id карточки от заказчика.')}</p>
      </div>
    )}
  </div>
</div>

<style>
  .reviews {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: var(--sp-24) var(--sp-40);
    align-items: start;
  }
  .reviews-side { display: grid; gap: var(--sp-12); justify-items: start; }
  /* Цифры как у Porsche: крупно, обычный вес */
  .reviews-rating {
    font-size: var(--text-stat);
    line-height: 1;
  }
  .reviews-count { font-size: var(--text-body-lg); }
  .reviews-feed {
    overflow: hidden;
    border-radius: var(--r-tile);
    background: var(--color-tile);
    color: var(--color-ink);
    min-height: 320px;
  }
  .reviews-feed iframe { display: block; width: 100%; height: 640px; border: 0; }
  .reviews-empty {
    display: grid;
    gap: var(--sp-12);
    padding: var(--sp-32);
    max-width: var(--measure-lead);
  }
  .reviews-empty-title { font-size: var(--text-tile); }
  .reviews-empty { padding: var(--sp-40) var(--sp-32); }
  @media (max-width: 860px) {
    .reviews { grid-template-columns: minmax(0, 1fr); }
    .reviews-empty { padding: var(--sp-24); }
  }
</style>
