---
/* Вопрос-ответ — по референсу b2b.yandex.ru: заголовок слева в колонке 1/3, вопросы справа
   в 2/3, ответ скрыт и раскрывается по клику (шеврон поворачивается), открыть можно несколько.
   Нативные <details>: работает без JS и с клавиатуры. Линии между вопросами и приглушённый
   ответ — как у референса, по прямой просьбе 14.10.2026 («у Яндекса лучше») вопреки общему
   правилу. Наведение — вопрос приглушается, без плашки. Тексты — content.json → faq. */
import { typo } from '../lib/typo.js';

const { title, items = [] } = Astro.props;
---

<div class="faq">
  <h2 class="faq-title">{title}</h2>
  <div class="faq-list">
    {items.map((item) => (
      <details class="faq-item">
        <summary class="faq-q">
          <span>{typo(item.q)}</span>
          <svg class="faq-chevron" viewBox="0 0 32 32" aria-hidden="true"><path d="m7 12 9 9 9-9" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </summary>
        <p class="faq-a">{typo(item.a)}</p>
      </details>
    ))}
  </div>
</div>

<style>
  .faq {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: var(--sp-24) var(--sp-80);
    align-items: start;
  }
  /* Заголовок — по Porsche: крупно, обычный вес (вес 800 Яндекса снят 19.10.2026) */
  .faq-title { font-size: var(--text-heading-xl); }

  .faq-list { display: grid; }
  .faq-item {
    border-bottom: 1px solid var(--color-line-white);
    /* плавное раскрытие ответа там, где браузер умеет анимировать height: auto */
    interpolate-size: allow-keywords;
  }
  .faq-item:last-child { border-bottom: none; }
  .faq-item::details-content {
    block-size: 0;
    overflow: hidden;
    transition: block-size 0.3s var(--ease-out), content-visibility 0.3s allow-discrete;
  }
  .faq-item[open]::details-content { block-size: auto; }

  /* Строка вопроса: текст слева, шеврон справа, первая строка стоит вровень с заголовком */
  .faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-24);
    padding: var(--sp-20) 0;
    font-size: var(--text-question);
    line-height: 1.3;
    cursor: pointer;
    list-style: none;
    transition: color var(--t-hover-out) var(--ease-out);
  }
  .faq-item:first-child .faq-q { padding-top: var(--sp-4); }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-q:hover { color: var(--color-text-muted); transition-duration: var(--t-hover-in); }
  .faq-chevron {
    flex: none;
    width: 32px;
    height: 32px;
    transition: transform 0.25s var(--ease-out);
  }
  .faq-item[open] .faq-chevron { transform: rotate(180deg); }

  /* Ответ приглушён — как у референса */
  .faq-a {
    max-width: var(--measure-text);
    padding-bottom: var(--sp-24);
    font-size: var(--text-body-lg);
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  @media (max-width: 860px) {
    .faq { grid-template-columns: minmax(0, 1fr); }
  }
</style>
