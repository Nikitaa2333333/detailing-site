---
/* Тизер калькулятора на главной (16.10.2026): сам калькулятор живёт на /calc/, здесь —
   видео-демо в рамке телефона (запись настоящего калькулятора, по кругу, без звука)
   и поле машины. Расчёт начинается прямо тут: введённое уходит в /calc/?car=…,
   страница калькулятора подставляет его в поле. */
import { url } from '../lib/paths.js';
import { typo } from '../lib/typo.js';
import CarCombo from './CarCombo.astro';

const {
  title = 'Цена для вашей машины за минуту',
  text = 'Введите марку и модель — покажем цены по прайсу для её класса. Без звонка и ожидания менеджера.',
} = Astro.props;
---

<!-- Видео-демо снято 16.10.2026 (растр: мыло на десктопе, кодеки, iOS). На его место —
     демо из живой вёрстки калькулятора (следующий шаг); стили наклона и свечения
     .teaser-phone / .teaser-glow ниже оставлены под него. Свечение — в истории git -->
<div class="teaser teaser--text">
  <div class="teaser-body">
    <h2 class="teaser-title">{typo(title)}</h2>
    <p class="teaser-text">{typo(text)}</p>
    <!-- Шаги 1–4 сняты 16.10.2026: их показывает видео, в тексте — перегруз -->
    <!-- Поле машины — то же CarCombo, что в калькуляторе (подсказки по маркам и моделям).
         Выбор кладётся в память калькулятора (ds-calc-v1), /calc/ открывается сразу на шаге 2 -->
    <form class="teaser-form" action={url('/calc/')} method="get" data-teaser data-calc-url={url('/calc/')}>
      <CarCombo id="teaser-car" placeholder="Марка или модель" label="Марка и модель" />
      <button class="btn teaser-btn" type="submit">
        Рассчитать стоимость
      </button>
    </form>
  </div>
</div>

<script>
  import { loadCars } from '../lib/car-index-client.js';
  import { carCombo } from '../lib/car-combo.js';

  const form = document.querySelector<HTMLFormElement>('[data-teaser]');
  const box = form?.querySelector<HTMLElement>('[data-car-combo]');
  if (form && box) {
    const STORE = 'ds-calc-v1'; // память калькулятора: car, seen, sel
    // Выбор не уводит со страницы (16.10.2026: резкий переход): машина встаёт плашками,
    // в калькулятор ведёт кнопка «Рассчитать стоимость»
    let picked: unknown = null;
    let chosen = false; // выбрали машину или «нет в списке»
    let cars: unknown = null;
    const combo = carCombo(box, {
      cars: () => cars,
      car: () => picked,
      onPick: (car: unknown) => {
        picked = car;
        chosen = true;
        combo.sync();
        form.classList.add('is-ready');
      },
      missText: (q: string) => `«${q}» нет в списке — покажем цены «от», класс уточнит менеджер`,
      onMiss: () => {
        picked = null;
        chosen = true;
        form.classList.add('is-ready');
      },
    });
    loadCars().then((index: unknown) => { cars = index; combo.ready(); }).catch(() => {});

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (chosen) {
        try {
          const prev = JSON.parse(localStorage.getItem(STORE) || 'null') ?? {};
          localStorage.setItem(STORE, JSON.stringify({ ...prev, car: picked, seen: true }));
        } catch {}
      }
      location.href = form.dataset.calcUrl!;
    });

    // Открыли поле на десктопе — подтягиваем его к верху экрана, чтобы список не упирался в низ.
    // На телефоне выбор и так на весь экран
    const input = box.querySelector<HTMLInputElement>('[data-car-input]');
    input?.addEventListener('focus', () => {
      if (!matchMedia('(min-width: 861px)').matches) return;
      const top = form.getBoundingClientRect().top;
      const header = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-h')) || 88;
      if (top > window.innerHeight * 0.35) window.scrollBy({ top: top - header - 24, behavior: 'smooth' });
    });
  }
</script>

<style>
  /* Порядок (16.10.2026): заголовок → описание → видео → поле и кнопка. На десктопе видео
     слева на всю высоту, справа заголовок, описание, форма. teaser-body — display: contents,
     его дети встают прямо в сетку тизера */
  .teaser {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    grid-template-areas:
      'media title'
      'media text'
      'media form';
    grid-template-rows: auto auto 1fr;
    gap: var(--sp-20) var(--sp-64);
    align-content: center;
  }
  .teaser-body { display: contents; }
  /* Без демо: одна колонка — заголовок, лид, поле и кнопка */
  .teaser--text {
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'title' 'text' 'form';
    grid-template-rows: none;
  }
  .teaser-phone { grid-area: media; align-self: center; }
  .teaser-title { grid-area: title; align-self: end; }
  .teaser-text { grid-area: text; }
  .teaser-form { grid-area: form; align-self: start; }
  /* Демо — просто видео, скруглённый прямоугольник прямо на полосе (16.10.2026):
     ни рамки телефона, ни плашки вокруг. «Базовое 3D», как в Премьере: плоскость
     повёрнута по диагонали и медленно покачивается на несколько градусов.
     --tilt-* — поза покоя, --sway — размах покачивания */
  .teaser-phone {
    --tilt-x: 8deg;
    --tilt-y: 16deg;   /* размах поворота влево-вправо: от −16° до +16° */
    --tilt-z: 2deg;
    position: relative;
    isolation: isolate;
    justify-self: center;
    width: min(100%, 400px);
    perspective: 1400px;
  }
  /* свечение шире колонки — обрезаем по краю полосы, а не страницы */
  :global(.section:has(.teaser)) { overflow-x: clip; }
  .teaser-glow {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 170%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    z-index: -1;
    pointer-events: none;
  }
  .teaser-video {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: top center;
    border-radius: var(--r-tile);
    background: var(--color-tile-dark);
    transform: rotateX(var(--tilt-x)) rotateY(calc(var(--tilt-y) * -1)) rotateZ(var(--tilt-z));
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.3);
    animation: teaser-sway 12s ease-in-out infinite;
  }
  /* Плоскость всё время в движении: влево → вправо → влево, без стоянок */
  @keyframes teaser-sway {
    0%, 100% { transform: rotateX(var(--tilt-x)) rotateY(calc(var(--tilt-y) * -1)) rotateZ(var(--tilt-z)) translateY(0); }
    50% { transform: rotateX(calc(var(--tilt-x) * 0.6)) rotateY(var(--tilt-y)) rotateZ(calc(var(--tilt-z) * -1)) translateY(-10px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .teaser-video { animation: none; }
  }
  .teaser-title { font-size: var(--text-heading-xl); max-width: var(--measure-head); }
  .teaser-text { font-size: var(--text-lead); max-width: var(--measure-lead); letter-spacing: var(--track-lead); }
  /* Поле + крупная кнопка-действие (16.10.2026: «максимально кликабельно»).
     Кнопка — оранжевая, цвет балки света из hero: единственное цветное пятно блока.
     Поле и кнопка — одной строкой на десктопе, на телефоне кнопка во всю ширину под полем */
  /* Поле машины во всю строку, кнопка — под ним: рядом с кнопкой поле с плашкой марки
     сжималось в огрызок (16.10.2026) */
  .teaser-form {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-12);
    width: 100%;
    max-width: 560px;
    margin-top: var(--sp-8);
  }
  /* Поле — CarCombo, светлая схема (тизер на светлой полосе с 19.10.2026) */
  .teaser-form :global(.combo) {
    --combo-fg: var(--color-ink);
    --combo-field: var(--color-tile);
    --combo-field-hover: var(--color-tile-hover);
    --combo-pop: var(--color-page);
    --combo-hover: var(--row-hover-light);
    --combo-line: var(--color-line-ink);
    /* выбранная машина — светло-серые плашки (их вторичная): чёрной остаётся только кнопка */
    --combo-sel-bg: var(--color-tile);
    --combo-sel-fg: var(--color-ink);
    --combo-sel-hover: var(--color-tile-hover);
    max-width: none;
  }
  /* Скроллбар выдачи — тонкий, в цвет, вместо системного серого */
  .teaser-form :global([data-car-list]) {
    scrollbar-width: thin;
    scrollbar-color: var(--color-line-ink) transparent;
  }
  /* Выбранная машина — крупно (16.10.2026): марка и модель читаются издалека */
  /* Плашки и поле — одной фиксированной высоты: --teaser-row (16.10.2026: плашка марки
     была выше поля рядом) */
  /* высота поля и плашек машины = высота кнопки (56); было 72 — на телефоне в полноэкранном
     выборе поле выходило огромным (19.10.2026) */
  .teaser-form { --teaser-row: 56px; }
  .teaser-form :global(.combo-plate) {
    height: var(--teaser-row);
    min-height: 0;
    padding-block: 0;
    padding-inline: 28px;
    box-sizing: border-box;
  }
  .teaser-form :global(.combo-input) {
    height: var(--teaser-row);
    box-sizing: border-box;
    font-size: var(--text-body-lg);
  }
  .teaser-form :global(.combo-plate-value) { font-size: var(--text-subhead); }
  .teaser-form :global(.combo-class) { font-size: var(--text-body); font-weight: var(--w-medium); letter-spacing: 0; }

  /* Металлический блик «вжух» на кнопке пробовали 16.10.2026 — снят: лишнее */
  .teaser-form .teaser-btn { justify-self: start; }
  .teaser-field {
    min-width: 0;
    height: 60px;
    padding-inline: var(--sp-20);
    border: 0;
    outline: 0;
    border-radius: var(--r-input);
    background: var(--color-white);
    font: inherit;
    font-size: var(--text-body-lg);
    color: var(--color-ink);
  }
  .teaser-field::placeholder { color: var(--color-grey-text); }
  /* Их первичная на светлом — чёрная заливка, обычный вес, высота 56 */
  .teaser-form .teaser-btn {
    background: var(--color-ink);
    color: var(--color-white);
  }
  .teaser-form .teaser-btn:hover { background: var(--color-ink-hover); }

  /* Телефон: заголовок → описание → видео → форма; видео ~86% ширины */
  @media (max-width: 860px) {
    .teaser {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'title' 'text' 'media' 'form';
      grid-template-rows: none;
    }
    .teaser-phone { justify-self: center; width: min(86%, 340px); margin-block: var(--sp-24); }
    .teaser-form { grid-template-columns: minmax(0, 1fr); }
    .teaser-form .teaser-btn { width: 100%; }
  }
</style>
