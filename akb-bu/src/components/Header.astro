---
import content from '../data/content.json';
const { contacts } = content;
const nav = [
  { href: '#catalog', label: 'Каталог' },
  { href: '#testing', label: 'Проверка' },
  { href: '#buyback', label: 'Выкуп' },
  { href: '#contacts', label: 'Контакты' },
];
---

<div class="header-wrap" id="header-wrap">
  <header class="header-main">
    <a class="logo" href="/">АКБ<span class="accent-text">СЕРВИС</span></a>
    <nav class="nav">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <a class="btn btn--primary header-cta" href="#contacts">Оставить заявку</a>
  </header>
  <span class="pill-contact pill-address">{contacts.address}</span>
  <a class="pill-contact pill-phone" href={`tel:${contacts.phoneHref}`}>{contacts.phone}</a>
</div>

<script>
  const wrap = document.getElementById('header-wrap');
  let ticking = false;
  window.addEventListener(
    'scroll',
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        wrap?.classList.toggle('is-scrolled', window.scrollY > 120);
        ticking = false;
      });
    },
    { passive: true }
  );
</script>

<style>
  .header-wrap {
    position: fixed;
    top: 16px;
    left: 50%;
    translate: -50% 0;
    z-index: 100;
    display: flex;
    align-items: stretch;
    gap: var(--sp-12);
    width: min(calc(100% - 40px), 1320px);
  }
  .header-main {
    flex: 1;
    display: flex;
    align-items: center;
    gap: var(--sp-32);
    padding: 10px 12px 10px 28px;
    border-radius: var(--r-pill);
    background: rgba(28, 28, 32, 0.86);
    backdrop-filter: blur(14px);
    transition:
      opacity 0.45s var(--ease-out-expo),
      transform 0.45s var(--ease-out-expo);
  }
  .is-scrolled .header-main {
    opacity: 0;
    transform: translateY(-140%);
    pointer-events: none;
  }
  .logo {
    font-weight: var(--w-black);
    font-size: 1.15rem;
    letter-spacing: 0.02em;
  }
  .nav {
    display: flex;
    gap: var(--sp-24);
    margin-left: auto;
  }
  .nav a {
    font-size: 0.9375rem;
    font-weight: var(--w-medium);
    transition: color 0.18s ease-out;
  }
  .nav a:hover { color: var(--color-azure-bright); }
  .header-cta {
    padding: 12px 22px;
    font-size: 0.9375rem;
    white-space: nowrap;
  }

  /* Плашки контактов — остаются при скролле */
  .pill-contact {
    display: flex;
    align-items: center;
    padding: 0 22px;
    border-radius: var(--r-pill);
    background: rgba(28, 28, 32, 0.86);
    backdrop-filter: blur(14px);
    white-space: nowrap;
    font-size: 0.9375rem;
  }
  .pill-address { font-weight: var(--w-medium); }
  .pill-phone { font-weight: var(--w-bold); }

  @media (max-width: 1280px) {
    .pill-address { display: none; }
  }
  @media (max-width: 900px) {
    .nav { display: none; }
    .pill-phone { display: none; }
    .header-main { gap: var(--sp-16); justify-content: space-between; }
  }
</style>
