---
import content from '../data/content.json';
import { categories, rub, plural } from '../lib/catalog.js';
import { url } from '../lib/paths.js';
const { contacts, brand, nav, services } = content;
---

<!-- Шапка без подложки: на hero видна всегда, после hero пропадает, при скролле вверх возвращается.
     Цвет — через переключение класса (белый над тёмным, чёрный над светлым).
     «Услуги» раскрывают карту прайса: наведение открывает, клик фиксирует (замечание к ТЗ —
     на референсе строка не фиксируется и уводит курсор мимо нужного пункта). -->
<header class="header on-dark" id="header">
  <div class="container header-inner">
    <a class="logo" href={url('/')}>{brand.logo}<span class="logo-accent">{brand.logoAccent}</span></a>
    <nav class="nav">
      <button class="nav-link nav-toggle" type="button" id="services-toggle" aria-expanded="false" aria-controls="services-menu">
        {services.menuTitle}
        <svg class="nav-chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6.5 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      {nav.map((item) => <a class="nav-link" href={item.href}>{item.label}</a>)}
    </nav>
    <a class="header-phone" href={`tel:${contacts.phoneHref}`}>{contacts.phone}</a>
    <a class="btn btn--primary header-cta" href="#contacts">Связаться</a>
  </div>

  <div class="mega" id="services-menu">
    <div class="mega-grid">
      {categories.map((c) => (
        <div class="mega-col">
          <a class="mega-head" href={`#cat-${c.id}`} data-tile={c.id}>
            <span class="mega-title">{c.title}</span>
            <span class="mega-count">{c.count} {plural(c.count)}</span>
          </a>
          <ul class="mega-list">
            {c.items.map((i) => (
              <li>
                <a href="#contacts" data-service={i.title} data-service-id={i.id}>
                  <span class="mega-name">{i.title}</span>
                  <span class="mega-price">от {rub(i.from)}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="mega-note">{services.menuNote}</p>
  </div>
</header>

<script>
  const header = document.getElementById('header');
  const hero = document.querySelector('.hero');
  const toggle = document.getElementById('services-toggle');
  const mega = document.getElementById('services-menu');

  /* ——— Карта услуг ——— */
  let pinned = false; // зафиксировано кликом: наведение больше не закрывает
  const setMenu = (open) => {
    if (!open) pinned = false;
    header?.classList.toggle('is-menu-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
  };
  const isOpen = () => header?.classList.contains('is-menu-open');

  toggle?.addEventListener('click', () => {
    if (isOpen() && pinned) return setMenu(false);
    pinned = true;
    setMenu(true);
  });
  // На тачскрине hover эмулируется кликом — там работает только фиксация
  const canHover = window.matchMedia('(hover: hover)').matches;
  if (canHover) {
    toggle?.addEventListener('pointerenter', () => setMenu(true));
    header?.addEventListener('pointerleave', () => {
      if (!pinned) setMenu(false);
    });
  }
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen()) {
      setMenu(false);
      toggle?.focus();
    }
  });
  document.addEventListener('click', (e) => {
    if (isOpen() && !header?.contains(e.target)) setMenu(false);
  });

  /* Переход из меню: прокрутка к плашке категории и её раскрытие */
  const openTile = (id) => {
    document.querySelectorAll('[data-tile].is-open').forEach((t) => t.classList.remove('is-open'));
    document.getElementById(`cat-${id}`)?.classList.add('is-open');
  };
  // Любая ссылка в меню закрывает его; заголовок категории вдобавок раскрывает её плашку
  mega?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      setMenu(false);
      if (link.dataset.tile) openTile(link.dataset.tile);
    });
  });
  // Наведение на другую плашку снимает фиксацию — иначе раскрытыми окажутся две
  document.addEventListener('pointerover', (e) => {
    const tile = e.target?.closest?.('[data-tile]');
    document.querySelectorAll('[data-tile].is-open').forEach((t) => {
      if (t !== tile) t.classList.remove('is-open');
    });
  });

  /* ——— Поведение самой шапки ——— */
  let hidden = false;
  let lastY = window.scrollY;
  let ticking = false;
  const HIDE_DELTA = 8; // мелкие дёргания скролла не переключают состояние
  const setHidden = (value) => {
    if (value === hidden) return; // состояние не изменилось — DOM не трогаем
    hidden = value;
    header?.classList.toggle('is-hidden', hidden);
    if (hidden) setMenu(false); // уезжающая шапка не должна тянуть за собой меню
  };
  // Что лежит под нижней кромкой шапки: тёмная поверхность → белый текст, иначе чёрный
  const DARK = '.hero, .section--dark, .dark-panel, .mega';
  let onLight = false;
  const updateTone = () => {
    if (!header) return;
    const probe = document.elementFromPoint(window.innerWidth / 2, header.offsetHeight + 1);
    const light = !!probe && !probe.closest(DARK);
    if (light === onLight) return;
    onLight = light;
    header.classList.toggle('is-on-light', light);
    header.classList.toggle('on-dark', !light);
  };
  const update = () => {
    ticking = false;
    const y = window.scrollY;
    const threshold = hero ? hero.offsetHeight - 80 : 40;
    const delta = y - lastY;
    if (y <= threshold) {
      setHidden(false); // на первом экране шапка видна всегда
    } else if (Math.abs(delta) >= HIDE_DELTA) {
      setHidden(delta > 0); // ниже hero: вниз — прячем, вверх — показываем
    }
    if (Math.abs(delta) >= HIDE_DELTA) lastY = y;
    updateTone();
  };
  window.addEventListener(
    'scroll',
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    },
    { passive: true }
  );
  update();
</script>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    color: var(--color-white);
    transition: color 0.2s var(--ease-out), opacity 0.2s var(--ease-out), transform 0.2s var(--ease-out);
  }
  /* Над светлой секцией — чёрный текст, подложки по-прежнему нет */
  .header.is-on-light { color: var(--color-ink); }
  /* Свёрнутое состояние — тихое растворение с лёгким сдвигом */
  .header.is-hidden { opacity: 0; transform: translateY(-12px); pointer-events: none; }
  .header-inner {
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: var(--sp-32);
  }
  .logo {
    font-weight: var(--w-bold);
    font-size: 1.05rem;
    letter-spacing: 0.02em;
  }

  .nav { display: flex; align-items: center; gap: var(--sp-24); }
  /* Наведение — подсветка-плашка (тот же приём, что в строках прайса), не подчёркивание.
     Отрицательные поля: плашка шире текста, но пункты остаются на своих местах */
  .nav-link {
    font-size: var(--text-caption);
    font-weight: var(--w-medium);
    padding: 4px 10px;
    margin-inline: -10px;
    border-radius: var(--r-row);
    transition: background-color var(--t-hover-out) var(--ease-out);
  }
  .nav-link:hover { background: color-mix(in srgb, currentColor 12%, transparent); transition-duration: var(--t-hover-in); }
  .nav-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-8);
    background: none;
    border: none;
    color: inherit;
    cursor: pointer;
  }
  .nav-chevron {
    width: 12px;
    height: 12px;
    transition: transform 0.2s var(--ease-out);
  }
  .header.is-menu-open .nav-toggle { background: color-mix(in srgb, currentColor 12%, transparent); }
  .header.is-menu-open .nav-chevron { transform: rotate(180deg); }

  /* Карта услуг — тёмная панель шириной с контент, под шапкой */
  .mega {
    position: absolute;
    top: var(--header-h);
    left: 50%;
    width: min(100% - var(--gutter) * 2, var(--page-max) - var(--gutter) * 2);
    padding: var(--sp-32) var(--sp-40) var(--sp-24);
    border-radius: var(--r-panel);
    background: var(--color-tile-dark);
    color: var(--color-white);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, -8px);
    transition: opacity 0.2s var(--ease-out), transform 0.2s var(--ease-out), visibility 0.2s;
  }
  .header.is-menu-open .mega {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }
  .mega-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-32) var(--sp-48);
  }
  .mega-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-16);
    margin-inline: calc(var(--sp-8) * -1);
    padding: 4px var(--sp-8) var(--sp-12);
    border-radius: var(--r-row);
    transition: background-color var(--t-hover-out) var(--ease-out);
  }
  .mega-head:hover { background: var(--color-row-hover-dark); transition-duration: var(--t-hover-in); }
  .mega-title {
    font-size: var(--text-body-lg);
    font-weight: var(--w-semibold);
    letter-spacing: -0.02em;
  }
  .mega-count {
    flex: none;
    font-size: var(--text-caption);
    font-weight: var(--w-medium);
  }
  .mega-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
    font-size: var(--text-caption);
  }
  /* Строка под курсором берётся плашкой — тот же приём, что в обороте плашки услуг */
  .mega-list a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-16);
    margin-inline: calc(var(--sp-8) * -1);
    padding: 5px var(--sp-8);
    border-radius: var(--r-row);
    transition: background-color var(--t-hover-out) var(--ease-out);
  }
  .mega-list a:hover,
  .mega-list a:focus-visible {
    background: var(--color-row-hover-dark);
    transition-duration: var(--t-hover-in);
  }
  /* Название услуги крупнее и плотнее цены: в служебном списке это рабочая иерархия */
  .mega-name {
    font-size: var(--text-body);
    font-weight: var(--w-semibold);
    line-height: 1.25;
  }
  .mega-price {
    flex: none;
    font-variant-numeric: tabular-nums;
  }
  .mega-note {
    margin-top: var(--sp-32);
    padding-top: var(--sp-16);
    border-top: 1px solid var(--color-line-white);
    font-size: var(--text-caption);
  }

  .header-phone {
    margin-left: auto;
    font-size: var(--text-caption);
    font-weight: var(--w-medium);
    white-space: nowrap;
  }
  .header-cta {
    padding: 10px 18px;
    font-size: var(--text-caption);
  }

  @media (max-width: 1240px) {
    .mega-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 900px) {
    .nav, .mega { display: none; }
  }
  @media (max-width: 600px) {
    .header-phone { display: none; }
  }
</style>
