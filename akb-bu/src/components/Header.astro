---
import content from '../data/content.json';
import { categories, rub } from '../lib/catalog.js';
import { url } from '../lib/paths.js';
const { contacts, brand, nav, services } = content;
---

<!-- Шапка без подложки поверх первого экрана и уезжает вместе со страницей — как у референса
     (b2b.yandex.ru): не висит над контентом, не прячется-появляется. Кегль навигации — 16px.
     «Услуги» раскрывают карту прайса: наведение открывает, клик фиксирует (замечание к ТЗ —
     на референсе строка не фиксируется и уводит курсор мимо нужного пункта). -->
<header class="header on-dark" id="header">
  <div class="container header-inner">
    <a class="logo" href={url('/')}>{brand.logo}<span class="logo-accent">{brand.logoAccent}</span></a>
    <nav class="nav">
      <button class="nav-link nav-toggle" type="button" id="services-toggle" aria-expanded="false" aria-controls="services-menu">
        {services.menuTitle}
        <svg class="nav-chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6.5 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      {nav.map((item) => <a class="nav-link" href={item.href}>{item.label}</a>)}
    </nav>
    <a class="header-phone" href={`tel:${contacts.phoneHref}`}>{contacts.phone}</a>
    <a class="btn btn--accent header-cta" href="#contacts">Связаться</a>
    <!-- Телефон и планшет: бургер выкатывает ту же карту услуг сверху -->
    <button class="burger" type="button" id="menu-burger" aria-expanded="false" aria-controls="services-menu" aria-label="Меню">
      <span></span><span></span>
    </button>
  </div>

  <div class="mega" id="services-menu">
    <div class="mega-grid">
      {categories.map((c) => (
        <div class="mega-col">
          <a class="mega-head" href={`#cat-${c.id}`} data-tile={c.id}>
            <span class="mega-title">{c.title}</span>
          </a>
          <ul class="mega-list">
            {c.items.map((i) => (
              <li>
                <a href="#contacts" data-service={i.title} data-service-id={i.id}>
                  <span class="mega-name">{i.title}</span>
                  <span class="mega-price">от {rub(i.from)}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="mega-note">{services.menuNote}</p>
    <!-- только в мобильном меню: остальная навигация и телефон -->
    <div class="mega-extra">
      {nav.map((item) => <a class="mega-extra-link" href={item.href}>{item.label}</a>)}
      <a class="mega-extra-phone" href={`tel:${contacts.phoneHref}`}>{contacts.phone}</a>
    </div>
  </div>
  <!-- Затемнение страницы под открытым меню, как на сайте КТМ; клик или курсор сюда — закрыть -->
  <div class="mega-scrim" data-mega-scrim aria-hidden="true"></div>
</header>

<script>
  const header = document.getElementById('header');
  const toggle = document.getElementById('services-toggle');
  const mega = document.getElementById('services-menu');

  /* ——— Карта услуг ——— */
  let pinned = false; // зафиксировано кликом: наведение больше не закрывает
  const burger = document.getElementById('menu-burger');
  const mobile = window.matchMedia('(max-width: 900px)');
  const setMenu = (open) => {
    if (!open) pinned = false;
    header?.classList.toggle('is-menu-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    burger?.setAttribute('aria-expanded', String(open));
    // на телефоне меню во весь экран — страница под ним не крутится
    document.documentElement.style.overflow = open && mobile.matches ? 'hidden' : '';
  };
  burger?.addEventListener('click', () => {
    if (header?.classList.contains('is-menu-open')) return setMenu(false);
    pinned = true;
    setMenu(true);
  });
  const isOpen = () => header?.classList.contains('is-menu-open');

  toggle?.addEventListener('click', () => {
    if (isOpen() && pinned) return setMenu(false);
    pinned = true;
    setMenu(true);
  });
  // На тачскрине hover эмулируется кликом — там работает только фиксация
  const canHover = window.matchMedia('(hover: hover)').matches;
  if (canHover) {
    toggle?.addEventListener('pointerenter', () => setMenu(true));
    header?.addEventListener('pointerleave', () => {
      if (!pinned) setMenu(false);
    });
  }
  const scrim = header?.querySelector('[data-mega-scrim]');
  scrim?.addEventListener('click', () => setMenu(false));
  if (canHover) scrim?.addEventListener('pointerenter', () => { if (!pinned) setMenu(false); });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen()) {
      setMenu(false);
      toggle?.focus();
    }
  });
  document.addEventListener('click', (e) => {
    if (isOpen() && !header?.contains(e.target)) setMenu(false);
  });

  /* Переход из меню: прокрутка к плашке категории и её раскрытие */
  const openTile = (id) => {
    document.querySelectorAll('[data-tile].is-open').forEach((t) => t.classList.remove('is-open'));
    document.getElementById(`cat-${id}`)?.classList.add('is-open');
  };
  // Любая ссылка в меню закрывает его; заголовок категории вдобавок раскрывает её плашку
  mega?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      setMenu(false);
      if (link.dataset.tile) openTile(link.dataset.tile);
    });
  });
  // Наведение на другую плашку снимает фиксацию — иначе раскрытыми окажутся две.
  // Только там, где есть курсор: на тач-экране браузер шлёт pointerover и после тапа,
  // и при сдвиге вёрстки — он закрывал только что открытую плашку
  document.addEventListener('pointerover', (e) => {
    if (!matchMedia('(hover: hover)').matches) return;
    const tile = e.target?.closest?.('[data-tile]');
    document.querySelectorAll('[data-tile].is-open').forEach((t) => {
      if (t !== tile) t.classList.remove('is-open');
    });
  });
</script>

<style>
  /* Закреплена на всех экранах, цвета основы (16.10.2026: «шапку всегда оставил бы»;
     раньше на десктопе лежала прозрачной поверх первого экрана и уезжала) */
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--color-ink);
    color: var(--color-white);
  }
  .header-inner {
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: var(--sp-40);
  }
  /* Логотип — в тон заголовкам: вес 800, плотный трекинг (16.10.2026) */
  .logo {
    font-weight: var(--w-black);
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }

  .nav { display: flex; align-items: center; gap: var(--sp-32); }
  /* Наведение — подсветка-плашка (тот же приём, что в строках прайса), не подчёркивание.
     Отрицательные поля: плашка шире текста, но пункты остаются на своих местах */
  .nav-link {
    font-size: var(--text-body);
    font-weight: var(--w-medium);
    padding: 6px 12px;
    margin-inline: -12px;
    border-radius: var(--r-row);
    transition: background-color var(--t-hover-out) var(--ease-out);
  }
  .nav-link:hover { background: color-mix(in srgb, currentColor 12%, transparent); transition-duration: var(--t-hover-in); }
  .nav-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-8);
    background: none;
    border: none;
    color: inherit;
    cursor: pointer;
  }
  .nav-chevron {
    width: 12px;
    height: 12px;
    transition: transform 0.2s var(--ease-out);
  }
  .header.is-menu-open .nav-toggle { background: color-mix(in srgb, currentColor 12%, transparent); }
  .header.is-menu-open .nav-chevron { transform: rotate(180deg); }

  /* Карта услуг — полоса во всю ширину окна, цвета шапки, под ней затемнение страницы
     (16.10.2026, как на сайте КТМ). Контент полосы — по сетке страницы */
  .mega {
    position: absolute;
    top: var(--header-h);
    left: 0;
    right: 0;
    padding: var(--sp-32) max(var(--gutter), (100% - var(--page-max)) / 2 + var(--gutter)) var(--sp-24);
    background: var(--color-ink);
    color: var(--color-white);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: opacity 0.2s var(--ease-out), transform 0.2s var(--ease-out), visibility 0.2s;
  }
  .header.is-menu-open .mega {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  /* начинается под шапкой: иначе ложится и на её фон (фон шапки ниже детей с z-index −1).
     Шапка fixed — значит и затемнение всегда точно под ней */
  .mega-scrim {
    position: fixed;
    inset: var(--header-h) 0 0;
    z-index: -1;
    background: rgba(0, 0, 0, 0.55);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s var(--ease-out), visibility 0.2s;
  }
  .header.is-menu-open .mega-scrim { opacity: 1; visibility: visible; }
  /* шапка над затемнением — своим фоном, иначе над фото первого экрана она прозрачная */
  .header.is-menu-open { background: var(--color-ink); }
  .mega-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-32) var(--sp-48);
  }
  .mega-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-16);
    margin-inline: calc(var(--sp-8) * -1);
    padding: 4px var(--sp-8) var(--sp-12);
    border-radius: var(--r-row);
    transition: background-color var(--t-hover-out) var(--ease-out);
  }
  .mega-head:hover { background: var(--color-row-hover-dark); transition-duration: var(--t-hover-in); }
  .mega-title {
    font-size: var(--text-body-lg);
    font-weight: var(--w-semibold);
    letter-spacing: -0.02em;
  }
  .mega-count {
    flex: none;
    font-size: var(--text-caption);
    font-weight: var(--w-medium);
  }
  .mega-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
    font-size: var(--text-caption);
  }
  /* Строка под курсором берётся плашкой — тот же приём, что в обороте плашки услуг */
  .mega-list a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-16);
    margin-inline: calc(var(--sp-8) * -1);
    padding: 5px var(--sp-8);
    border-radius: var(--r-row);
    transition: background-color var(--t-hover-out) var(--ease-out);
  }
  .mega-list a:hover,
  .mega-list a:focus-visible {
    background: var(--color-row-hover-dark);
    transition-duration: var(--t-hover-in);
  }
  /* Название услуги крупнее и плотнее цены: в служебном списке это рабочая иерархия */
  .mega-name {
    font-size: var(--text-body);
    font-weight: var(--w-semibold);
    line-height: 1.25;
  }
  .mega-price {
    flex: none;
    font-variant-numeric: tabular-nums;
  }
  .mega-note {
    margin-top: var(--sp-32);
    padding-top: var(--sp-16);
    border-top: 1px solid var(--color-line-white);
    font-size: var(--text-caption);
  }

  .header-phone {
    margin-left: auto;
    font-size: var(--text-body-lg);
    font-weight: var(--w-semibold);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  /* Кнопка обычного кнопочного размера (.btn: 16px, поля 14/24) — не уменьшаем */
  .header-cta { flex: none; }

  @media (max-width: 1240px) {
    .mega-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  /* Телефон и планшет: шапка закреплена — телефон и «Связаться» всегда под пальцем.
     Подложка — чёрный фото hero: над первым экраном шапка не видна как полоса */
  /* Бургер: две линии → крестик */
  .burger {
    display: none;
    position: relative;
    flex: none;
    width: 44px;
    height: 44px;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }
  .burger span {
    position: absolute;
    left: 11px;
    right: 11px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.25s var(--ease-out);
  }
  .burger span:first-child { top: 17px; }
  .burger span:last-child { top: 25px; }
  .header.is-menu-open .burger span:first-child { transform: translateY(4px) rotate(45deg); }
  .header.is-menu-open .burger span:last-child { transform: translateY(-4px) rotate(-45deg); }
  .mega-extra { display: none; }

  @media (max-width: 900px) {
    .nav { display: none; }
    .burger { display: block; }
    /* Мобильное меню выкатывается сверху вниз (шторка): на всю высоту под шапкой,
       своя прокрутка. Колонки категорий — в одну */
    .mega {
      bottom: auto;
      height: calc(100dvh - var(--header-h));
      overflow-y: auto;
      padding: var(--sp-24) var(--gutter) var(--sp-40);
      opacity: 1;
      transform: none;
      clip-path: inset(0 0 100% 0);
      transition: clip-path 0.4s var(--ease-out-expo), visibility 0.4s;
    }
    .header.is-menu-open .mega { clip-path: inset(0 0 0 0); }
    /* Контраст групп — плашками, не линиями (линии между пунктами запрещены правилами):
       направление = плашка, название крупно и тяжело, пункты крупнее, чем на десктопе */
    .mega-grid { grid-template-columns: minmax(0, 1fr); gap: var(--sp-8); }
    .mega-col {
      padding: var(--sp-16) var(--sp-16) var(--sp-12);
      border-radius: var(--r-tile);
      background: var(--color-tile-dark);
    }
    .mega-head { padding-bottom: var(--sp-8); }
    .mega-title { font-size: var(--text-tile); font-weight: var(--w-black); letter-spacing: -0.02em; }
    .mega-list { gap: 0; font-size: var(--text-body); }
    .mega-list a { padding-block: 9px; }
    .mega-name { font-size: var(--text-body-lg); font-weight: var(--w-semibold); }
    .mega-price { font-size: var(--text-body); }
    .mega-note { border-top: 0; margin-top: var(--sp-16); }
    .mega-extra {
      display: grid;
      gap: var(--sp-12);
      margin-top: var(--sp-28);
    }
    .mega-extra-link { font-size: var(--text-subhead); font-weight: var(--w-bold); }
    .mega-extra-phone { margin-top: var(--sp-8); font-size: var(--text-subhead); font-weight: var(--w-bold); }
  }
  @media (max-width: 600px) {
    .header-phone { display: none; }
    .logo { font-size: 1.25rem; }
    .header-cta { margin-left: auto; padding: 12px 20px; }
    .header-inner { gap: var(--sp-8); }
  }
</style>
