---
/* Шапка и меню — по образцу porsche.com (19.10.2026, refs/porsche/STYLE.md).
   Шапка: «Меню» слева, логотип по центру, телефон и «Рассчитать» справа. Закреплена всегда;
   над первым экраном (overlay) — прозрачная, после прокрутки — фон основы.
   Меню — на весь экран, три колонки: направления (белая) → разделы выбранного направления
   с ценой «от» (серая) → размытая страница с круглой кнопкой «закрыть». Направление
   выбирается наведением и кликом. На телефоне — одна колонка, разделы выезжают поверх.
   Ссылки ведут в калькулятор: /calc/?cat=…&sheet=…; на самой /calc/ калькулятор
   перехватывает клик по data-service-id и открывает раздел без перезагрузки. */
import content from '../data/content.json';
import { categories } from '../lib/catalog.js';
import { url } from '../lib/paths.js';
import { typo } from '../lib/typo.js';
// light — светлая шапка для страниц с белым верхом (калькулятор): тёмная дымка на белом
// выглядела серой полосой-«переходом». Постоянная, без анимации и инверсии по прокрутке.
// solid — страницы услуг (19.10.2026): сплошной чёрный фон, белые знаки, без дымки — светлый
// верх и тёмный низ под одной шапкой; дымка на такой странице висела белой полосой над чёрным
const { overlay = false, light = false, solid = false } = Astro.props;
const { contacts, brand, nav, services } = content;
const calc = url('/calc/');
const icon = {
  menu: '<path d="M3 6h14M3 10h14M3 14h14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>',
  chevron: '<path d="m8 5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>',
  back: '<path d="m12 5-5 5 5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>',
  close: '<path d="m5 5 10 10M15 5 5 15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>',
};
---

<header class:list={['header', overlay && 'header--overlay', solid && 'header--solid', light ? 'header--light' : 'on-dark']} id="header">
  <div class="container header-inner">
    <button class="menu-btn" type="button" id="menu-open" aria-expanded="false" aria-controls="site-menu">
      <svg viewBox="0 0 20 20" aria-hidden="true" set:html={icon.menu} />
      <span class="menu-btn-label">Меню</span>
    </button>
    <a class="logo brand-logo" href={url('/')} aria-label={brand.name}>{brand.name}</a>
    <div class="header-end">
      <a class="header-phone" href={`tel:${contacts.phoneHref}`}>{contacts.phone}</a>
      <a class="btn btn--glass header-cta" href={calc}>Рассчитать</a>
      <!-- телефон: вместо «Рассчитать» — круглая кнопка звонка (логотип широкий, места нет) -->
      <a class="round-glass header-call" href={`tel:${contacts.phoneHref}`} aria-label={`Позвонить: ${contacts.phone}`}>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M6.6 3.5 4.8 3.6c-.7.1-1.3.7-1.3 1.4 0 6.4 5.1 11.5 11.5 11.5.7 0 1.3-.6 1.4-1.3l.1-1.8-3.2-1.4-1.6 1.6a9.6 9.6 0 0 1-4.9-4.9l1.6-1.6z" fill="currentColor" stroke="currentColor" stroke-width="1" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </div>
</header>

<div class="menu" id="site-menu" aria-hidden="true" data-menu>
  <nav class="menu-main" aria-label="Направления">
    <!-- логотип в открытом меню — шапка под ним закрыта (19.10.2026) -->
    <a class="menu-logo brand-logo" href={url('/')} aria-label={brand.name}>{brand.name}</a>
    <ul class="menu-cats">
      {categories.map((c, i) => (
        <li>
          <button class:list={['menu-cat', i === 0 && 'is-active']} type="button" data-menu-cat={c.id} aria-controls={`menu-panel-${c.id}`}>
            <span>{c.title}</span>
            <svg viewBox="0 0 20 20" aria-hidden="true" set:html={icon.chevron} />
          </button>
        </li>
      ))}
    </ul>
    <!-- Низ меню — один блок, прижат к низу колонки: навигация по странице мелко,
         ниже связь — телефон крупно, адрес и часы, мессенджеры (19.10.2026) -->
    <ul class="menu-links">
      {nav.map((item) => <li><a class="menu-link" href={url('/') + item.href}>{item.label}</a></li>)}
    </ul>
    <!-- прибит к низу колонки: только связь (19.10.2026) -->
    <div class="menu-extra">
      <div class="menu-contact">
        <a class="menu-phone" href={`tel:${contacts.phoneHref}`}>{contacts.phone}</a>
        <p>{typo(contacts.address)}</p>
        <p>{typo(contacts.hours)}</p>
        <div class="menu-msg">
          <a class="btn btn--glass" href={`https://wa.me/${contacts.whatsappHref}`} target="_blank" rel="noopener">WhatsApp</a>
          <a class="btn btn--glass" href={`https://t.me/${contacts.telegram}`} target="_blank" rel="noopener">Telegram</a>
        </div>
      </div>
    </div>
  </nav>

  <div class="menu-sub">
    {categories.map((c, i) => (
      <section class="menu-panel" id={`menu-panel-${c.id}`} data-menu-panel={c.id} hidden={i !== 0}>
        <button class="menu-back" type="button" data-menu-back>
          <svg viewBox="0 0 20 20" aria-hidden="true" set:html={icon.back} />
          Все направления
        </button>
        <ul class="menu-items">
          {c.items.map((s) => (
            <li>
              <a href={`${calc}?cat=${c.id}&sheet=${s.id}`} data-service={s.title} data-service-id={s.id}>
                <span class="menu-item-name">{s.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <div class="menu-veil" data-menu-close>
    <button class="round-glass menu-close" type="button" aria-label="Закрыть меню" data-menu-close>
      <svg viewBox="0 0 20 20" aria-hidden="true" set:html={icon.close} />
    </button>
  </div>
</div>

<script>
  const menu = document.getElementById('site-menu')!;
  const openBtn = document.getElementById('menu-open')!;
  const cats = [...menu.querySelectorAll<HTMLButtonElement>('[data-menu-cat]')];
  const panels = [...menu.querySelectorAll<HTMLElement>('[data-menu-panel]')];

  /* Шапка над первым экраном прозрачная; после прокрутки — фон основы */
  /* Шапка видна всегда и не меняется (19.10.2026: прятать при прокрутке пробовали —
     «она всегда должна быть») */
  // keyboard — меню открыли с клавиатуры: тогда фокус на первый пункт. Пальцем и мышью — нет,
  // иначе Safari рисовал синюю рамку фокуса вокруг «Мойки и ухода» (19.10.2026)
  const setMenu = (open: boolean, keyboard = false) => {
    menu.classList.toggle('is-open', open);
    menu.setAttribute('aria-hidden', String(!open));
    openBtn.setAttribute('aria-expanded', String(open));
    document.documentElement.style.overflow = open ? 'hidden' : '';
    if (!open) menu.classList.remove('is-sub');
    else if (keyboard) (menu.querySelector<HTMLElement>('.menu-cat.is-active') ?? cats[0])?.focus({ preventScroll: true });
  };
  const show = (id: string) => {
    cats.forEach((b) => b.classList.toggle('is-active', b.dataset.menuCat === id));
    panels.forEach((p) => (p.hidden = p.dataset.menuPanel !== id));
  };

  // detail === 0 — «клик» с клавиатуры (Enter/пробел), а не пальцем или мышью
  openBtn.addEventListener('click', (e) => setMenu(true, (e as MouseEvent).detail === 0));
  menu.querySelectorAll('[data-menu-close]').forEach((el) =>
    el.addEventListener('click', (e) => { if (e.target === el || el.matches('button')) setMenu(false); }),
  );
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && menu.classList.contains('is-open')) { setMenu(false); openBtn.focus(); } });

  /* Направление: наведение (где есть курсор) и клик. На телефоне клик открывает разделы поверх */
  const canHover = matchMedia('(hover: hover) and (min-width: 901px)');
  cats.forEach((b) => {
    b.addEventListener('pointerenter', () => { if (canHover.matches) show(b.dataset.menuCat!); });
    b.addEventListener('click', () => { show(b.dataset.menuCat!); menu.classList.add('is-sub'); });
  });
  menu.querySelectorAll('[data-menu-back]').forEach((b) => b.addEventListener('click', () => menu.classList.remove('is-sub')));
  // любая ссылка закрывает меню (на /calc/ калькулятор сам откроет раздел)
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
</script>

<style>
  /* ---------- Шапка ---------- */
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    color: var(--color-white);
  }
  /* Без сплошной заливки (19.10.2026: «шапка всё ещё залита… линейным градиентом
     затемнить»): всегда — затемнение сверху вниз до прозрачного, на любом фоне под ней.
     Высота затемнения — ручка --scrim-top-h в global.css */
  .header::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    height: calc(var(--scrim-top-h) * 1.35);
    /* 16 ступеней по сглаженной кривой — без видимых границ перехода (их fade-dark) */
    background: linear-gradient(to bottom,
      rgba(1, 2, 5, 0.85) 0%, rgba(1, 2, 5, 0.839) 8.1%, rgba(1, 2, 5, 0.808) 15.5%,
      rgba(1, 2, 5, 0.762) 22.5%, rgba(1, 2, 5, 0.701) 29%, rgba(1, 2, 5, 0.63) 35.3%,
      rgba(1, 2, 5, 0.551) 41.2%, rgba(1, 2, 5, 0.468) 47.1%, rgba(1, 2, 5, 0.383) 52.9%,
      rgba(1, 2, 5, 0.299) 58.8%, rgba(1, 2, 5, 0.22) 64.7%, rgba(1, 2, 5, 0.149) 71%,
      rgba(1, 2, 5, 0.088) 77.5%, rgba(1, 2, 5, 0.042) 84.5%, rgba(1, 2, 5, 0.011) 91.9%,
      rgba(1, 2, 5, 0) 100%);
    pointer-events: none;
  }
  /* Шапка одна на любом фоне: белые знаки и тёмная дымка. Инверсию над светлыми секциями
     пробовали 19.10.2026 — «слишком много эффектов», снято.
     Исключение — страница с белым верхом (header--light): тёмные знаки, белая дымка той же кривой */
  .header--light { color: var(--color-ink); }
  .header--light::before {
    background: linear-gradient(to bottom,
      rgba(255, 255, 255, 0.92) 0%, rgba(255, 255, 255, 0.91) 8.1%, rgba(255, 255, 255, 0.876) 15.5%,
      rgba(255, 255, 255, 0.826) 22.5%, rgba(255, 255, 255, 0.76) 29%, rgba(255, 255, 255, 0.683) 35.3%,
      rgba(255, 255, 255, 0.597) 41.2%, rgba(255, 255, 255, 0.507) 47.1%, rgba(255, 255, 255, 0.415) 52.9%,
      rgba(255, 255, 255, 0.324) 58.8%, rgba(255, 255, 255, 0.238) 64.7%, rgba(255, 255, 255, 0.161) 71%,
      rgba(255, 255, 255, 0.095) 77.5%, rgba(255, 255, 255, 0.046) 84.5%, rgba(255, 255, 255, 0.012) 91.9%,
      rgba(255, 255, 255, 0) 100%);
  }
  .header--light .round-glass,
  .header--light .btn--glass { background: var(--glass-light); color: var(--color-ink); }
  .header--light .round-glass:hover,
  .header--light .btn--glass:hover { background: var(--glass-light-hover); }
  .header--light .menu-btn:hover { background: var(--glass-light); }

  /* solid — сплошная чёрная полоса вместо дымки (страницы услуг, 19.10.2026) */
  .header--solid { background: var(--color-ink); }
  .header--solid::before { display: none; }
  .header-inner {
    height: var(--header-h);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: var(--sp-16);
  }
  /* «Меню»: иконка + слово, наведение — плашка-стекло */
  .menu-btn {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: var(--sp-8);
    margin-left: -12px;
    padding: 8px 12px;
    border: 0;
    border-radius: var(--r-row);
    background: none;
    color: inherit;
    font-size: var(--text-body);
    cursor: pointer;
    transition: background-color var(--t-hover-out) var(--ease-out);
  }
  .menu-btn:hover { background: var(--glass-dark); transition-duration: var(--t-hover-in); }
  .menu-btn svg { width: 20px; height: 20px; }
  .logo { font-size: 1.375rem; }
  .header-end {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: var(--sp-24);
  }
  .header-phone { font-size: var(--text-body); white-space: nowrap; }
  .header-cta { padding: 10px 20px; }

  /* ---------- Меню ---------- */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    grid-template-columns: minmax(300px, 32%) minmax(320px, 32%) minmax(0, 1fr);
    visibility: hidden;
    pointer-events: none;
  }
  .menu.is-open { visibility: visible; pointer-events: auto; }
  .menu-main,
  .menu-sub {
    overflow-y: auto;
    overscroll-behavior: contain;
    opacity: 0;
    transform: translateX(-24px);
    transition: opacity 0.4s var(--ease-porsche), transform 0.4s var(--ease-porsche);
  }
  .menu.is-open .menu-main,
  .menu.is-open .menu-sub { opacity: 1; transform: none; }
  .menu.is-open .menu-sub { transition-delay: 0.05s; }

  /* Колонка 1 — направления на белом */
  .menu-main {
    display: flex;
    flex-direction: column;
    gap: var(--sp-40);
    padding: 88px 36px 36px;
    background: var(--color-page);
    color: var(--color-ink);
  }
  .menu-main { position: relative; }
  /* Логотип — в верхнем поле колонки, кегль как в шапке; по высоте — на линии кнопки «закрыть» */
  .menu-logo {
    position: absolute;
    top: 52px;              /* центр круглой «закрыть» (верх 20 + 64/2) */
    left: 48px;
    font-size: 1.375rem;
    line-height: 1;
    transform: translateY(-50%);
  }
  .menu-cats { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .menu-cat {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-16);
    padding: 14px 12px;
    border: 0;
    border-radius: var(--r-input);
    background: none;
    color: inherit;
    font-size: var(--text-lead);
    text-align: left;
    cursor: pointer;
    transition: background-color var(--t-hover-out) var(--ease-out);
  }
  .menu-cat svg { flex: none; width: 20px; height: 20px; }
  /* их цвета: пункт на белом подсвечивается почти белым серым */
  .menu-cat:hover,
  .menu-cat.is-active { background: var(--row-hover-light); transition-duration: var(--t-hover-in); }
  /* Ссылки по странице — чипами под направлениями, листаются вместе с ними */
  .menu-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-8);
  }
  /* Связь — прижата к низу колонки и прибита (sticky): всё выше при прокрутке уходит под неё,
     растворяясь в белом (--menu-fade) */
  .menu-extra {
    --menu-fade: 48px;
    position: sticky;
    bottom: 0;
    margin-top: auto;
    margin-bottom: -36px;               /* до самого низа колонки, поверх её нижнего поля */
    padding: var(--menu-fade) 0 36px;
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0), var(--color-page) var(--menu-fade));
  }
  /* ссылки по странице — серые плашки-чипы (19.10.2026) */
  .menu-link {
    display: inline-block;
    padding: 8px 16px;
    border-radius: var(--r-full);
    background: var(--color-tile);
    font-size: var(--text-body);
    transition: background-color var(--t-hover-out) var(--ease-out);
  }
  .menu-link:hover { background: var(--color-tile-hover); transition-duration: var(--t-hover-in); }
  .menu-contact { display: grid; justify-items: start; gap: var(--sp-4); font-size: var(--text-body); }
  .menu-phone {
    font-size: var(--text-tile);
    letter-spacing: var(--track-head);
    line-height: 1.15;
    white-space: nowrap;
    margin-bottom: var(--sp-8);
  }
  .menu-msg { display: flex; flex-wrap: wrap; gap: var(--sp-8); margin-top: var(--sp-16); }
  /* мессенджеры — тот же серый, что чипы ссылок над ними (20.10.2026: «разные оттенки серого»
     — было стекло --glass-light, темнее --color-tile) */
  .menu-msg .btn { padding: 10px 20px; background: var(--color-tile); }
  .menu-msg .btn:hover { background: var(--color-tile-hover); }

  /* Колонка 2 — разделы направления на сером */
  .menu-sub {
    padding: 88px 36px 36px;
    background: var(--color-tile);
    color: var(--color-ink);
  }
  .menu-panel { display: flex; flex-direction: column; gap: var(--sp-16); min-height: 100%; }
  /* своё display перебивает атрибут hidden — без этого видны разделы всех направлений сразу */
  .menu-panel[hidden] { display: none; }
  .menu-back { display: none; }
  /* Пункты — крупно, как в первой колонке; под курсором — серое «стекло» (их frosted) */
  .menu-items { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .menu-items a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-16);
    padding: 12px 14px;
    margin-inline: -14px;
    border-radius: var(--r-input);
    font-size: var(--text-lead);
    transition: background-color var(--t-hover-out) var(--ease-out);
  }
  .menu-items a:hover,
  .menu-items a:focus-visible { background: var(--glass-light); transition-duration: var(--t-hover-in); }
  .menu-item-name { line-height: 1.3; }
  /* Цены «от» и сноска к ним в меню сняты 20.10.2026 («здесь уберём цены»): цена — на
     странице направления и в калькуляторе, меню — только навигация */

  /* Колонка 3 — страница под размытием, круглая кнопка «закрыть» */
  /* Без размытия — только затемнение (19.10.2026: размытие тормозило ноутбук) */
  .menu-veil {
    position: relative;
    background: rgba(1, 2, 5, 0.55);
    opacity: 0;
    transition: opacity 0.3s var(--ease-porsche);
    will-change: opacity;
    cursor: pointer;
  }
  .menu.is-open .menu-veil { opacity: 1; }
  /* «Закрыть» — белый круг с чёрным крестиком: «стекло» на затемнении без размытия
     выглядело мутным серым пятном (19.10.2026) */
  .menu-close {
    position: absolute;
    top: 20px;
    left: 24px;
    width: 64px;
    height: 64px;
    background: var(--color-page);
    color: var(--color-ink);
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
  .menu-close:hover { background: var(--color-tile); }

  /* ---------- Планшет и телефон: одна колонка, разделы выезжают поверх ---------- */
  @media (max-width: 900px) {
    .menu { grid-template-columns: minmax(0, 1fr); }
    .menu-main,
    .menu-sub { grid-area: 1 / 1; padding: 80px var(--gutter) var(--sp-32); }
    /* свой слой поверх колонки направлений: иначе прибитый (sticky) блок связи оттуда
       рисовался поверх выехавших разделов белой плашкой (19.10.2026) */
    .menu-sub { position: relative; z-index: 1; visibility: hidden; transition: transform 0.4s var(--ease-porsche), visibility 0.4s; }
    .menu-sub,
    .menu.is-open .menu-sub { opacity: 1; transform: translateX(100%); }
    .menu.is-open.is-sub .menu-sub { transform: none; visibility: visible; }
    .menu-veil { position: fixed; inset: 0 0 auto auto; width: 0; height: 0; background: none; backdrop-filter: none; }
    .menu-close { position: fixed; top: 12px; right: var(--gutter); left: auto; background: var(--color-tile); color: var(--color-ink); width: 48px; height: 48px; z-index: 1; }
    .menu-back {
      display: inline-flex;
      align-items: center;
      gap: var(--sp-8);
      align-self: flex-start;   /* колонка — flex: без этого кнопка тянется во всю ширину */
      padding: 8px 12px 8px 6px;
      margin-left: -6px;
      border: 0;
      border-radius: var(--r-row);
      background: var(--color-page);
      color: inherit;
      font-size: var(--text-body);
      cursor: pointer;
    }
    .menu-back svg { width: 20px; height: 20px; }
    .menu-cat.is-active { background: none; }
    /* телефон: связь не прибита — на высоте экрана телефона прибитый блок закрывал чипы
