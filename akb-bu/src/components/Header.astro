---
/* Шапка и меню — по образцу porsche.com (19.10.2026, refs/porsche/STYLE.md).
   Шапка: «Меню» слева, логотип по центру, телефон и «Рассчитать» справа. Закреплена всегда;
   над первым экраном (overlay) — прозрачная, после прокрутки — фон основы.
   Меню — на весь экран, три колонки: направления (белая) → разделы выбранного направления
   с ценой «от» (серая) → размытая страница с круглой кнопкой «закрыть». Направление
   выбирается наведением и кликом. На телефоне — одна колонка, разделы выезжают поверх.
   Ссылки ведут в калькулятор: /calc/?cat=…&sheet=…; на самой /calc/ калькулятор
   перехватывает клик по data-service-id и открывает раздел без перезагрузки. */
import content from '../data/content.json';
import { categories, rub } from '../lib/catalog.js';
import { url } from '../lib/paths.js';
const { overlay = false } = Astro.props;
const { contacts, brand, nav, services } = content;
const calc = url('/calc/');
const icon = {
  menu: '<path d="M3 6h14M3 10h14M3 14h14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>',
  chevron: '<path d="m8 5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>',
  back: '<path d="m12 5-5 5 5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>',
  close: '<path d="m5 5 10 10M15 5 5 15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>',
};
---

<header class:list={['header', overlay && 'header--overlay', 'on-dark']} id="header">
  <div class="container header-inner">
    <button class="menu-btn" type="button" id="menu-open" aria-expanded="false" aria-controls="site-menu">
      <svg viewBox="0 0 20 20" aria-hidden="true" set:html={icon.menu} />
      <span class="menu-btn-label">Меню</span>
    </button>
    <a class="logo brand-logo" href={url('/')} aria-label={brand.name}>{brand.name}</a>
    <div class="header-end">
      <a class="header-phone" href={`tel:${contacts.phoneHref}`}>{contacts.phone}</a>
      <a class="btn btn--glass header-cta" href={calc}>Рассчитать</a>
      <!-- телефон: вместо «Рассчитать» — круглая кнопка звонка (логотип широкий, места нет) -->
      <a class="round-glass header-call" href={`tel:${contacts.phoneHref}`} aria-label={`Позвонить: ${contacts.phone}`}>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M6.6 3.5 4.8 3.6c-.7.1-1.3.7-1.3 1.4 0 6.4 5.1 11.5 11.5 11.5.7 0 1.3-.6 1.4-1.3l.1-1.8-3.2-1.4-1.6 1.6a9.6 9.6 0 0 1-4.9-4.9l1.6-1.6z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </div>
</header>

<div class="menu" id="site-menu" aria-hidden="true" data-menu>
  <nav class="menu-main" aria-label="Направления">
    <ul class="menu-cats">
      {categories.map((c, i) => (
        <li>
          <button class:list={['menu-cat', i === 0 && 'is-active']} type="button" data-menu-cat={c.id} aria-controls={`menu-panel-${c.id}`}>
            <span>{c.title}</span>
            <svg viewBox="0 0 20 20" aria-hidden="true" set:html={icon.chevron} />
          </button>
        </li>
      ))}
    </ul>
    <div class="menu-extra">
      {nav.map((item) => <a class="menu-link" href={url('/') + item.href}>{item.label}</a>)}
      <a class="menu-link menu-phone" href={`tel:${contacts.phoneHref}`}>{contacts.phone}</a>
    </div>
  </nav>

  <div class="menu-sub">
    {categories.map((c, i) => (
      <section class="menu-panel" id={`menu-panel-${c.id}`} data-menu-panel={c.id} hidden={i !== 0}>
        <button class="menu-back" type="button" data-menu-back>
          <svg viewBox="0 0 20 20" aria-hidden="true" set:html={icon.back} />
          Все направления
        </button>
        <ul class="menu-items">
          {c.items.map((s) => (
            <li>
              <a href={`${calc}?cat=${c.id}&sheet=${s.id}`} data-service={s.title} data-service-id={s.id}>
                <span class="menu-item-name">{s.title}</span>
                {s.from != null && <span class="menu-item-price">от {rub(s.from)}</span>}
              </a>
            </li>
          ))}
        </ul>
        <p class="menu-note">{services.menuNote}</p>
      </section>
    ))}
  </div>

  <div class="menu-veil" data-menu-close>
    <button class="round-glass menu-close" type="button" aria-label="Закрыть меню" data-menu-close>
      <svg viewBox="0 0 20 20" aria-hidden="true" set:html={icon.close} />
    </button>
  </div>
</div>

<script>
  const header = document.getElementById('header')!;
  const menu = document.getElementById('site-menu')!;
  const openBtn = document.getElementById('menu-open')!;
  const cats = [...menu.querySelectorAll<HTMLButtonElement>('[data-menu-cat]')];
  const panels = [...menu.querySelectorAll<HTMLElement>('[data-menu-panel]')];

  /* Шапка над первым экраном прозрачная; после прокрутки — фон основы */
  const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setMenu = (open: boolean) => {
    menu.classList.toggle('is-open', open);
    menu.setAttribute('aria-hidden', String(!open));
    openBtn.setAttribute('aria-expanded', String(open));
    document.documentElement.style.overflow = open ? 'hidden' : '';
    if (!open) menu.classList.remove('is-sub');
    else (menu.querySelector<HTMLElement>('.menu-cat.is-active') ?? cats[0])?.focus({ preventScroll: true });
  };
  const show = (id: string) => {
    cats.forEach((b) => b.classList.toggle('is-active', b.dataset.menuCat === id));
    panels.forEach((p) => (p.hidden = p.dataset.menuPanel !== id));
  };

  openBtn.addEventListener('click', () => setMenu(true));
  menu.querySelectorAll('[data-menu-close]').forEach((el) =>
    el.addEventListener('click', (e) => { if (e.target === el || el.matches('button')) setMenu(false); }),
  );
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && menu.classList.contains('is-open')) { setMenu(false); openBtn.focus(); } });

  /* Направление: наведение (где есть курсор) и клик. На телефоне клик открывает разделы поверх */
  const canHover = matchMedia('(hover: hover) and (min-width: 901px)');
  cats.forEach((b) => {
    b.addEventListener('pointerenter', () => { if (canHover.matches) show(b.dataset.menuCat!); });
    b.addEventListener('click', () => { show(b.dataset.menuCat!); menu.classList.add('is-sub'); });
  });
  menu.querySelectorAll('[data-menu-back]').forEach((b) => b.addEventListener('click', () => menu.classList.remove('is-sub')));
  // любая ссылка закрывает меню (на /calc/ калькулятор сам откроет раздел)
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
</script>

<style>
  /* ---------- Шапка ---------- */
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    color: var(--color-white);
  }
  /* Без сплошной заливки (19.10.2026: «шапка всё ещё залита… линейным градиентом
     затемнить»): всегда — затемнение сверху вниз до прозрачного, на любом фоне под ней.
     Высота затемнения — ручка --scrim-top-h в global.css */
  .header::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    height: var(--scrim-top-h);
    background: linear-gradient(to bottom, rgba(1, 2, 5, 0.85) 0%, rgba(1, 2, 5, 0.6) 45%, rgba(1, 2, 5, 0) 100%);
    pointer-events: none;
  }
  .header-inner {
    height: var(--header-h);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: var(--sp-16);
  }
  /* «Меню»: иконка + слово, наведение — плашка-стекло */
  .menu-btn {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: var(--sp-8);
    margin-left: -12px;
    padding: 8px 12px;
    border: 0;
    border-radius: var(--r-row);
    background: none;
    color: inherit;
    font-size: var(--text-body);
    cursor: pointer;
    transition: background-color var(--t-hover-out) var(--ease-out);
  }
  .menu-btn:hover { background: var(--glass-dark); transition-duration: var(--t-hover-in); }
  .menu-btn svg { width: 20px; height: 20px; }
  .logo { font-size: 1.375rem; }
  .header-end {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: var(--sp-24);
  }
  .header-phone { font-size: var(--text-body); white-space: nowrap; }
  .header-cta { padding: 10px 20px; }

  /* ---------- Меню ---------- */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    grid-template-columns: minmax(300px, 32%) minmax(320px, 32%) minmax(0, 1fr);
    visibility: hidden;
    pointer-events: none;
  }
  .menu.is-open { visibility: visible; pointer-events: auto; }
  .menu-main,
  .menu-sub {
    overflow-y: auto;
    overscroll-behavior: contain;
    opacity: 0;
    transform: translateX(-24px);
    transition: opacity 0.4s var(--ease-porsche), transform 0.4s var(--ease-porsche);
  }
  .menu.is-open .menu-main,
  .menu.is-open .menu-sub { opacity: 1; transform: none; }
  .menu.is-open .menu-sub { transition-delay: 0.05s; }

  /* Колонка 1 — направления на белом */
  .menu-main {
    display: flex;
    flex-direction: column;
    gap: var(--sp-40);
    padding: 88px 36px 36px;
    background: var(--color-page);
    color: var(--color-ink);
  }
  .menu-cats { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .menu-cat {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-16);
    padding: 14px 12px;
    border: 0;
    border-radius: var(--r-input);
    background: none;
    color: inherit;
    font-size: var(--text-lead);
    text-align: left;
    cursor: pointer;
    transition: background-color var(--t-hover-out) var(--ease-out);
  }
  .menu-cat svg { flex: none; width: 20px; height: 20px; }
  /* их цвета: пункт на белом подсвечивается почти белым серым */
  .menu-cat:hover,
  .menu-cat.is-active { background: var(--row-hover-light); transition-duration: var(--t-hover-in); }
  .menu-extra { margin-top: auto; display: grid; gap: 4px; }
  .menu-link {
    padding: 14px 12px;
    border-radius: var(--r-input);
    font-size: var(--text-lead);
    transition: background-color var(--t-hover-out) var(--ease-out);
  }
  .menu-link:hover { background: var(--row-hover-light); transition-duration: var(--t-hover-in); }

  /* Колонка 2 — разделы направления на сером */
  .menu-sub {
    padding: 88px 36px 36px;
    background: var(--color-tile);
    color: var(--color-ink);
  }
  .menu-panel { display: grid; gap: var(--sp-16); align-content: start; }
  /* своё display перебивает атрибут hidden — без этого видны разделы всех направлений сразу */
  .menu-panel[hidden] { display: none; }
  .menu-back { display: none; }
  /* Пункты — крупно, как в первой колонке; под курсором — серое «стекло» (их frosted) */
  .menu-items { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .menu-items a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-16);
    padding: 12px 14px;
    margin-inline: -14px;
    border-radius: var(--r-input);
    font-size: var(--text-lead);
    transition: background-color var(--t-hover-out) var(--ease-out);
  }
  .menu-items a:hover,
  .menu-items a:focus-visible { background: var(--glass-light); transition-duration: var(--t-hover-in); }
  .menu-item-name { line-height: 1.3; }
  .menu-item-price { flex: none; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .menu-note { margin-top: var(--sp-8); font-size: var(--text-caption); }

  /* Колонка 3 — страница под размытием, круглая кнопка «закрыть» */
  .menu-veil {
    position: relative;
    background: var(--backdrop);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    opacity: 0;
    transition: opacity 0.4s var(--ease-porsche);
    cursor: pointer;
  }
  .menu.is-open .menu-veil { opacity: 1; }
  .menu-close { position: absolute; top: 20px; left: 24px; width: 64px; height: 64px; }

  /* ---------- Планшет и телефон: одна колонка, разделы выезжают поверх ---------- */
  @media (max-width: 900px) {
    .menu { grid-template-columns: minmax(0, 1fr); }
    .menu-main,
    .menu-sub { grid-area: 1 / 1; padding: 80px var(--gutter) var(--sp-32); }
    .menu-sub { visibility: hidden; transition: transform 0.4s var(--ease-porsche), visibility 0.4s; }
    .menu-sub,
    .menu.is-open .menu-sub { opacity: 1; transform: translateX(100%); }
    .menu.is-open.is-sub .menu-sub { transform: none; visibility: visible; }
    .menu-veil { position: fixed; inset: 0 0 auto auto; width: 0; height: 0; background: none; backdrop-filter: none; }
    .menu-close { position: fixed; top: 12px; right: var(--gutter); left: auto; background: var(--color-tile); color: var(--color-ink); width: 48px; height: 48px; z-index: 1; }
    .menu-back {
      display: inline-flex;
      align-items: center;
      gap: var(--sp-8);
      justify-self: start;
      padding: 8px 12px 8px 6px;
      margin-left: -6px;
      border: 0;
      border-radius: var(--r-row);
      background: var(--color-page);
      color: inherit;
      font-size: var(--text-body);
      cursor: pointer;
    }
    .menu-back svg { width: 20px; height: 20px; }
    .menu-cat.is-active { background: none; }
  }
  .header-call { display: none; }
  @media (max-width: 600px) {
    .header-phone, .menu-btn-label, .header-cta { display: none; }
    .header-call { display: inline-grid; }
    .logo { font-size: 1.05rem; }
  }
</style>
