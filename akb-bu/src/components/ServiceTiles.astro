---
/* Плашки категорий услуг. Лицо — название и цена «от», оборот по наведению —
   мини-прайс со ссылками на услуги. Одна категория (wide в content.json) — крупная 2×2.
   Призыв «Не знаете, с чего начать?» — отдельным блоком под сеткой, без плашки.
   Данные считаются из прайса в lib/catalog.js, руками цены не проставляем. */
import { categories, rub, plural } from '../lib/catalog.js';
import { asset } from '../lib/paths.js';

const { cta, more, href = '#contacts' } = Astro.props;
---

<div class="tiles">
  {categories.map((c) => (
    <article
      class:list={['tile', c.media && 'tile--media', c.wide && 'tile--wide']}
      id={`cat-${c.id}`}
      data-tile
    >
      {c.media && <img class="tile-bg" src={asset(c.media)} alt="" loading="lazy" />}
      <div class="tile-front">
        <div class="tile-top">
          <span class="chip">{c.tag}</span>
          <span class="tile-count">{c.count} {plural(c.count)}</span>
        </div>
        <div class="tile-headline">
          <h3 class="tile-title">{c.title}</h3>
          <p class="tile-price">от {rub(c.from)}</p>
        </div>
      </div>
      <div class="tile-back">
        <p class="tile-back-title">{c.title}</p>
        <ul class="tile-list">
          {c.items.map((s) => (
            <li>
              <a href={href} data-service={s.title} data-service-id={s.id}>
                <span class="tile-item-name">{s.title}</span>
                <span class="tile-item-price">от {rub(s.from)}</span>
              </a>
            </li>
          ))}
        </ul>
        <a class="btn btn--ghost tile-more" href={href}>{more}</a>
      </div>
    </article>
  ))}

</div>

{cta && (
  <div class="tiles-cta">
    <div class="tiles-cta-text">
      <h3 class="tiles-cta-title">{cta.title}</h3>
      <p>{cta.text}</p>
    </div>
    <a class="btn btn--primary" href={href}>{cta.button}</a>
  </div>
)}

<script>
  /* Тап по плашке на тач-экране: открыть оборот / закрыть. Ссылки внутри открытого
     оборота работают как обычно; открытой может быть только одна плашка */
  const tiles = document.querySelectorAll('.tile[data-tile]');
  tiles.forEach((tile) => {
    tile.addEventListener('click', (e) => {
      if (!matchMedia('(hover: none)').matches) return; // с курсором хватает наведения
      const open = tile.classList.contains('is-open');
      if (open && e.target.closest('a')) return;
      e.preventDefault();
      tiles.forEach((t) => t !== tile && t.classList.remove('is-open'));
      tile.classList.toggle('is-open', !open);
      if (!open && tile.getBoundingClientRect().top < 0) {
        tile.scrollIntoView({ block: 'start' });
      }
    });
  });
</script>

<style>
  /* Плашки услуг: 3 колонки, квадраты. Крупная плашка — 2×2 в левом верхнем углу,
     остальные пять обтекают её: 4 + 5 клеток = ровно 3 ряда по 3, без дыр */
  .tiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: var(--sp-12);
  }
  .tile {
    position: relative;
    overflow: hidden;
    /* Пропорция — переменной: её же держит раскрытый на таче оборот как минимальную */
    --tile-ratio: 1;
    aspect-ratio: var(--tile-ratio);
    border-radius: var(--r-tile);
    background: var(--color-tile-dark);
    color: var(--color-white);
    /* переход из меню: якорь не должен уезжать под фиксированную шапку */
    scroll-margin-top: calc(var(--header-h) + var(--sp-24));
  }
  .tile--wide { grid-column: 1 / span 2; grid-row: 1 / span 2; aspect-ratio: auto; }
  .tile-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tile-front {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--sp-20);
  }
  .tile-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--sp-8);
  }
  .tile-count { font-size: var(--text-caption); font-weight: var(--w-medium); }
  .tile-headline { display: grid; gap: var(--sp-8); }
  .tile-title {
    font-size: var(--text-tile);
    max-width: 10ch;
  }
  /* Цена «от» — витринный ярлык, а не наборный текст: отсюда вес и табличные цифры */
  .tile-price {
    font-size: var(--text-body-lg);
    font-weight: var(--w-medium);
    font-variant-numeric: tabular-nums;
  }
  .tile--media .tile-title,
  .tile--media .tile-price { text-shadow: 0 1px 24px rgba(0, 0, 0, 0.4); }

  /* Оборот плашки — тёмная панель своего оттенка, чтобы не сливалась с полосой. Без трансформов:
     просто кроссфейд, чтобы кромка второго слоя не просвечивала на скруглённых углах */
  .tile-back {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: var(--sp-20);
    background: var(--color-tile-back);
    color: var(--color-white);
    opacity: 0;
    transition: opacity 0.2s var(--ease-out);
  }
  /* На обороте лицо плашки скрыто — название категории повторяем меткой.
     Список идёт сразу под ней, ссылка прижата к низу */
  /* Заголовок оборота — самый крупный элемент карточки: он держит,
     о какой категории список, и читается раньше строк прайса */
  .tile-back-title {
    font-size: var(--text-subhead);
    font-weight: var(--w-semibold);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: var(--sp-16);
  }
  /* Кнопка прижата к низу, но от последней строки прайса всегда отбита */
  .tile-back .tile-more { margin-top: auto; }
  .tile-back .tile-list { margin-bottom: var(--sp-24); }
  /* Раскрытие: наведение (только там, где есть курсор — на тач-экране «липкий» hover
     путает), фокус внутри (клавиатура), клик из меню и тап — .is-open */
  @media (hover: hover) {
    .tile:hover .tile-back { opacity: 1; }
  }
  .tile:focus-within .tile-back,
  .tile.is-open .tile-back { opacity: 1; }
  .tile-back { pointer-events: none; }
  .tile.is-open .tile-back,
  .tile:focus-within .tile-back { pointer-events: auto; }
  @media (hover: hover) {
    .tile:hover .tile-back { pointer-events: auto; }
  }
  .tile[data-tile] { cursor: pointer; }
  .tile-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
    align-content: start;
  }
  /* Строка мини-прайса: название слева, цена справа. Разделительных линий нет —
     под курсором строка целиком берётся плашкой, она же показывает, что это ссылка.
     Отрицательные поля: подсветка шире текста, но левый край остаётся на сетке плашки */
  .tile-list a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-16);
    margin-inline: calc(var(--sp-8) * -1);
    padding: 5px var(--sp-8);
    border-radius: var(--r-row);
    transition: background-color var(--t-hover-out) var(--ease-out);
  }
  .tile-list a:hover,
  .tile-list a:focus-visible { background: var(--color-row-hover-dark); transition-duration: var(--t-hover-in); }
  .tile-item-name { line-height: 1.2; font-weight: var(--w-semibold); }
  .tile-item-price {
    flex: none;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .tile--wide .tile-list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-12) var(--sp-48);
  }
  .tile--wide .tile-list li { font-size: var(--text-body-lg); }
  /* Крупная плашка: строк мало, места много — список и кнопка вместе внизу,
     заголовок наверху. Иначе между списком и кнопкой зияет пустота */
  .tile--wide .tile-list { margin-top: auto; }
  .tile--wide .tile-back .tile-more { margin-top: 0; }
  /* …а фото на обороте не пропадает: сверху просвечивает, к низу уходит в плотный фон
     под прайсом. Лицо плашки при этом прячем, чтобы его подписи не просвечивали */
  .tile--wide.tile--media .tile-back {
    background: linear-gradient(to top,
      var(--color-tile-back) 0%,
      var(--color-tile-back) 40%,
      color-mix(in srgb, var(--color-tile-back) 25%, transparent) 100%);
  }
  .tile--wide.tile--media .tile-back-title { text-shadow: 0 1px 24px rgba(0, 0, 0, 0.4); }
  @media (hover: hover) {
    .tile--wide:hover .tile-front { opacity: 0; }
  }
  .tile--wide:focus-within .tile-front,
  .tile--wide.is-open .tile-front { opacity: 0; }
  /* Переход к заявке — кнопка в ободке, а не текстовая ссылка: на обороте плашки
     это единственное целевое действие, оно должно читаться кнопкой. Заливка остаётся
     за первичной кнопкой в плашке-призыве — здесь вторая ступень иерархии */
  .tile-more {
    align-self: start;
    font-size: var(--text-body);
  }

  /* Призыв — не плашка и не клетка сетки: текст и кнопка отдельной строкой под плашками */
  .tiles-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--sp-24) var(--sp-48);
    margin-top: var(--sp-64);
  }
  .tiles-cta-text { display: grid; gap: var(--sp-12); }
  .tiles-cta-title { font-size: var(--text-tile); }
  .tiles-cta-text p { max-width: var(--measure-lead); font-size: var(--text-body-lg); }

  /* Тач-экраны (телефон, планшет): курсора нет, оборот открывается тапом. Открытая плашка
     вырастает под весь список — оборот встаёт в поток и держит пропорцию закрытой как
     минимум (overflow у него visible, длинный список тянет вниз). Соседи по ряду не
     растягиваются за ней; крупная 2×2 по-прежнему занимает свои два ряда */
  @media (hover: none) {
    .tiles { align-items: start; }
    .tile--wide { align-self: stretch; }
    .tile.is-open,
    .tile.is-open:not(.tile--wide):last-child { aspect-ratio: auto; }
    .tile.is-open .tile-back { position: relative; inset: auto; aspect-ratio: var(--tile-ratio); }
    .tile.is-open .tile-front { opacity: 0; }
  }

  /* Две колонки: крупная — во всю ширину 2:1, остальные пять парами,
     последняя растягивается на ряд — дыры нет */
  @media (max-width: 1100px) {
    .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tile--wide { grid-column: 1 / -1; grid-row: auto; --tile-ratio: 2 / 1; aspect-ratio: var(--tile-ratio); }
    .tile:not(.tile--wide):last-child { grid-column: 1 / -1; --tile-ratio: 2 / 1; }
  }
  /* Телефон: одна колонка в полях контейнера. Все плашки одного вида: лицо 5:4,
     по тапу оборот встаёт в поток и плашка вырастает под весь список — ничего не обрезается */
  @media (max-width: 560px) {
    .tiles { grid-template-columns: 1fr; gap: var(--sp-12); }
    .tile, .tile--wide, .tile:not(.tile--wide):last-child { grid-column: auto; grid-row: auto; --tile-ratio: 5 / 4; }
    /* Узкая колонка: мини-прайс в обороте — одна колонка и базовый кегль */
    .tile--wide .tile-list { grid-template-columns: 1fr; }
    .tile--wide .tile-list li { font-size: var(--text-body); }
    .tile-list a { padding-block: 8px; }
    .tiles-cta { margin-top: var(--sp-48); }
    .tiles-cta-text p { font-size: var(--text-body); }
  }
</style>
