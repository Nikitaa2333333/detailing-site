---
/* Плашки категорий услуг. Лицо — название и цена «от», оборот по наведению —
   мини-прайс со ссылками на услуги. Оборот только там, где есть курсор: на телефоне
   (14.10.2026) переворота нет — тап по плашке открывает её направление в калькуляторе
   (data-calc-cat, обработчик в Calculator.astro). Клик по лицу на десктопе — то же.
   Сетка ровная, все плашки одного размера (14.10.2026: широкие сняты — ряд «широкая + узкая»
   ехал). Число категорий не кратно трём — последний ряд неполный, это нормально.
   Призыв «Не знаете, с чего начать?» — отдельным блоком под сеткой, без плашки.
   Данные считаются из прайса в lib/catalog.js, руками цены не проставляем. */
import { categories, rub } from '../lib/catalog.js';
import { asset, url } from '../lib/paths.js';
import { directionSlug, sectionSlug } from '../lib/pages.js';

/* С 19.10.2026 плашка ведёт на страницу направления, строка оборота — на страницу раздела
   (pages/[slug].astro); калькулятор — оттуда кнопкой «Рассчитать» */
const pageOf = (slug) => (slug ? url(`/${slug}/`) : null);

const { cta, more, href = '#contacts' } = Astro.props;
/* Ряды по две: при наведении карточка расширяется, соседняя сужается (их приём,
   width 560 → 620 за 0.6 с) — для этого у каждого ряда своя флекс-строка */
const rows = [];
for (let i = 0; i < categories.length; i += 2) rows.push(categories.slice(i, i + 2));
---

<div class="tiles">
  {rows.map((row) => (
  <div class="tiles-row">
  {row.map((c) => (
    <div class="tile-cell">
    <article
      class:list={['tile', c.media && 'tile--media']}
      id={`cat-${c.id}`}
      data-tile
      data-calc-cat={c.id}
    >
      {c.media && <img class="tile-bg" src={asset(c.media)} alt="" loading="lazy" />}
      <div class="tile-front">
        <h3 class="tile-title">{c.title}</h3>
        <div class="tile-foot">
          <div class="tile-chips">
            {c.items.slice(0, 3).map((s) => <span class="chip">{s.title}</span>)}
          </div>
          <div class="tile-row">
            <p class="tile-price">от {rub(c.from)}</p>
            <!-- Круглая стрелка; при наведении на плашку раскрывается в «Рассчитать →».
                 Ссылка растянута на всю плашку (::after) — клик в любом месте ведёт в калькулятор -->
            <a class="tile-go" href={pageOf(directionSlug(c.id)) ?? `${href}?cat=${c.id}`} aria-label={`${c.title}: услуги и цены`}>
              <span class="tile-go-label">Услуги и цены</span>
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>
      </div>
      <div class="tile-back">
        <p class="tile-back-title">{c.title}</p>
        <ul class="tile-list">
          {c.items.map((s) => (
            <li>
              <a href={pageOf(sectionSlug(s.id)) ?? href} data-service={s.title} data-service-id={s.id}>
                <span class="tile-item-name">{s.title}</span>
                <span class="tile-item-price">от {rub(s.from)}</span>
              </a>
            </li>
          ))}
        </ul>
        <a class="btn btn--ghost tile-more" href={href}>{more}</a>
      </div>
    </article>
    </div>
  ))}
  </div>
  ))}
</div>
<div class="dots" data-tiles-dots></div>

{cta && (
  <div class="tiles-cta">
    <div class="tiles-cta-text">
      <h3 class="tiles-cta-title">{cta.title}</h3>
      <p>{cta.text}</p>
    </div>
    <a class="btn btn--primary btn--page" href={href}>{cta.button}</a>
  </div>
)}

<style>
  /* Плашки услуг — как карточки моделей на главной porsche.com (19.10.2026): две колонки,
     радиус 32, фото на всю плашку. Пропорция — ручка --tile-ratio (1 / 1 у Porsche; ниже
     5 / 4 не опускать — на обороте должен уместиться мини-прайс с кнопкой) */
  .tiles {
    --tile-gap: var(--sp-16);   /* было 28 — «расстояния уменьшить» (19.10.2026) */
    /* высота плашки — от ширины колонки (квадрат), а не от своей ширины: при наведении
       ширина меняется, высота стоит на месте */
    /* 3:2 (19.10.2026: квадрат на ПК — «очень большие плашки»); крутить 0.6–1 */
    --tile-h: calc((100cqw - var(--tile-gap)) / 2 * 0.66);
    container-type: inline-size;
    display: grid;
    gap: var(--tile-gap);
  }
  .tiles-row { display: flex; gap: var(--tile-gap); }
  /* Расширение карточки при наведении (приём Porsche) снято 19.10.2026: «не нужна» */
  .tile-cell { flex: 1 1 0; min-width: 0; }
  .tile {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    height: var(--tile-h);
    border-radius: var(--r-tile);
    background: var(--gradient-sparks);
    color: var(--color-white);
    /* переход из меню: якорь не должен уезжать под шапку */
    scroll-margin-top: calc(var(--header-h) + var(--sp-24));
  }
  .tile-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Фото «отъезжает» при прокрутке (их приём: scale 1.14 → 1 за время появления) */
  @keyframes tile-zoom {
    from { transform: scale(1.14); }
    to { transform: scale(1); }
  }
  @supports (animation-timeline: view()) {
    .tile-bg { animation: tile-zoom linear both; }
    /* таймлайн — отдельным правилом: минификатор иначе сворачивает его в шорткат,
       который Chrome не парсит (та же история, что в Hero.astro) */
    .tiles .tile-bg { animation-timeline: view(); animation-range: entry 0% cover 45%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tile-bg { animation: none; }
  }
  /* Как у Porsche: верх плашки темнеет под названием (~20% высоты), низ — под чипами и
     ценой (~40%). Те же ступени --scrim, что под шапкой и внизу первого экрана */
  .tile--media::before,
  .tile--media::after {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    height: 22%;
    background: linear-gradient(var(--scrim));
    pointer-events: none;
  }
  .tile--media::after {
    inset: auto 0 0;
    height: 42%;
    background: linear-gradient(to top, var(--scrim));
  }

  .tile-front {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--sp-28);
  }
  .tile-title {
    font-size: var(--text-tile);
    max-width: 14ch;
  }
  .tile-foot { display: grid; gap: var(--sp-16); }
  .tile-chips { display: flex; flex-wrap: wrap; gap: var(--sp-8); }
  /* чипы лежат на фото — всегда тёмное стекло, на какой бы полосе ни стояла плашка */
  .tile .chip { background: var(--glass-dark); }
  .tile-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-16);
  }
  /* Цена «от» — витринный ярлык, а не наборный текст: отсюда табличные цифры */
  .tile-price {
    font-size: var(--text-lead);
    font-variant-numeric: tabular-nums;
  }
  /* Круглая стеклянная стрелка → при наведении на плашку «Рассчитать →» (их «Explore →») */
  .tile-go {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0;
    height: 44px;
    min-width: 44px;
    padding: 0 12px;
    border-radius: var(--r-full);
    background: var(--glass-dark);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    color: var(--color-white);
    transition: background-color 0.25s var(--ease-porsche), gap 0.4s var(--ease-porsche), padding 0.4s var(--ease-porsche);
  }
  .tile-go svg { width: 20px; height: 20px; flex: none; }
  .tile-go-label {
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    opacity: 0;
    transition: max-width 0.4s var(--ease-porsche), opacity 0.25s var(--ease-porsche);
  }
  /* ссылка растянута на всю плашку: клик в любом месте — в калькулятор */
  .tile-go::after { content: ''; position: absolute; inset: 0; }
  /* Раскрытие стрелки в «Рассчитать →» снято 19.10.2026 вместе с расширением карточки */
  @media (hover: hover) {
    .tile:hover .tile-go { background: var(--glass-dark-hover); }
  }

  /* Оборот — «стекло» поверх фото: размытая плашка с тёмной заливкой. Без трансформов:
     кроссфейд, чтобы кромка второго слоя не просвечивала на скруглённых углах */
  .tile-back {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: var(--sp-28);
    background: rgba(1, 2, 5, 0.55);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    color: var(--color-white);
    opacity: 0;
    transition: opacity 0.3s var(--ease-porsche);
  }
  /* На обороте лицо плашки скрыто — название категории повторяем меткой.
     Список идёт сразу под ней, ссылка прижата к низу */
  /* Заголовок оборота — самый крупный элемент карточки: он держит,
     о какой категории список, и читается раньше строк прайса */
  .tile-back-title {
    font-size: var(--text-tile);
    line-height: 1.15;
    margin-bottom: var(--sp-16);
  }
  /* Кнопка прижата к низу, но от последней строки прайса всегда отбита */
  .tile-back .tile-more { margin-top: auto; }
  .tile-back .tile-list { margin-bottom: var(--sp-16); }
  /* Мини-прайс по наведению снят 19.10.2026: как у Porsche, при наведении фото остаётся
     на виду, карточка расширяется. Оборот открывается только классом .is-open */
  .tile.is-open .tile-back { opacity: 1; }
  .tile-back { pointer-events: none; }
  .tile.is-open .tile-back { pointer-events: auto; }
  .tile[data-tile] { cursor: pointer; }
  .tile-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
    align-content: start;
  }
  /* Строка мини-прайса: название слева, цена справа. Разделительных линий нет —
     под курсором строка целиком берётся плашкой, она же показывает, что это ссылка.
     Отрицательные поля: подсветка шире текста, но левый край остаётся на сетке плашки */
  .tile-list a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-16);
    margin-inline: calc(var(--sp-8) * -1);
    padding: 4px var(--sp-8);
    border-radius: var(--r-row);
    transition: background-color var(--t-hover-out) var(--ease-out);
  }
  .tile-list a:hover,
  .tile-list a:focus-visible { background: var(--color-row-hover-dark); transition-duration: var(--t-hover-in); }
  .tile-list { font-size: var(--text-body-lg); }
  .tile-list a { padding-block: 8px; }
  .tile-item-name { line-height: 1.3; }
  .tile-item-price {
    flex: none;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  /* Переход к заявке — кнопка в ободке, а не текстовая ссылка: на обороте плашки
     это единственное целевое действие, оно должно читаться кнопкой. Заливка остаётся
     за первичной кнопкой в плашке-призыве — здесь вторая ступень иерархии */
  .tile-more {
    align-self: start;
    font-size: var(--text-body);
  }

  /* Призыв — не плашка и не клетка сетки: текст и кнопка отдельной строкой под плашками */
  .tiles-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--sp-24) var(--sp-48);
    margin-top: var(--sp-64);
  }
  .tiles-cta-text { display: grid; gap: var(--sp-12); }
  .tiles-cta-title { font-size: var(--text-tile); }
  .tiles-cta-text p { max-width: var(--measure-lead); font-size: var(--text-body-lg); }

  /* Тач-экраны: оборота нет вовсе — только лицо, тап ведёт в калькулятор */
  @media (hover: none) {
    .tile-back { display: none; }
  }

  /* Нечётное число категорий: последняя одна в ряду — во всю ширину той же высоты */
  @media (max-width: 900px) {
    .tiles { --tile-gap: var(--sp-16); --tile-h: calc((100cqw - var(--tile-gap)) / 2 * 1.25); }
    .tile-front, .tile-back { padding: var(--sp-20); }
  }
  /* Телефон — лента карточек, как модели на porsche.com (19.10.2026): листается пальцем,
     карточка высокая (3:5), внизу чипы, цена и белая кнопка во всю ширину; под лентой —
     точки. Лента выходит за поля контейнера до краёв экрана */
  @media (max-width: 560px) {
    .tiles {
      --tile-gap: var(--sp-12);
      display: flex;
      gap: var(--tile-gap);
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      scroll-padding-inline: var(--gutter);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
    }
    .tiles::-webkit-scrollbar { display: none; }
    .tiles-row { display: contents; }
    .tile-cell { flex: 0 0 86%; scroll-snap-align: start; }
    .tile { height: auto; }
    .tile-front { position: relative; aspect-ratio: 3 / 5; }
    .tile-chips .chip:nth-child(n + 3) { display: none; }
    .tile-back { display: none; }
    .tile-row { flex-direction: column; align-items: stretch; gap: var(--sp-12); }
    /* стрелка → белая кнопка «Рассчитать» во всю ширину (их «Ontdek») */
    .tile-go {
      justify-content: center;
      height: 52px;
      border-radius: var(--r-pill);
      background: var(--color-white);
      color: var(--color-ink);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
    /* при нажатии — та же белая заливка (19.10.2026: «эффект при нажатии ужасный» —
       срабатывало наведение и кнопка становилась серым стеклом) */
    .tile:hover .tile-go,
    .tile-go:hover,
    .tile-go:active { background: var(--color-white); }
    .tile-go svg { display: none; }
    .tile-go-label { max-width: none; opacity: 1; }
    .tiles-cta { margin-top: var(--sp-48); }
    .tiles-cta-text p { font-size: var(--text-body); }
  }
</style>

<script>
  import { dots } from '../lib/carousel-dots.js';
  dots(document.querySelector('.tiles'), document.querySelector('[data-tiles-dots]'), '.tile-cell');
</script>
