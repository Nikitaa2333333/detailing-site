---
/* Плашки категорий услуг. Лицо — название и цена «от», оборот по наведению —
   мини-прайс со ссылками на услуги. Оборот только там, где есть курсор: на телефоне
   (14.10.2026) переворота нет — тап по плашке открывает её направление в калькуляторе
   (data-calc-cat, обработчик в Calculator.astro). Клик по лицу на десктопе — то же.
   Сетка ровная, все плашки одного размера (14.10.2026: широкие сняты — ряд «широкая + узкая»
   ехал). Число категорий не кратно трём — последний ряд неполный, это нормально.
   Призыв «Не знаете, с чего начать?» — отдельным блоком под сеткой, без плашки.
   Данные считаются из прайса в lib/catalog.js, руками цены не проставляем. */
import { categories, rub } from '../lib/catalog.js';
import { asset } from '../lib/paths.js';

const { cta, more, href = '#contacts' } = Astro.props;
---

<div class:list={['tiles', categories.length % 2 && 'tiles--odd']}>
  {categories.map((c) => (
    <div class="tile-cell">
    <article
      class:list={['tile', c.media && 'tile--media']}
      id={`cat-${c.id}`}
      data-tile
      data-calc-cat={c.id}
    >
      {c.media && <img class="tile-bg" src={asset(c.media)} alt="" loading="lazy" />}
      <div class="tile-front">
        <div class="tile-top">
          <span class="chip">{c.tag}</span>
        </div>
        <div class="tile-headline">
          <h3 class="tile-title">{c.title}</h3>
          <p class="tile-price">от {rub(c.from)}</p>
        </div>
      </div>
      <div class="tile-back">
        <p class="tile-back-title">{c.title}</p>
        <ul class="tile-list">
          {c.items.map((s) => (
            <li>
              <a href={href} data-service={s.title} data-service-id={s.id}>
                <span class="tile-item-name">{s.title}</span>
                <span class="tile-item-price">от {rub(s.from)}</span>
              </a>
            </li>
          ))}
        </ul>
        <a class="btn btn--ghost tile-more" href={href}>{more}</a>
      </div>
    </article>
    </div>
  ))}

</div>

{cta && (
  <div class="tiles-cta">
    <div class="tiles-cta-text">
      <h3 class="tiles-cta-title">{cta.title}</h3>
      <p>{cta.text}</p>
    </div>
    <a class="btn btn--primary" href={href}>{cta.button}</a>
  </div>
)}

<style>
  /* Плашки услуг: ровная сетка 3 колонки, все одного размера. Ниже квадрата — 5:4:
     квадрат в треть ширины выходил огромным. Ниже 5:4 не опускать — на обороте
     должен уместиться мини-прайс с кнопкой */
  .tiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-12);
  }
  .tile {
    position: relative;
    overflow: hidden;
    --tile-ratio: 5 / 4;
    aspect-ratio: var(--tile-ratio);
    border-radius: var(--r-tile);
    background: var(--color-tile-dark);
    color: var(--color-white);
    /* переход из меню: якорь не должен уезжать под шапку */
    scroll-margin-top: calc(var(--header-h) + var(--sp-24));
  }
  .tile-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tile-front {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--sp-20);
  }
  .tile-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--sp-8);
  }
  .tile-count { font-size: var(--text-caption); font-weight: var(--w-medium); }
  .tile-headline { display: grid; gap: var(--sp-8); }
  .tile-title {
    font-size: var(--text-tile);
    max-width: 10ch;
  }
  /* Цена «от» — витринный ярлык, а не наборный текст: отсюда вес и табличные цифры */
  .tile-price {
    font-size: var(--text-body-lg);
    font-weight: var(--w-medium);
    font-variant-numeric: tabular-nums;
  }
  .tile--media .tile-title,
  .tile--media .tile-price { text-shadow: 0 1px 24px rgba(0, 0, 0, 0.4); }

  /* Оборот плашки — тёмная панель своего оттенка, чтобы не сливалась с полосой. Без трансформов:
     просто кроссфейд, чтобы кромка второго слоя не просвечивала на скруглённых углах */
  .tile-back {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: var(--sp-20);
    background: var(--color-tile-back);
    color: var(--color-white);
    opacity: 0;
    transition: opacity 0.2s var(--ease-out);
  }
  /* На обороте лицо плашки скрыто — название категории повторяем меткой.
     Список идёт сразу под ней, ссылка прижата к низу */
  /* Заголовок оборота — самый крупный элемент карточки: он держит,
     о какой категории список, и читается раньше строк прайса */
  .tile-back-title {
    font-size: var(--text-subhead);
    font-weight: var(--w-semibold);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: var(--sp-12);
  }
  /* Кнопка прижата к низу, но от последней строки прайса всегда отбита */
  .tile-back .tile-more { margin-top: auto; }
  .tile-back .tile-list { margin-bottom: var(--sp-16); }
  /* Раскрытие: наведение (только там, где есть курсор — на тач-экране «липкий» hover
     путает), фокус внутри (клавиатура), клик из меню и тап — .is-open */
  @media (hover: hover) {
    .tile:hover .tile-back { opacity: 1; }
  }
  .tile:focus-within .tile-back,
  .tile.is-open .tile-back { opacity: 1; }
  .tile-back { pointer-events: none; }
  .tile.is-open .tile-back,
  .tile:focus-within .tile-back { pointer-events: auto; }
  @media (hover: hover) {
    .tile:hover .tile-back { pointer-events: auto; }
  }
  .tile[data-tile] { cursor: pointer; }
  .tile-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
    align-content: start;
  }
  /* Строка мини-прайса: название слева, цена справа. Разделительных линий нет —
     под курсором строка целиком берётся плашкой, она же показывает, что это ссылка.
     Отрицательные поля: подсветка шире текста, но левый край остаётся на сетке плашки */
  .tile-list a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-16);
    margin-inline: calc(var(--sp-8) * -1);
    padding: 4px var(--sp-8);
    border-radius: var(--r-row);
    transition: background-color var(--t-hover-out) var(--ease-out);
  }
  .tile-list a:hover,
  .tile-list a:focus-visible { background: var(--color-row-hover-dark); transition-duration: var(--t-hover-in); }
  .tile-item-name { line-height: 1.2; font-weight: var(--w-semibold); }
  .tile-item-price {
    flex: none;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  /* Переход к заявке — кнопка в ободке, а не текстовая ссылка: на обороте плашки
     это единственное целевое действие, оно должно читаться кнопкой. Заливка остаётся
     за первичной кнопкой в плашке-призыве — здесь вторая ступень иерархии */
  .tile-more {
    align-self: start;
    font-size: var(--text-body);
  }

  /* Текст — на плашке: название и «от … ₽» (16.10.2026: подпись под фото по Горбунову
     пробовали — вернули на плашку). Чип и число услуг сняты — минимализм */
  .tile-cell { display: grid; }
  .tile-top { display: none; }
  .tile-front { justify-content: flex-end; }

  /* Призыв — не плашка и не клетка сетки: текст и кнопка отдельной строкой под плашками */
  .tiles-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--sp-24) var(--sp-48);
    margin-top: var(--sp-64);
  }
  .tiles-cta-text { display: grid; gap: var(--sp-12); }
  .tiles-cta-title { font-size: var(--text-tile); }
  .tiles-cta-text p { max-width: var(--measure-lead); font-size: var(--text-body-lg); }

  /* Тач-экраны: оборота нет вовсе — только лицо, тап ведёт в калькулятор */
  @media (hover: none) {
    .tile-back { display: none; }
  }

  /* Две колонки: при нечётном числе категорий первая во всю ширину, чтобы не было дыры */
  @media (max-width: 1100px) {
    .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 561px) and (max-width: 1100px) {
    .tiles--odd .tile-cell:first-child { grid-column: span 2; }
    .tiles--odd .tile-cell:first-child .tile { --tile-ratio: 5 / 2; }
  }
  /* Телефон: одна колонка, лицо 16:10. Тап переворачивает плашку: на обороте без фото —
     название, мини-прайс, кнопка; высота тянется по списку (16.10.2026: оборот поверх
     фото в рамке 16:10 не вмещал список). Наведение здесь ничего не делает */
  @media (max-width: 560px) {
    .tiles { grid-template-columns: 1fr; gap: var(--sp-12); }
    .tile { grid-column: auto; aspect-ratio: auto; }
    .tile-front { position: relative; aspect-ratio: 16 / 10; }
    .tile-back,
    .tile:hover .tile-back,
    .tile:focus-within .tile-back {
      position: static;
      display: none;
      opacity: 1;
    }
    .tile.is-open .tile-bg,
    .tile.is-open .tile-front { display: none; }
    /* не ниже лица (16:10), длинный список тянет оборот выше */
    .tile.is-open .tile-back { display: flex; aspect-ratio: 16 / 10; }
    .tiles-cta { margin-top: var(--sp-48); }
    .tiles-cta-text p { font-size: var(--text-body); }
  }
</style>

<script>
  /* Телефон: тап по плашке меняет сторону (лицо ↔ мини-прайс): новая сторона мягко
     проявляется, высота плавно доезжает до новой. Без разворотов (16.10.2026: поворот
     по оси — резко). Ссылки на обороте работают как ссылки; открыта только одна плашка */
  const narrow = matchMedia('(max-width: 560px)');
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  const ease = 'cubic-bezier(0.22, 1, 0.36, 1)';

  function flip(tile: HTMLElement, open: boolean) {
    if (still.matches) return void tile.classList.toggle('is-open', open);
    const from = tile.offsetHeight;
    tile.classList.toggle('is-open', open);
    const to = tile.offsetHeight;
    tile.animate([{ height: `${from}px` }, { height: `${to}px` }], { duration: 360, easing: ease });
    const side = tile.querySelector<HTMLElement>(open ? '.tile-back' : '.tile-front');
    side?.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 260, easing: 'ease-out' });
  }

  document.querySelectorAll<HTMLElement>('.tile').forEach((tile) => {
    tile.addEventListener('click', (e) => {
      if (!narrow.matches || (e.target as HTMLElement).closest('a')) return;
      const open = !tile.classList.contains('is-open');
      document.querySelectorAll<HTMLElement>('.tile.is-open').forEach((t) => t !== tile && flip(t, false));
      flip(tile, open);
    });
  });
</script>
