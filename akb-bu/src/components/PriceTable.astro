---
/* Таблица прайса — обязательный блок страниц услуг и направлений (docs/site-structure.md, §5).
   Печатается в готовом HTML: поисковик видит все цены по классам. Выбрали машину —
   lib/page-car.js ставит <html data-car-cls> и столбец класса подсвечивается (без заливок
   строк, замечание заказчика).

   Телефон (19.10.2026, «таблица нечитабельна»): не таблица, а список — услуга слева, цена
   справа, одна колонка класса; какой класс показывать — чипы над списком (класс машины
   подставляется сам). «Что входит» на телефоне открывает шторку снизу (.sheet из global.css),
   на ПК раскрывается строкой под услугой. Разметка одна: таблица перестраивается стилями,
   все пять цен остаются в HTML.

   groups — [{ title, rows: [{ key, name, lead, includes, terms, cells }] }] из lib/pages.js.
   С 19.10.2026 таблица — справочная «по всем классам»; записаться — в карточках ServiceVariants. */
import { rub } from '../lib/catalog.js';
import { typo } from '../lib/typo.js';

const { groups = [], classes = 5 } = Astro.props;
const cols = Array.from({ length: classes }, (_, i) => i + 1);
const price = (c) => (!c ? 'по запросу' : c.kind === 'exact' ? rub(c.value) : `от ${rub(c.value)}`);
---

<div class="ptable-scroll" data-cls="1" data-ptable>
  <!-- Телефон: какой класс показывать. На ПК скрыто — там все пять колонок -->
  <div class="ptable-cls" role="group" aria-label="Класс автомобиля">
    <span class="ptable-cls-label">Класс</span>
    {cols.map((n) => <button class="ptable-cls-btn" type="button" data-cls-btn={n} aria-pressed={n === 1 ? 'true' : 'false'}>{n}-й</button>)}
  </div>
  <table class="ptable">
    <thead>
      <tr>
        <th scope="col" class="ptable-name">Услуга</th>
        {cols.map((n) => <th scope="col" class="ptable-price" data-col={n}>{n}-й класс</th>)}
      </tr>
    </thead>
    <tbody>
      {groups.map((g) => (
        <>
          {g.title && (
            <tr class="ptable-group">
              <th scope="rowgroup" colspan={classes + 1}>{typo(g.title)}</th>
            </tr>
          )}
          {g.rows.map((r) => {
            const more = r.lead || r.includes.length > 0 || r.terms.length > 0;
            const id = `more-${r.key.replace(/[^a-z0-9]+/gi, '-')}`;
            return (
              <>
                <tr class="ptable-row">
                  <th scope="row" class="ptable-name">
                    <span class="ptable-svc">{typo(r.name)}</span>
                    {more && (
                      <button class="link-plus ptable-more" type="button" aria-expanded="false" aria-controls={id} data-more={id} data-svc={r.name}>
                        <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="8.25" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M10 6.5v7M6.5 10h7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                        <span class="ptable-more-text">Что входит</span>
                      </button>
                    )}
                  </th>
                  {r.cells.map((c, i) => <td class="ptable-price" data-col={i + 1}>{price(c)}</td>)}
                </tr>
                {/* состав — отдельной строкой во всю ширину, не в колонке услуги (19.10.2026) */}
                {more && (
                  <tr class="ptable-more-row" id={id} hidden>
                    <td colspan={classes + 1}>
                      <div class="ptable-more-body">
                        {r.lead && <p>{typo(r.lead)}</p>}
                        {r.includes.length > 0 && <ul class="bullets">{r.includes.map((i) => <li>{typo(i)}</li>)}</ul>}
                        {r.terms.map((t) => <p class="ptable-terms">{typo(t)}</p>)}
                      </div>
                    </td>
                  </tr>
                )}
              </>
            );
          })}
        </>
      ))}
    </tbody>
  </table>
</div>

<script>
  const PHONE = matchMedia('(max-width: 760px)');

  /* Телефон: чипы класса → одна видимая колонка цен. Класс выбранной машины подставляется
     сам (html[data-car-cls] из lib/page-car.js), пока человек не ткнул чип руками */
  const tables = document.querySelectorAll<HTMLElement>('[data-ptable]');
  const setCls = (t: HTMLElement, cls: string) => {
    t.dataset.cls = cls;
    for (const b of t.querySelectorAll<HTMLButtonElement>('[data-cls-btn]')) {
      b.setAttribute('aria-pressed', String(b.dataset.clsBtn === cls));
    }
  };
  const fromCar = () => {
    const cls = document.documentElement.dataset.carCls;
    if (!cls || !/^[1-5]$/.test(cls)) return;
    for (const t of tables) if (!t.dataset.clsManual) setCls(t, cls);
  };
  for (const t of tables) {
    for (const b of t.querySelectorAll<HTMLButtonElement>('[data-cls-btn]')) {
      b.addEventListener('click', () => { t.dataset.clsManual = '1'; setCls(t, b.dataset.clsBtn!); });
    }
  }
  fromCar();
  document.addEventListener('car:change', fromCar);

  /* «Что входит»: на ПК — строка под услугой; на телефоне — шторка снизу (одна на страницу) */
  let sheet: HTMLDialogElement | null = null;
  const getSheet = () => {
    if (sheet) return sheet;
    sheet = document.createElement('dialog');
    sheet.className = 'sheet';
    sheet.innerHTML =
      // фокус при открытии — на саму панель, не на крестик: иначе iPhone рисует на нём синее кольцо
      '<div class="sheet-panel" tabindex="-1" autofocus>' +
      '<button class="round-glass sheet-close" type="button" aria-label="Закрыть"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></button>' +
      '<p class="sheet-kicker"></p><h3 class="sheet-title"></h3><div class="sheet-body"></div></div>';
    document.body.append(sheet);
    const close = () => sheet!.close();
    sheet.querySelector('.sheet-close')!.addEventListener('click', close);
    sheet.addEventListener('click', (e) => { if (e.target === sheet) close(); }); // тап по подложке
    sheet.addEventListener('close', () => document.documentElement.classList.remove('sheet-open'));
    return sheet;
  };
  const openSheet = (b: HTMLButtonElement, row: HTMLElement) => {
    const s = getSheet();
    const table = b.closest<HTMLElement>('[data-ptable]')!;
    const cls = table.dataset.cls!;
    const tr = b.closest('tr')!;
    const cell = tr.querySelector<HTMLElement>(`[data-col='${cls}']`);
    s.querySelector('.sheet-kicker')!.textContent = cell ? `${cls}-й класс · ${cell.textContent}` : '';
    s.querySelector('.sheet-title')!.textContent = b.dataset.svc ?? '';
    s.querySelector('.sheet-body')!.innerHTML = row.querySelector('.ptable-more-body')!.innerHTML;
    document.documentElement.classList.add('sheet-open');
    s.showModal();
  };

  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-more]')) {
    const row = document.getElementById(b.dataset.more!);
    if (!row) continue;
    b.addEventListener('click', () => {
      if (PHONE.matches) { openSheet(b, row); return; }
      const open = row.hidden;
      row.hidden = !open;
      b.setAttribute('aria-expanded', String(open));
      b.querySelector('.ptable-more-text')!.textContent = open ? 'Свернуть' : 'Что входит';
    });
  }
</script>

<style>
  /* Ширина колонок: услуга — сколько дадут, классы — ровные. Ручки: --ptable-name-min
     (колонка услуги), --ptable-col (минимум колонки цены) */
  .ptable-scroll {
    --ptable-name-min: 220px;
    --ptable-col: 108px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
  }
  .ptable-cls { display: none; }
  .ptable {
    width: 100%;
    min-width: calc(var(--ptable-name-min) + var(--ptable-col) * 5);
    border-collapse: collapse;
    font-size: var(--text-body);
    line-height: 1.4;
  }
  .ptable th,
  .ptable td {
    padding: var(--sp-16) var(--sp-16);
    text-align: left;
    vertical-align: top;
    font-weight: var(--w-regular);
  }
  /* Линии — только как структура строк таблицы */
  .ptable tbody tr { border-top: 1px solid var(--color-line-ink); }
  .ptable thead th {
    padding-block: var(--sp-12);
    font-size: var(--text-caption);
    font-weight: var(--w-medium);
    white-space: nowrap;
  }
  .ptable-name {
    width: 46%;
    min-width: var(--ptable-name-min);
    padding-left: 0 !important;
  }
  .ptable-svc { display: block; font-size: var(--text-body-lg); }
  .ptable-price {
    min-width: var(--ptable-col);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    border-radius: 0;
  }
  .ptable-price:last-child { padding-right: 0; }

  /* Группа прайса («Новое авто», «Авто с пробегом») — подзаголовок строкой */
  .ptable-group th {
    padding-top: var(--sp-32);
    padding-left: 0;
    font-size: var(--text-subhead);
    letter-spacing: var(--track-head);
  }

  /* «Что входит» — общий .link-plus из global.css, тот же, что «Добавить услуги» в
     калькуляторе (19.10.2026: «берём одни компоненты»); раскрыто — плюс поворачивается в крестик */
  .ptable-more { margin-top: var(--sp-4); }
  /* Строка состава — без верхней линии (продолжение строки услуги), текст во всю ширину */
  .ptable tbody tr.ptable-more-row { border-top: 0; }
  .ptable-more-row td { padding-top: 0; padding-left: 0 !important; }
  /* на ПК состав держится в колонке «Услуга» (её 46 %), не расползается под цены (19.10.2026) */
  .ptable-more-body { display: grid; gap: var(--sp-12); width: 46%; max-width: var(--measure-text); }
  .ptable-more-body .bullets { --bullet-gap: 6px; }

  /* Столбец класса выбранной машины — серая подложка во всю высоту, шапка — весом */
  :global(html[data-car-cls='1']) .ptable [data-col='1'],
  :global(html[data-car-cls='2']) .ptable [data-col='2'],
  :global(html[data-car-cls='3']) .ptable [data-col='3'],
  :global(html[data-car-cls='4']) .ptable [data-col='4'],
  :global(html[data-car-cls='5']) .ptable [data-col='5'] {
    background: var(--color-tile);
  }
  :global(html[data-car-cls='1']) .ptable thead [data-col='1'],
  :global(html[data-car-cls='2']) .ptable thead [data-col='2'],
  :global(html[data-car-cls='3']) .ptable thead [data-col='3'],
  :global(html[data-car-cls='4']) .ptable thead [data-col='4'],
  :global(html[data-car-cls='5']) .ptable thead [data-col='5'] {
    font-weight: var(--w-semibold);
    border-radius: var(--r-row) var(--r-row) 0 0;
  }

  /* ---- Телефон: список «услуга — цена одного класса», чипы класса сверху --------------- */
  @media (max-width: 760px) {
    .ptable-scroll { overflow: visible; margin-inline: 0; padding-inline: 0; }
    .ptable-cls {
      display: flex;
      align-items: center;
      gap: var(--sp-8);
      margin-bottom: var(--sp-16);
      font-size: var(--text-caption);
    }
    .ptable-cls-label { margin-right: var(--sp-4); }
    /* Чипы: серое «стекло», активный — чёрная заливка (их каталог: первый чип чёрный) */
    .ptable-cls-btn {
      padding: 6px 12px;
      border: 0;
      border-radius: var(--r-full);
      background: var(--glass-light);
      color: inherit;
      font: inherit;
      font-size: var(--text-caption);
      cursor: pointer;
    }
    .ptable-cls-btn[aria-pressed='true'] { background: var(--color-ink); color: var(--color-white); }

    .ptable, .ptable tbody, .ptable tr, .ptable th, .ptable td { display: block; min-width: 0; }
    .ptable thead { display: none; }
    .ptable { min-width: 0; }
    .ptable-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--sp-4) var(--sp-16);
      align-items: start;
      padding-block: var(--sp-16);
    }
    .ptable th, .ptable td { padding: 0; }
    .ptable-name { width: auto; }
    /* видна только колонка выбранного класса; подсветку столбца с ПК снимаем */
    .ptable td.ptable-price { display: none; background: none !important; padding: 0 !important; }
    .ptable-scroll[data-cls='1'] .ptable-row [data-col='1'],
    .ptable-scroll[data-cls='2'] .ptable-row [data-col='2'],
    .ptable-scroll[data-cls='3'] .ptable-row [data-col='3'],
    .ptable-scroll[data-cls='4'] .ptable-row [data-col='4'],
    .ptable-scroll[data-cls='5'] .ptable-row [data-col='5'] {
      display: block;
      font-size: var(--text-body-lg);
      text-align: right;
    }
    .ptable-group th { padding-top: var(--sp-24); padding-bottom: 0; }
    .ptable tbody tr.ptable-group { border-top: 0; }
    /* состав — только в шторке */
    .ptable-more-row { display: none !important; }
  }
</style>
