---
/* Гарантии — список под тонкими линиями (20.10.2026; номера 01–04 сняты в тот же день). Лента карточек со
   стрелками (их «Drive.») снята: на телефоне давала дыры между заголовком, стрелками и
   карточками, на ПК плашки растягивались вширь; третья лента подряд после пакетов — перебор.
   ПК — четыре колонки в ряд, телефон — столбиком. Заголовок и текст.
   Пункты — content.json → guarantees.items (поле media больше не используется). */
import { typo } from '../lib/typo.js';
const { items = [] } = Astro.props;
---

<ul class="g-list">
  {items.map((g) => (
    <li class="g-item">
      <h3 class="g-title">{typo(g.title)}</h3>
      <p class="g-text">{typo(g.text)}</p>
    </li>
  ))}
</ul>

<style>
  .g-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--sp-40);   /* один промежуток по вертикали и горизонтали */
  }
  .g-item {
    display: grid;
    align-content: start;
    gap: var(--sp-12);
    padding-top: var(--sp-20);
    border-top: 1px solid var(--color-line-white);
  }
  .g-title { font-size: var(--text-subhead); letter-spacing: var(--track-head); line-height: 1.2; text-wrap: balance; }
  .g-text { font-size: var(--text-body); line-height: 1.55; max-width: 40ch; }

  @media (max-width: 1100px) {
    .g-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    .g-list { grid-template-columns: minmax(0, 1fr); gap: var(--sp-28); }
    .g-item { padding-top: var(--sp-16); }
  }
</style>
