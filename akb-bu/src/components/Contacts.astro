---
/* Контакты с картой — как на сайте КТМ: адрес, телефон, часы крупно в ряд, ниже связь и Яндекс Карта
   во всю ширину контента. Карта — виджет Яндекса (iframe): с mapOid показывает карточку
   организации с отзывами и маршрутом, без него — метку по координатам.
   На таче карта неактивна до тапа: иначе свайп по ней крутит карту, а не страницу.
   Данные — content.json → contacts (адрес, телефон и координаты пока вымышленные). */
import content from '../data/content.json';
import { typo } from '../lib/typo.js';

const { contacts } = content;
const { title = 'Адрес и контакты' } = Astro.props;
const [lon, lat] = contacts.mapCenter;
const mapSrc = contacts.mapOid
  ? `https://yandex.ru/map-widget/v1/?oid=${contacts.mapOid}&ol=biz&z=16`
  : `https://yandex.ru/map-widget/v1/?ll=${lon}%2C${lat}&z=16&pt=${lon}%2C${lat}%2Cpm2orgl`;
/* значки — те же, что в подвале (SiteFooter.astro), и «собака» для почты */
const icons = {
  Telegram: '<path d="M21.2 4.1 2.9 11.2c-.9.4-.9 1.6 0 1.9l4.5 1.5 1.7 5.4c.2.7 1.1.9 1.6.4l2.6-2.4 4.5 3.3c.6.5 1.5.1 1.7-.6l3.2-15.2c.2-.9-.7-1.7-1.5-1.4zM9.9 14.6l7.6-6.9-5.9 7.9-.4 2.9z" fill="currentColor" fill-rule="evenodd"/>',
  WhatsApp: '<path fill-rule="evenodd" d="M12 3a9 9 0 0 0-7.8 13.4L3 21l4.7-1.2A9 9 0 1 0 12 3zM9.3 7.6c-.4.4-.9 1.2-.6 2.3.5 1.9 2.9 4.4 5 5.1.9.3 1.7 0 2.1-.5l.3-1.1-1.9-.9-.8.8c-1-.5-2.1-1.6-2.6-2.6l.8-.8-.9-2z" fill="currentColor"/>',
  mail: '<circle cx="12" cy="12" r="3.6" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M15.6 9v4.2a2.4 2.4 0 0 0 4.8 0V12a8.4 8.4 0 1 0-3.3 6.7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>',
};
// «ежедневно 09:00–21:00» → подпись «Ежедневно» и крупно «09:00–21:00»
const hoursAt = contacts.hours.search(/\d/);
const hoursLabel = hoursAt > 0 ? contacts.hours.slice(0, hoursAt).trim().replace(/^./, (c) => c.toUpperCase()) : 'Часы работы';
const hoursTime = hoursAt > 0 ? contacts.hours.slice(hoursAt).trim() : contacts.hours;
const routeHref = `https://yandex.ru/maps/?rtext=~${lat}%2C${lon}&rtt=auto`;
---

<div class="contacts">
  <h2 class="contacts-title">{typo(title)}</h2>

  <!-- 20.10.2026: адрес → телефон → часы крупно, подписи мелко над ними; внизу одной
       строкой связь — WhatsApp, Telegram значками, почта значком @ со словом «Почта» -->
  <dl class="contacts-grid">
    <div class="contacts-col">
      <dt class="contacts-label">Адрес</dt>
      <dd class="contacts-value">{typo(contacts.addressShort ?? contacts.address)}</dd>
      {contacts.addressNote && <dd class="contacts-note">{typo(contacts.addressNote)}</dd>}
    </div>
    <div class="contacts-col">
      <dt class="contacts-label">Телефон</dt>
      <dd class="contacts-value"><a href={`tel:${contacts.phoneHref}`}>{contacts.phone}</a></dd>
    </div>
    <div class="contacts-col">
      <dt class="contacts-label">{hoursLabel}</dt>
      <dd class="contacts-value contacts-hours">{hoursTime}</dd>
    </div>
  </dl>
  <div class="contacts-msg">
    <a class="round-glass contacts-ico" href={`https://wa.me/${contacts.whatsappHref}`} target="_blank" rel="noopener" aria-label="WhatsApp" title="WhatsApp">
      <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.WhatsApp} />
    </a>
    <a class="round-glass contacts-ico" href={`https://t.me/${contacts.telegram}`} target="_blank" rel="noopener" aria-label="Telegram" title="Telegram">
      <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.Telegram} />
    </a>
    <a class="btn btn--glass contacts-mail" href={`mailto:${contacts.email}`} title={contacts.email}>
      <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.mail} />
      Почта
    </a>
  </div>

  <div class="contacts-map-block">
    <div class="contacts-map" data-map>
      <iframe src={mapSrc} title={`Карта: ${contacts.address}`} loading="lazy" allowfullscreen></iframe>
      <button class="contacts-map-cover" type="button" data-map-on>
        <span class="btn btn--glass">Открыть карту</span>
      </button>
    </div>
    <a class="btn btn--primary btn--page contacts-route" href={routeHref} target="_blank" rel="noopener">Построить маршрут</a>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((map) => {
    map.querySelector('[data-map-on]')?.addEventListener('click', () => map.classList.add('is-live'));
  });
</script>

<style>
  .contacts { display: grid; gap: var(--sp-40); }
  .contacts-title {
    font-size: var(--text-heading-xl);
    max-width: var(--measure-head);
  }
  .contacts-grid {
    margin: 0;
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--sp-32) var(--sp-40);
  }
  .contacts-col { display: grid; gap: var(--sp-8); align-content: start; }
  .contacts-col dd { margin: 0; }
  .contacts-label { font-size: var(--text-body); }
  /* Адрес, телефон, часы — один крупный кегль; цифры моноширинные, ровные */
  .contacts-value {
    font-size: var(--text-tile);
    letter-spacing: var(--track-head);
    line-height: 1.15;
    font-variant-numeric: tabular-nums;
    text-wrap: balance;
  }
  .contacts-hours { white-space: nowrap; }
  .contacts-note { font-size: var(--text-body-lg); }
  .contacts-msg { display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-8); margin-top: calc(var(--sp-8) * -1); }
  .contacts-ico { width: 52px; height: 52px; }
  .contacts-ico svg { width: 24px; height: 24px; }
  .contacts-mail { display: inline-flex; align-items: center; gap: var(--sp-8); height: 52px; padding: 0 22px 0 16px; border-radius: var(--r-full); }
  .contacts-mail svg { flex: none; width: 22px; height: 22px; }

  .contacts-map-block { display: grid; gap: var(--sp-16); justify-items: start; }

  .contacts-map {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: var(--r-tile);
    background: var(--color-tile);
    height: clamp(300px, 30vw, 420px);   /* было до 600 — «громадная» */
  }
  .contacts-map iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
  /* Крышка карты — только на таче: курсором карта работает сразу */
  .contacts-map-cover {
    position: absolute;
    inset: 0;
    display: none;
    align-items: end;
    justify-content: center;
    padding-bottom: var(--sp-24);
    border: 0;
    background: none;
    cursor: pointer;
  }
  @media (hover: none) {
    .contacts-map-cover { display: flex; }
    .contacts-map.is-live .contacts-map-cover { display: none; }
  }

  @media (max-width: 860px) {
    .contacts-grid { grid-template-columns: minmax(0, 1fr); gap: var(--sp-24); }
    .contacts { gap: var(--sp-32); }
    .contacts-col { gap: var(--sp-4); }
  }
  /* Телефон: основная кнопка — во всю ширину */
  @media (max-width: 600px) {
    .contacts-route { justify-self: stretch; }
  }
</style>
