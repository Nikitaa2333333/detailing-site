---
/* Подвал — по референсу b2b.yandex.ru: два яруса.
   Верхний — лист основы со скруглённым низом: крупный логотип, связь (о компании и кнопка
   заявки), соцсети, телефон и адрес. Нижний — на ступень светлее (--color-coal), лежит под
   скруглением верхнего: колонки ссылок, копирайт и оговорка.
   Ссылки приглушены (--color-text-muted), заголовки колонок белые — исключение из правила
   контраста по прямой просьбе 14.10.2026, как у референса.

   Данные — из content.json (footer, contacts) и каталога: список категорий
   считается из прайса, руками сюда не вписывается. Телефон и адрес вымышленные. */
import content from '../data/content.json';
import { categories } from '../lib/catalog.js';
import { url } from '../lib/paths.js';
import { typo } from '../lib/typo.js';

const { footer, contacts, services } = content;
const { brand, year = new Date().getFullYear() } = Astro.props;
---

<footer class="footer on-dark" id="footer">
  <div class="footer-main">
    <div class="container">
      <a class="logo brand-logo" href={url('/')} aria-label={brand.name}>{brand.name}</a>

      <div class="footer-top">
        <div class="footer-col">
          <h3 class="footer-col-title">Записаться</h3>
          <p class="footer-about">{typo(footer.about)}</p>
          <a class="btn btn--primary footer-cta" href="#calc">Оставить заявку</a>
        </div>

        <nav class="footer-col">
          <h3 class="footer-col-title">Мы в соцсетях</h3>
          <ul class="footer-links footer-links--lg">
            {footer.socials.map((s) => (
              <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>
            ))}
          </ul>
        </nav>

        <div class="footer-col footer-contacts">
          <a class="footer-phone" href={`tel:${contacts.phoneHref}`}>{contacts.phone}</a>
          <p class="footer-muted">{contacts.hours}</p>
          <p class="footer-muted">{contacts.address}</p>
          <a class="footer-link-muted" href={`mailto:${contacts.email}`}>{contacts.email}</a>
        </div>
      </div>
    </div>
  </div>

  <div class="footer-sub">
    <div class="container">
      <div class="footer-cols">
        <nav class="footer-col">
          <h3 class="footer-col-title footer-col-title--sm">{services.menuTitle}</h3>
          <ul class="footer-links">
            {categories.map((c) => (
              <li><a href={`#cat-${c.id}`}>{c.title}</a></li>
            ))}
          </ul>
        </nav>

        <nav class="footer-col">
          <h3 class="footer-col-title footer-col-title--sm">{footer.company.title}</h3>
          <ul class="footer-links">
            {footer.company.links.map((l) => (
              <li><a href={url(l.href)}>{l.label}</a></li>
            ))}
          </ul>
        </nav>

        <nav class="footer-col">
          <h3 class="footer-col-title footer-col-title--sm">Документы</h3>
          <ul class="footer-links">
            {footer.legal.map((l) => (
              <li><a href={url(l.href)}>{l.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>

      <div class="footer-bottom">
        <span>© {year} {brand.name}</span>
        <p class="footer-disclaimer">{typo(footer.disclaimer)}</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer { color: var(--color-white); }
  .footer ::selection { background: var(--color-white); color: var(--color-ink); }

  /* Верхний ярус — тот же тон, что основа сайта, скруглённый низ ложится на нижний ярус */
  .footer-main {
    position: relative;
    z-index: 1;
    background: var(--color-ink);
    border-radius: 0 0 var(--r-sheet) var(--r-sheet);
    padding-block: var(--sp-64) var(--sp-80);
  }
  .logo {
    display: inline-block;
    font-size: clamp(1.5rem, 2.4vw, 2rem);
  }
  .footer-top {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-40) var(--sp-48);
    margin-top: var(--sp-64);
  }

  /* Заголовок колонки — служебный интерфейс, жирность здесь разрешена.
     Капса нет: отличаем кеглем и весом, а не прописными */
  .footer-col-title {
    font-size: var(--text-body);
    font-weight: var(--w-semibold);
    letter-spacing: 0;
    line-height: 1.5;
    margin-bottom: var(--sp-16);
  }
  .footer-about { max-width: 40ch; }
  .footer-cta { margin-top: var(--sp-24); }

  /* Ссылки приглушены и без линий; наведение — белый текст и подсветка-плашка, как в шапке.
     Отрицательные поля: плашка шире текста, колонка остаётся на своём месте */
  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-4);
  }
  .footer-links--lg { font-size: var(--text-body-lg); gap: var(--sp-8); }
  .footer-links a,
  .footer-link-muted {
    display: inline-block;
    padding: 2px var(--sp-8);
    margin-inline: calc(var(--sp-8) * -1);
    border-radius: var(--r-row);
    color: var(--color-text-muted);
    transition: background-color var(--t-hover-out) var(--ease-out), color var(--t-hover-out) var(--ease-out);
  }
  .footer-links a:hover,
  .footer-links a:focus-visible,
  .footer-link-muted:hover,
  .footer-link-muted:focus-visible {
    color: var(--color-white);
    background: var(--color-row-hover-dark);
    transition-duration: var(--t-hover-in);
  }

  .footer-contacts { display: grid; justify-items: start; gap: var(--sp-8); align-content: start; }
  .footer-phone {
    font-size: var(--text-subhead);
    white-space: nowrap;
    margin-bottom: var(--sp-8);
  }
  .footer-muted { color: var(--color-text-muted); font-size: var(--text-body-lg); }
  .footer-link-muted { font-size: var(--text-body-lg); }

  /* Нижний ярус — заезжает под скругление верхнего, чтобы в углах был его цвет */
  .footer-sub {
    background: var(--color-coal);
    margin-top: calc(var(--r-sheet) * -1);
    padding: calc(var(--r-sheet) + var(--sp-48)) 0 var(--sp-48);
    font-size: var(--text-caption);
  }
  .footer-cols {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--sp-40) var(--sp-48);
  }
  .footer-col-title--sm { font-size: var(--text-caption); margin-bottom: var(--sp-8); }

  .footer-bottom {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    gap: var(--sp-12) var(--sp-48);
    margin-top: var(--sp-64);
    color: var(--color-text-muted);
  }
  .footer-disclaimer { max-width: var(--measure-text); }

  @media (max-width: 1000px) {
    .footer-top { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .footer-top > :first-child { grid-column: 1 / -1; }
    .footer-cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    .footer-main { padding-block: var(--sp-48) var(--sp-64); }
    .footer-top { grid-template-columns: minmax(0, 1fr); margin-top: var(--sp-40); }
    .footer-cols { grid-template-columns: minmax(0, 1fr); }
    .footer-bottom { grid-template-columns: minmax(0, 1fr); margin-top: var(--sp-40); }
  }
</style>
