---
/* Карточки страниц услуг: сетка направления и «смежные услуги». Серая плашка, название,
   одна строка «что это», цена «от» — её lib/page-car.js переписывает под класс машины
   (data-cells). Вся карточка — ссылка. 20.10.2026 («должны вызывать желание кликнуть»):
   название крупнее, внизу цена весом и справа «Подробнее →» текстом: круглая чёрная стрелка
   была «крупная и непонятная, куда ведёт» (снята в тот же день). Стрелка сдвигается под
   пальцем и курсором */
import { pageCard } from '../lib/pages.js';
import { rub } from '../lib/catalog.js';
import { typo } from '../lib/typo.js';
import { url } from '../lib/paths.js';

const { slugs = [] } = Astro.props;
const cards = slugs.map(pageCard).filter(Boolean);
---

<ul class="scards">
  {cards.map((c) => (
    <li>
      <a class="scard" href={url(`/${c.slug}/`)}>
        <h3 class="scard-title">{typo(c.title)}</h3>
        {c.card && <p class="scard-text">{typo(c.card)}</p>}
        <div class="scard-foot">
          <p class="scard-price" data-cells={JSON.stringify(c.cells)}>{c.from != null ? `от ${rub(c.from)}` : 'по запросу'}</p>
          <span class="scard-more" aria-hidden="true">
            Подробнее
            <svg viewBox="0 0 20 20"><path d="M4 10h12m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </div>
      </a>
    </li>
  ))}
</ul>

<style>
  .scards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: var(--sp-16);
  }
  .scard {
    display: flex;
    flex-direction: column;
    gap: var(--sp-8);
    height: 100%;
    padding: var(--sp-24) var(--sp-24) var(--sp-20);   /* плотнее: карточка не тянется (20.10.2026) */
    border-radius: var(--r-panel);
    background: var(--color-tile);
    color: var(--color-ink);
    transition: background-color var(--t-hover-out) var(--ease-out);
  }
  .scard:hover { background: var(--color-tile-hover); transition-duration: var(--t-hover-in); }
  .scard-title { font-size: var(--text-tile); letter-spacing: var(--track-head); line-height: 1.15; }
  .scard-text { font-size: var(--text-body); line-height: 1.5; }
  .scard-foot {
    margin-top: auto;
    padding-top: var(--sp-12);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-16);
  }
  .scard-price {
    font-size: var(--text-lead);
    font-weight: var(--w-semibold);
    font-variant-numeric: tabular-nums;
  }
  .scard-more {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-body);
    font-weight: var(--w-medium);
  }
  .scard-more svg { width: 18px; height: 18px; transition: transform 0.25s var(--ease-porsche); }
  .scard:hover .scard-more svg,
  .scard:active .scard-more svg { transform: translateX(4px); }
</style>
